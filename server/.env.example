NODE_ENV=production
# app: private business service; callbacks: public notifications and health only.
SERVICE_MODE=app
# Local integration only: use npm run local:start. It creates a separate loopback
# database and sets PAYMENT_MODE=mock; production must keep wechat.
PAYMENT_MODE=wechat
PORT=8080
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=pandou_app
MYSQL_PASSWORD=
MYSQL_DATABASE=pandou_db
# Only trusted cloud gateway traffic may access customer/admin routes.
# Public ingress must allow only /api/payment/notify and /api/refund/notify.
ADMIN_OPENIDS=
ALLOW_DEV_AUTH=false
# Enable only after authorizing /wxa/getwxacodeunlimit in Cloud Run Open API
# and rebuilding with the Open API sidecar enabled. No AppSecret is needed.
WECHAT_OPENAPI_ENABLED=false
# Product photos: authorize /_/cos/getauth and /_/cos/metaid/encode in the sidecar.
# Client storage permissions: read=true, write=false. No permanent COS secrets.
PRODUCT_IMAGE_UPLOAD_ENABLED=false
PRODUCT_IMAGE_ENV_ID=
PRODUCT_IMAGE_BUCKET=
PRODUCT_IMAGE_REGION=ap-shanghai
# WeChat Pay API v3 (ordinary merchant). Never commit keys or private .env files.
WECHAT_APP_ID=wx8e2380dec308d5de
WECHATPAY_MCH_ID=
WECHATPAY_CERT_SERIAL=
WECHATPAY_PRIVATE_KEY_PATH=/run/secrets/apiclient_key.pem
WECHATPAY_API_V3_KEY=
WECHATPAY_PUBLIC_KEY_ID=
WECHATPAY_PUBLIC_KEY_PATH=/run/secrets/wechatpay_public_key.pem
WECHATPAY_NOTIFY_URL=https://YOUR_CALLBACK_DOMAIN/api/payment/notify
WECHATPAY_REFUND_NOTIFY_URL=https://YOUR_CALLBACK_DOMAIN/api/refund/notify
# Optional prior verification key during rotation:
# WECHATPAY_PREVIOUS_KEY_ID=
# WECHATPAY_PREVIOUS_KEY_PATH=
