<!-- miniprogram/pages/address/address.wxml -->
<view class="addr-page">
  <dev-banner />

  <!-- ==================== 视图 A: 收货地址列表（主流卡片化排版） ==================== -->
  <block wx:if="{{!isEditing}}">
    <view class="mode-tip-banner" wx:if="{{mode === 'select'}}">
      <text>👇 点击下方地址直接选中并用于本单配送</text>
    </view>

    <view class="empty-address-box" wx:if="{{!addressList.length}}">
      <text class="empty-pin">📍</text>
      <text class="empty-title">还没有添加收货地址</text>
      <text class="empty-desc">支持微信一键导入或地图定位选址，下单免重填</text>
    </view>

    <view class="address-cards-list" wx:else>
      <view
        class="std-addr-card {{(mode === 'select' && item.id === activeId) || (mode !== 'select' && item.is_default) ? 'is-active' : ''}}"
        wx:for="{{addressList}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onCardTap"
      >
        <view class="card-left-body">
          <!-- 第 1 行：地址为主视觉 -->
          <view class="card-addr-row">
            <text class="tag-default" wx:if="{{item.is_default}}">默认</text>
            <text class="tag-current" wx:if="{{mode === 'select' && item.id === activeId}}">当前选用</text>
            <text class="addr-main-txt" wx:if="{{item.detail}}">{{item.displayDetail || item.detail}}</text>
            <text class="addr-missing-txt" wx:else>未填写具体门牌，请点右侧 ✏️ 补充</text>
          </view>
          <!-- 第 2 行：收货人与手机号 -->
          <view class="card-user-row">
            <text class="user-name">{{item.name}}</text>
            <text class="user-phone">{{item.phone || '未留手机号'}}</text>
          </view>
        </view>
        <!-- 右侧极简编辑图标 -->
        <view class="card-edit-btn" catchtap="openEditForm" data-id="{{item.id}}">
          <text class="edit-icon">✎</text>
        </view>
      </view>
    </view>

    <!-- 底部吸底双栏操作热区 -->
    <view class="bottom-fixed-dock">
      <button class="dock-btn dock-wx btn-press" bindtap="importFromWechat">
        <text class="dock-ico">📥</text>
        <text>微信一键导入</text>
      </button>
      <button class="dock-btn dock-add btn-press" bindtap="openCreateForm">
        <text class="dock-ico">＋</text>
        <text>新增收货地址</text>
      </button>
    </view>
  </block>

  <!-- ==================== 视图 B: 新增 / 编辑地址表单 ==================== -->
  <block wx:else>
    <view class="form-top-bar">
      <text class="form-top-title">{{form.id ? '编辑收货地址' : '新增收货地址'}}</text>
      <text class="form-top-back" bindtap="cancelForm">返回列表</text>
    </view>

    <view class="std-form-card">
      <!-- 所在小区 / 地区 + 地图定位 -->
      <view class="form-field-row">
        <text class="field-label">所在小区</text>
        <view class="field-control-wrap">
          <input
            class="field-input"
            placeholder="小区名称或所在街道"
            value="{{form.area}}"
            data-field="area"
            bindinput="onFormInput"
            maxlength="60"
          />
          <view class="btn-locate-inline btn-press" bindtap="locateOnMap">
            <text>📍 定位</text>
          </view>
        </view>
      </view>

      <!-- 作坊可自送小区白名单快捷点选 -->
      <view class="whitelist-areas-box" wx:if="{{deliveryAreas.length > 0}}">
        <text class="wl-label">可自送小区（点选直填）：</text>
        <view class="wl-chips">
          <text
            class="wl-chip {{form.area === areaItem ? 'selected' : ''}}"
            wx:for="{{deliveryAreas}}"
            wx:for-item="areaItem"
            wx:key="*this"
            data-area="{{areaItem}}"
            bindtap="pickWhitelistArea"
          >{{areaItem}}</text>
        </view>
      </view>

      <!-- 详细地址 / 门牌号 -->
      <view class="form-field-row">
        <text class="field-label">详细地址</text>
        <view class="field-control-wrap">
          <input
            class="field-input"
            placeholder="楼幢、单元、门牌号（如：5幢202室）"
            value="{{form.detail}}"
            data-field="detail"
            bindinput="onFormInput"
            maxlength="120"
          />
          <text wx:if="{{form.detail}}" class="field-clear" data-field="detail" bindtap="clearField">✕</text>
        </view>
      </view>

      <!-- 收货人 -->
      <view class="form-field-row">
        <text class="field-label">收货人</text>
        <view class="field-control-wrap">
          <input
            class="field-input"
            placeholder="请填写收货人姓名"
            value="{{form.name}}"
            data-field="name"
            bindinput="onFormInput"
            maxlength="20"
          />
          <text wx:if="{{form.name}}" class="field-clear" data-field="name" bindtap="clearField">✕</text>
        </view>
      </view>

      <!-- 手机号 -->
      <view class="form-field-row no-border">
        <text class="field-label">手机号</text>
        <view class="field-control-wrap">
          <input
            class="field-input"
            type="number"
            maxlength="11"
            placeholder="请填写11位手机号码"
            value="{{form.phone}}"
            data-field="phone"
            bindinput="onFormInput"
          />
          <text wx:if="{{form.phone}}" class="field-clear" data-field="phone" bindtap="clearField">✕</text>
        </view>
      </view>
    </view>

    <!-- 设为默认开关卡片 -->
    <view class="std-form-card switch-card">
      <view class="switch-text-col">
        <text class="switch-title">设为默认收货地址</text>
        <text class="switch-sub">每次下单将自动优先填入该地址</text>
      </view>
      <switch checked="{{form.is_default}}" color="#AA4624" bindchange="onDefaultSwitch" />
    </view>

    <!-- 表单操作按钮 -->
    <view class="form-submit-area">
      <button class="btn-form-save btn-press" bindtap="saveForm">保存并使用</button>
      <button wx:if="{{form.id}}" class="btn-form-delete btn-press" bindtap="deleteCurrent">删除该地址</button>
    </view>
  </block>
</view>
