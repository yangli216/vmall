/* miniprogram/pages/admin/admin.wxss */
.container {
  padding: 24rpx;
  background-color: #F8F9FA;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
}

/* 1. 顶部工坊卡片 */
.admin-header-card {
  background: linear-gradient(135deg, #2D3748 0%, #1A202C 100%);
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  color: #FFFFFF;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.shop-badge {
  display: inline-block;
  background: rgba(255, 255, 255, 0.15);
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  margin-bottom: 12rpx;
  color: #FBD38D;
}

.admin-shop-name {
  font-size: 36rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
}

.admin-address-txt {
  font-size: 22rpx;
  color: #A0AEC0;
}

/* 2. 通用卡片 */
.section-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #E5E7EB;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.section-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.header-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.section-h2 {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2937;
}

.section-sub {
  font-size: 22rpx;
  color: #9CA3AF;
}

.products-section .btn-add-dish {
  font-size: 24rpx;
  background: #FFF1E6;
  color: #D9480F;
  border: 1rpx solid rgba(217, 72, 15, 0.3);
  border-radius: 20rpx;
  padding: 8rpx 20rpx;
  margin: 0;
  font-weight: 600;
}

/* 菜品卡片：图片与名称同排，库存和操作各自成行。 */
.products-section { padding: 28rpx 0 0; background: transparent; border: 0; box-shadow: none; }
.products-section .section-header-row { padding: 0 2rpx; gap: 16rpx; }
.header-left { min-width: 0; flex: 1; }
.dish-total { font-size: 23rpx; font-weight: 500; color: #8D8278; margin-left: 10rpx; }
.dish-manage-list { display: flex; flex-direction: column; gap: 24rpx; }
.manage-dish-item { padding: 24rpx; background: #fff; border: 1rpx solid #EAE5DF; border-radius: 24rpx; }
.manage-dish-main { display: flex; align-items: flex-start; gap: 22rpx; }
.manage-dish-img { width: 148rpx; height: 148rpx; flex-shrink: 0; border-radius: 18rpx; background: #F5F0E8; }
.dish-image-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; color: #AD8C6A; font-family: serif; font-size: 46rpx; }
.dish-image-caption { font-family: sans-serif; font-size: 20rpx; margin-top: 6rpx; color: #A19486; }
.manage-dish-info { flex: 1; min-width: 0; }
.manage-dish-title-row { margin-bottom: 10rpx; }
.manage-dish-name { font-size: 29rpx; font-weight: 600; line-height: 1.5; color: #2E2925; word-break: break-all; }
.manage-dish-tag { display: inline-block; font-size: 20rpx; line-height: 1.5; background: #F7F3ED; color: #8A7158; padding: 3rpx 10rpx; border-radius: 6rpx; }
.manage-dish-price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8rpx 18rpx; margin-top: 14rpx; color: #413A34; font-size: 28rpx; font-weight: 600; }
.member-price { color: #B74B25; font-size: 23rpx; font-weight: 500; }
.manage-dish-action { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 20rpx 0; margin-top: 22rpx; border-top: 1rpx solid #F0ECE7; }
.dish-stock { display: flex; align-items: baseline; gap: 8rpx; min-height: 64rpx; flex-wrap: wrap; }
.dish-stock-label { font-size: 23rpx; color: #867C72; }
.dish-stock-value { font-size: 32rpx; font-weight: 650; color: #302B26; }
.dish-stock-edit { font-size: 22rpx; color: #AC562F; margin-left: 6rpx; }
.switch-pack { display: flex; align-items: center; gap: 8rpx; flex-shrink: 0; }
.switch-pack switch { transform: scale(.78); transform-origin: right center; margin-left: -10rpx; }
.status-label { font-size: 23rpx; white-space: nowrap; }
.status-label.online { color: #278464; }
.status-label.soldout { color: #8C837A; }
.dish-btn-group { display: flex; justify-content: flex-end; gap: 16rpx; }
.dish-btn-group .btn-dish-text { margin: 0; font-size: 24rpx; font-weight: 500; line-height: 64rpx; padding: 0 28rpx; border-radius: 12rpx; }
.dish-btn-group .btn-dish-text.edit { color: #A43F1C; background: #FAEEE5; width: 220rpx; }
.dish-btn-group .btn-dish-text.delete { color: #93877D; background: transparent; width: auto; margin-right: auto; padding-left: 0; }

/* 配置项 */
.config-block {
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
}

.config-block.border-top {
  border-top: 1rpx dashed #E5E7EB;
  padding-top: 24rpx;
}

.config-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  margin-bottom: 12rpx;
}

.config-title {
  color: #374151;
  font-weight: 600;
}

.config-val {
  font-weight: 700;
  color: #111827;
}

.config-val.red {
  color: #D9480F;
}

.config-desc {
  font-size: 20rpx;
  color: #9CA3AF;
  line-height: 1.45;
  display: block;
  margin-top: 6rpx;
}

.segment-picker {
  display: flex;
  background: #F3F4F6;
  padding: 4rpx;
  border-radius: 12rpx;
}

.seg-item {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 8rpx;
  color: #6B7280;
}

.seg-item.active {
  background: #FFFFFF;
  color: #111827;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.btn-save-config {
  background: linear-gradient(135deg, #D9480F, #B45309);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  padding: 20rpx 0;
  margin-top: 20rpx;
}

.btn-dispatch {
  font-size: 24rpx;
  background: linear-gradient(135deg, #059669, #047857);
  color: #FFFFFF;
  border-radius: 20rpx;
  padding: 10rpx 24rpx;
  margin: 0;
  font-weight: 600;
}

/* 待出炉订单列表 */
.empty-pending-box {
  text-align: center;
  padding: 30rpx 0;
}

.empty-hint {
  font-size: 22rpx;
  color: #9CA3AF;
}

.pending-orders-feed {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 10rpx;
}

.pending-order-item {
  background: #F9FAFB;
  border-radius: 16rpx;
  padding: 20rpx;
  border: 1rpx solid #E5E7EB;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.pending-meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 20rpx;
}

.pending-sn {
  color: #6B7280;
}

.pending-badge {
  background: #FFF1E6;
  color: #D9480F;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.pending-receiver-info {
  display: flex;
  flex-direction: column;
  font-size: 22rpx;
  gap: 4rpx;
}

.pending-receiver-info .bold-text {
  font-weight: 700;
  color: #1F2937;
}

.pending-receiver-info .sub-text {
  color: #4B5563;
}

.pending-dish-text {
  font-size: 22rpx;
  color: #B45309;
  background: #FFFBEB;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
}

.pending-action-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
  padding-top: 8rpx;
  border-top: 1rpx dashed #E5E7EB;
}

.pending-pay-amount {
  font-size: 24rpx;
  font-weight: 700;
  color: #111827;
}

.btn-single-dispatch {
  font-size: 22rpx;
  background: #059669;
  color: #FFFFFF;
  border-radius: 14rpx;
  padding: 6rpx 20rpx;
  margin: 0;
  line-height: 1.5;
}

/* 模态框 */
.modal-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-box {
  width: 85%;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  box-sizing: border-box;
}

.modal-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2937;
}

.modal-close {
  font-size: 32rpx;
  color: #9CA3AF;
  padding: 8rpx;
}

.modal-form {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.form-row {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.form-label {
  font-size: 22rpx;
  color: #4B5563;
  font-weight: 600;
}

.form-input {
  background: #F9FAFB;
  border: 1rpx solid #E5E7EB;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  font-size: 26rpx;
}

.modal-btn-row {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.btn-cancel {
  flex: 1;
  background: #F3F4F6;
  color: #4B5563;
  font-size: 26rpx;
  border-radius: 20rpx;
}

.btn-submit {
  flex: 1.5;
  background: linear-gradient(135deg, #D9480F, #B45309);
  color: #FFFFFF;
  font-size: 26rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

/* ================= 掌柜会员管理专属样式 ================= */
.member-stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.m-stat-box {
  background: #F9FAFB;
  border: 1rpx solid #E5E7EB;
  border-radius: 16rpx;
  padding: 16rpx 8rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.m-stat-num {
  font-size: 26rpx;
  font-weight: 800;
  color: #1F2937;
}

.m-stat-num.highlight {
  color: #D97706;
}

.m-stat-num.red {
  color: #D9480F;
}

.m-stat-lbl {
  font-size: 18rpx;
  color: #6B7280;
}

.member-search-bar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
  align-items: center;
}

.member-search-input {
  flex: 1;
  background: #F9FAFB;
  border: 1rpx solid #E5E7EB;
  border-radius: 16rpx;
  padding: 12rpx 18rpx;
  font-size: 24rpx;
}

.btn-search-member {
  background: #D9480F;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  padding: 12rpx 24rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  line-height: normal;
}

.btn-clear-member {
  background: #E5E7EB;
  color: #4B5563;
  font-size: 22rpx;
  padding: 12rpx 18rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  line-height: normal;
}

.member-cards-feed {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.admin-member-card {
  background: #FAFAFA;
  border: 1rpx solid #E5E7EB;
  border-radius: 20rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.m-card-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.m-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 2rpx solid #FDE68A;
  background: #E5E7EB;
  flex-shrink: 0;
}

.m-profile-info {
  flex: 1;
  min-width: 0;
}

.m-name-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.m-nickname {
  font-size: 28rpx;
  font-weight: 800;
  color: #1F2937;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.m-status-pill {
  font-size: 19rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  white-space: nowrap;
}

.m-status-pill.vip {
  background: #FEF3C7;
  color: #92400E;
  border: 1rpx solid #FDE68A;
}

.m-status-pill.normal {
  background: #E5E7EB;
  color: #4B5563;
}

.m-sub-line {
  display: flex;
  gap: 14rpx;
  font-size: 21rpx;
  color: #6B7280;
  margin-top: 4rpx;
}

.m-metrics-strip {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  background: #FFFFFF;
  border-radius: 14rpx;
  padding: 12rpx 8rpx;
  border: 1rpx solid #F3F4F6;
  text-align: center;
}

.m-metric-item {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.metric-val {
  font-size: 22rpx;
  font-weight: 800;
  color: #1F2937;
}

.metric-val.red {
  color: #D9480F;
}

.metric-label {
  font-size: 18rpx;
  color: #9CA3AF;
}

.m-referrer-bar {
  font-size: 21rpx;
  color: #6B7280;
  display: flex;
  gap: 6rpx;
}

.ref-label {
  color: #9CA3AF;
}

.ref-val {
  color: #B45309;
  font-weight: 600;
}

.ref-empty {
  color: #9CA3AF;
}

.m-actions-row {
  display: flex;
  gap: 10rpx;
  justify-content: flex-end;
  padding-top: 8rpx;
  border-top: 1rpx dashed #E5E7EB;
}

.m-action-btn {
  font-size: 21rpx;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  font-weight: 700;
  margin: 0;
  line-height: normal;
}

.btn-grant {
  background: #FFF7ED;
  color: #C2410C;
  border: 1rpx solid #FDBA74;
}

.btn-revoke {
  background: #FEF2F2;
  color: #DC2626;
  border: 1rpx solid #FECACA;
}

.btn-points {
  background: #F0FDF4;
  color: #15803D;
  border: 1rpx solid #BBF7D0;
}

.btn-bind-ref {
  background: #F3F4F6;
  color: #374151;
  border: 1rpx solid #D1D5DB;
}

.seg-type-row {
  display: flex;
  gap: 10rpx;
}

.seg-item {
  flex: 1;
  padding: 12rpx 8rpx;
  font-size: 21rpx;
  border-radius: 12rpx;
  background: #F3F4F6;
  color: #4B5563;
  text-align: center;
  border: 1rpx solid #E5E7EB;
}

.seg-item.active {
  background: #FFF0EB;
  color: #D9480F;
  border-color: #D9480F;
  font-weight: 700;
}

.admin-tabs { position: sticky; top:0; z-index:10; display:flex; justify-content:space-around; background:#fff; padding:24rpx 0; border-radius:18rpx; font-size:26rpx; margin-bottom:20rpx; }
.admin-filter { display:flex; align-items:center; gap:18rpx; padding:18rpx 0; font-size:26rpx; }
.prep-summary { padding:20rpx; background:#FFF7ED; border-radius:16rpx; line-height:1.8; font-size:26rpx; }
.modal-box { max-height:88vh; overflow-y:auto; }
.pending-action-row { flex-wrap:wrap; gap:12rpx; }
.config-block input,.config-block textarea { border-bottom:1rpx solid #E5E7EB; padding:14rpx; font-size:26rpx; box-sizing:border-box; width:100%; }
.support-filters {display:flex;gap:24rpx;margin:24rpx 0;}
.support-filters button {margin:0;padding:0 18rpx;border-radius:12rpx;background:#F5F3EF;}
.support-filters .selected {background:#D9480F;color:#FFF;}
.support-note {font-size:24rpx;color:#85766B;line-height:1.7;margin:16rpx 0;word-break:break-all;}
.support-ticket {padding:24rpx 0;border-top:1rpx solid #EEE;}
.support-description {white-space:pre-wrap;word-break:break-all;font-size:28rpx;line-height:1.7;}
.support-actions {display:flex;gap:16rpx;justify-content:flex-end;}
.activity-queues { display:flex; flex-wrap:wrap; gap:16rpx; margin-top:16rpx; }
.activity-queues button { margin:0; white-space:normal; }

.photo-editor { align-items: flex-start; gap: 14rpx; }
.dish-photo-preview { width: 180rpx; height: 180rpx; border-radius: 12rpx; }
.photo-hint { font-size: 24rpx; color: #666; }
.photo-error { font-size: 24rpx; color: #b42318; }
.config-error { color:#b42318; }
.config-mode-row { flex-direction:column; align-items:stretch; gap:16rpx; }

/* 掌柜移动工作台 */
page { background: #F6F4F0; }
.container { background: #F6F4F0; padding: 28rpx; }
.btn-dish-text::after,.btn-add-dish::after { border: none; }
.admin-header-card { background: #383C34; padding: 30rpx; border-radius: 24rpx; margin-bottom: 18rpx; box-shadow: none; }
.shop-badge { background: transparent; padding: 0; color: #DCC5A0; font-size: 23rpx; margin-bottom: 14rpx; }
.admin-shop-name { font-size: 34rpx; font-weight: 600; line-height: 1.4; }
.admin-address-txt { color: #C1C4B9; font-size: 23rpx; margin-top: 10rpx; }
.report-entry { display: flex; align-items: center; gap: 16rpx; width: 100%; margin: 0 0 24rpx; padding: 24rpx; border-radius: 18rpx; background: #EEEAE3; color: #514A40; font-size: 26rpx; line-height: 1.4; text-align: left; }
.report-entry-sub { flex: 1; font-size: 22rpx; color: #8A8073; }
.admin-tabs { gap: 2rpx; padding: 8rpx; border-radius: 18rpx; border: 1rpx solid #EAE5DF; margin-bottom: 22rpx; background: #FFFEFC; }
.admin-tab { flex: 1; padding: 18rpx 0; text-align: center; font-size: 24rpx; color: #71695F; white-space: nowrap; border-radius: 12rpx; }
.admin-tab.selected { color: #A43F1C; background: #FAEDE2; font-weight: 600; }
.admin-filter { padding: 6rpx 0 4rpx; font-size: 25rpx; color: #75695D; }
.admin-filter picker { padding: 18rpx 24rpx; width: 100%; background: #EEEAE3; border-radius: 14rpx; }
.section-card { border-color: #EAE5DF; box-shadow: none; padding: 28rpx 24rpx; }
.products-section { padding: 24rpx 0 0; border: 0; background: transparent; }
.section-h2 { font-size: 30rpx; font-weight: 600; color: #332C25; line-height: 1.5; }
.section-sub { color: #8A7D70; font-size: 22rpx; line-height: 1.6; }
.products-section .btn-add-dish { flex: none; width: auto; padding: 0 24rpx; font-size: 25rpx; line-height: 72rpx; border-radius: 14rpx; background: #AF4725; color: #fff; border: 0; white-space: nowrap; }
.support-note { color: #857A6F; font-size: 24rpx; line-height: 1.7; }
.activity-queues { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 12rpx; }
.activity-queues button { width: 100%; margin: 0; padding: 20rpx 8rpx; background: #F6F4EF; color: #5F5144; font-size: 23rpx; line-height: 1.6; border-radius: 14rpx; }
.support-filters { gap: 10rpx; flex-wrap: wrap; }
.support-filters button { font-size: 24rpx; line-height: 64rpx; }
.member-stats-grid { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 16rpx; }
.m-stat-box { padding: 22rpx 10rpx; background: #F8F6F2; border: 0; gap: 10rpx; }
.m-stat-lbl,.metric-label { font-size: 22rpx; color: #8A7D70; }
.m-stat-num { font-size: 32rpx; }
.member-search-input { min-width: 0; }
.m-name-line,.m-sub-line,.m-actions-row { flex-wrap: wrap; }
.m-status-pill { font-size: 20rpx; }
.m-metrics-strip { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 20rpx 12rpx; }
.metric-val { font-size: 27rpx; word-break: break-all; }
.m-action-btn { font-size: 23rpx; line-height: 1.6; padding: 14rpx 18rpx; }
.config-block { padding: 22rpx 0; margin-bottom: 0; border-bottom: 1rpx solid #EEE9E2; }
.config-label-row { gap: 16rpx; flex-wrap: wrap; line-height: 1.6; }
.config-block input,.config-block textarea { background: #F8F6F2; border: 1rpx solid #EAE5DF; border-radius: 12rpx; margin: 14rpx 0; padding: 20rpx; }
.config-desc { font-size: 23rpx; color: #8A7D70; line-height: 1.7; }
.modal-box { width: 92%; padding: 30rpx; border-radius: 24rpx; }
.form-input { height: 84rpx; box-sizing: border-box; }
.form-label { font-size: 25rpx; }

.config-block input { height: 88rpx; line-height: 1.6; }
.config-block textarea { min-height: 180rpx; line-height: 1.7; }
