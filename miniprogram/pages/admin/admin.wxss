/* miniprogram/pages/admin/admin.wxss */
.container {
  padding: 24rpx;
  background-color: #F8F9FA;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 80rpx;
}

/* 1. 顶部工坊卡片 */
.admin-header-card {
  background: linear-gradient(135deg, #2D3748 0%, #1A202C 100%);
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  color: #FFFFFF;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.shop-badge {
  display: inline-block;
  background: rgba(255, 255, 255, 0.15);
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  margin-bottom: 12rpx;
  color: #FBD38D;
}

.admin-shop-name {
  font-size: 36rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
}

.admin-address-txt {
  font-size: 22rpx;
  color: #A0AEC0;
}

/* 2. 通用卡片 */
.section-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #E5E7EB;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.section-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.header-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.section-h2 {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2937;
}

.section-sub {
  font-size: 22rpx;
  color: #9CA3AF;
}

.btn-add-dish {
  font-size: 24rpx;
  background: #FFF1E6;
  color: #D9480F;
  border: 1rpx solid rgba(217, 72, 15, 0.3);
  border-radius: 20rpx;
  padding: 8rpx 20rpx;
  margin: 0;
  font-weight: 600;
}

/* 菜品列表 */
.dish-manage-list {
  display: flex;
  flex-direction: column;
}

.manage-dish-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
  gap: 20rpx;
}

.manage-dish-item:last-child {
  border-bottom: none;
}

.manage-dish-img {
  width: 90rpx;
  height: 90rpx;
  border-radius: 16rpx;
  background-color: #F3F4F6;
}

.manage-dish-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.manage-dish-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.manage-dish-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1F2937;
}

.manage-dish-tag {
  font-size: 18rpx;
  background: #F3F4F6;
  color: #4B5563;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}

.manage-dish-price {
  font-size: 22rpx;
  color: #6B7280;
}

.manage-dish-price .red {
  color: #D9480F;
  font-weight: 600;
}

.manage-dish-action {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.status-label {
  font-size: 22rpx;
  font-weight: 600;
}

.status-label.online {
  color: #059669;
}

.status-label.soldout {
  color: #EF4444;
}

/* 配置项 */
.config-block {
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
}

.config-block.border-top {
  border-top: 1rpx dashed #E5E7EB;
  padding-top: 24rpx;
}

.config-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  margin-bottom: 12rpx;
}

.config-title {
  color: #374151;
  font-weight: 600;
}

.config-val {
  font-weight: 700;
  color: #111827;
}

.config-val.red {
  color: #D9480F;
}

.config-desc {
  font-size: 20rpx;
  color: #9CA3AF;
  line-height: 1.45;
  display: block;
  margin-top: 6rpx;
}

.segment-picker {
  display: flex;
  background: #F3F4F6;
  padding: 4rpx;
  border-radius: 12rpx;
}

.seg-item {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 8rpx;
  color: #6B7280;
}

.seg-item.active {
  background: #FFFFFF;
  color: #111827;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.btn-save-config {
  background: linear-gradient(135deg, #D9480F, #B45309);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  padding: 20rpx 0;
  margin-top: 20rpx;
}

.btn-dispatch {
  font-size: 24rpx;
  background: linear-gradient(135deg, #059669, #047857);
  color: #FFFFFF;
  border-radius: 20rpx;
  padding: 10rpx 24rpx;
  margin: 0;
  font-weight: 600;
}

/* 待出炉订单列表 */
.empty-pending-box {
  text-align: center;
  padding: 30rpx 0;
}

.empty-hint {
  font-size: 22rpx;
  color: #9CA3AF;
}

.pending-orders-feed {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 10rpx;
}

.pending-order-item {
  background: #F9FAFB;
  border-radius: 16rpx;
  padding: 20rpx;
  border: 1rpx solid #E5E7EB;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.pending-meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 20rpx;
}

.pending-sn {
  color: #6B7280;
}

.pending-badge {
  background: #FFF1E6;
  color: #D9480F;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.pending-receiver-info {
  display: flex;
  flex-direction: column;
  font-size: 22rpx;
  gap: 4rpx;
}

.pending-receiver-info .bold-text {
  font-weight: 700;
  color: #1F2937;
}

.pending-receiver-info .sub-text {
  color: #4B5563;
}

.pending-dish-text {
  font-size: 22rpx;
  color: #B45309;
  background: #FFFBEB;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
}

.pending-action-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
  padding-top: 8rpx;
  border-top: 1rpx dashed #E5E7EB;
}

.pending-pay-amount {
  font-size: 24rpx;
  font-weight: 700;
  color: #111827;
}

.btn-single-dispatch {
  font-size: 22rpx;
  background: #059669;
  color: #FFFFFF;
  border-radius: 14rpx;
  padding: 6rpx 20rpx;
  margin: 0;
  line-height: 1.5;
}

/* 模态框 */
.modal-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-box {
  width: 85%;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  box-sizing: border-box;
}

.modal-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2937;
}

.modal-close {
  font-size: 32rpx;
  color: #9CA3AF;
  padding: 8rpx;
}

.modal-form {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.form-row {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.form-label {
  font-size: 22rpx;
  color: #4B5563;
  font-weight: 600;
}

.form-input {
  background: #F9FAFB;
  border: 1rpx solid #E5E7EB;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  font-size: 26rpx;
}

.modal-btn-row {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.btn-cancel {
  flex: 1;
  background: #F3F4F6;
  color: #4B5563;
  font-size: 26rpx;
  border-radius: 20rpx;
}

.btn-submit {
  flex: 1.5;
  background: linear-gradient(135deg, #D9480F, #B45309);
  color: #FFFFFF;
  font-size: 26rpx;
  border-radius: 20rpx;
  font-weight: 600;
}
