/* miniprogram/pages/admin/admin.wxss */
page {
  background: #F6F4F0;
}

.container {
  padding: 24rpx;
  background: #F6F4F0;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
}

.container.has-sticky-bar {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

button::after {
  border: none;
}

/* ==================== 1. 顶部工坊概览与入口 ==================== */
.admin-header-card {
  background: linear-gradient(135deg, #383C34 0%, #262A23 100%);
  border-radius: 24rpx;
  padding: 30rpx 28rpx;
  color: #FFFFFF;
  margin-bottom: 18rpx;
}

.shop-badge {
  display: inline-block;
  font-size: 22rpx;
  color: #DCC5A0;
  margin-bottom: 10rpx;
  font-weight: 600;
}

.admin-shop-name {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
}

.admin-address-txt {
  font-size: 22rpx;
  color: #C1C4B9;
  margin-top: 8rpx;
}

.report-entry {
  display: flex;
  align-items: center;
  gap: 14rpx;
  width: 100%;
  box-sizing: border-box;
  margin: 0 0 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  background: #EEEAE3;
  color: #3D352C;
}

.report-entry-title {
  font-size: 26rpx;
  font-weight: 700;
}

.report-entry-sub {
  flex: 1;
  font-size: 22rpx;
  color: #82776B;
}

.report-entry-arrow {
  font-size: 28rpx;
  color: #8A7F73;
}

.card-alert {
  background: #FEF2F2;
  border: 1rpx solid #FECACA;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
}

/* ==================== 2. 顶部主导航 Tabs（带角标） ==================== */
.admin-tabs {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: #FFFEFC;
  padding: 8rpx;
  border-radius: 18rpx;
  border: 1rpx solid #EAE5DF;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.03);
}

.admin-tab {
  position: relative;
  flex: 1;
  padding: 16rpx 4rpx;
  text-align: center;
  font-size: 24rpx;
  color: #71695F;
  white-space: nowrap;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.admin-tab.selected {
  color: #A43F1C;
  background: #FAEDE2;
  font-weight: 700;
}

.tab-badge {
  font-size: 18rpx;
  line-height: 1;
  padding: 4rpx 8rpx;
  border-radius: 20rpx;
  background: #D97706;
  color: #FFFFFF;
  font-weight: 700;
}

.tab-badge.danger {
  background: #DC2626;
}

.tab-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #D9480F;
}

/* ==================== 3. 统一按钮体系 ==================== */
.btn-wk-primary,
.btn-wk-secondary,
.btn-wk-warn,
.btn-wk-success,
.btn-wk-danger-outline {
  margin: 0 !important;
  font-size: 23rpx !important;
  font-weight: 600 !important;
  line-height: 1 !important;
  padding: 16rpx 22rpx !important;
  border-radius: 12rpx !important;
  white-space: nowrap;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: auto !important;
  min-width: 0;
}

.btn-wk-primary {
  background: #A43F1C !important;
  color: #FFFFFF !important;
}

.btn-wk-secondary {
  background: #F5F2EC !important;
  color: #5C5044 !important;
  border: 1rpx solid #E3DCD2 !important;
}

.btn-wk-warn {
  background: #FFF7ED !important;
  color: #C2410C !important;
  border: 1rpx solid #FDBA74 !important;
}

.btn-wk-success {
  background: #059669 !important;
  color: #FFFFFF !important;
}

.btn-wk-danger-outline {
  background: #FFF5F5 !important;
  color: #DC2626 !important;
  border: 1rpx solid #FECACA !important;
}

.btn-wk-loadmore {
  width: 100% !important;
  margin: 12rpx 0 24rpx !important;
  padding: 22rpx 0 !important;
  background: #FFFFFF !important;
  color: #5C5044 !important;
  font-size: 25rpx !important;
  font-weight: 600 !important;
  border-radius: 16rpx !important;
  border: 1rpx solid #EAE5DF !important;
}

/* ==================== 4. 一体化营业日栏与通用卡片 ==================== */
.unified-date-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.date-picker-trigger {
  flex: 1;
  background: #EEEAE3;
  border-radius: 14rpx;
}

.date-bar-inner {
  display: flex;
  align-items: center;
  padding: 18rpx 22rpx;
  gap: 10rpx;
  font-size: 25rpx;
  color: #4D433A;
  font-weight: 600;
}

.date-bar-text {
  flex: 1;
}

.date-bar-caret {
  color: #8A7D70;
}

.btn-back-date {
  background: #FAEDE2;
  color: #A43F1C;
  border: 1rpx solid #F1D3BD;
  padding: 18rpx 22rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
}

.section-card {
  background: #FFFFFF;
  border-radius: 22rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 22rpx;
  border: 1rpx solid #EAE5DF;
}

.section-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.header-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
  flex: 1;
}

.section-h2 {
  font-size: 30rpx;
  font-weight: 700;
  color: #332C25;
}

.section-sub {
  font-size: 22rpx;
  color: #8A7D70;
}

/* ==================== 5. 备餐：全局待办 & 订单调度 ==================== */
.activity-head-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.activity-poll-tip {
  font-size: 21rpx;
  color: #9A8D80;
}

.new-event-banner {
  background: #FFF7ED;
  border: 1rpx solid #FED7AA;
  color: #C2410C;
  font-size: 23rpx;
  font-weight: 600;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 14rpx;
}

.activity-queues {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.queue-tile {
  background: #F7F5F1;
  border: 1rpx solid #ECE6DE;
  border-radius: 14rpx;
  padding: 16rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.queue-tile .q-num {
  font-size: 30rpx;
  font-weight: 800;
  color: #5C5248;
}

.queue-tile .q-lbl {
  font-size: 21rpx;
  color: #85796D;
}

.queue-tile.urgent {
  background: #FFF7ED;
  border-color: #FDBA74;
}
.queue-tile.urgent .q-num { color: #C2410C; }

.queue-tile.warn {
  background: #FEFCE8;
  border-color: #FDE047;
}
.queue-tile.warn .q-num { color: #A16207; }

.queue-tile.info {
  background: #EFF6FF;
  border-color: #BFDBFE;
}
.queue-tile.info .q-num { color: #1D4ED8; }

.queue-tile.danger {
  background: #FEF2F2;
  border-color: #FECACA;
}
.queue-tile.danger .q-num { color: #DC2626; }

.overdue-alert-bar {
  margin-top: 14rpx;
  background: #FEF2F2;
  border: 1rpx solid #FCA5A5;
  color: #B91C1C;
  font-size: 23rpx;
  font-weight: 600;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  text-align: center;
}

.btn-dispatch {
  font-size: 23rpx !important;
  background: linear-gradient(135deg, #059669, #047857) !important;
  color: #FFFFFF !important;
  border-radius: 14rpx !important;
  padding: 14rpx 22rpx !important;
  margin: 0 !important;
  font-weight: 700 !important;
  line-height: 1.2 !important;
  width: auto !important;
}

.btn-dispatch.is-disabled {
  background: #E5E7EB !important;
  color: #9CA3AF !important;
}

.order-filter-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.filter-pill-picker {
  background: #F6F4F0;
  border: 1rpx solid #E8E2D9;
  border-radius: 12rpx;
}

.picker-pill-inner {
  padding: 16rpx 18rpx;
  font-size: 24rpx;
  color: #4A4037;
  text-align: center;
  font-weight: 600;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #F8F6F2;
  border: 1rpx solid #E5DFD5;
  border-radius: 14rpx;
  padding: 0 16rpx;
  height: 72rpx;
  box-sizing: border-box;
}

.search-input-field {
  flex: 1;
  font-size: 25rpx;
  color: #2E2925;
  min-width: 0;
}

.search-clear-x {
  font-size: 26rpx;
  color: #9CA3AF;
  padding: 8rpx;
}

.capacity-chip-note {
  font-size: 22rpx;
  color: #6E6256;
  background: #F8F6F2;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 14rpx;
}

.capacity-chip-note .bold {
  font-weight: 700;
  color: #A43F1C;
}

.prep-summary-card {
  background: #FFF9F3;
  border: 1rpx solid #F4E1CE;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 18rpx;
}

.prep-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.prep-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #7C411C;
}

.prep-total-badge {
  font-size: 22rpx;
  font-weight: 600;
  color: #B45309;
  margin-left: 8rpx;
}

.btn-copy-prep {
  font-size: 22rpx;
  font-weight: 600;
  color: #A43F1C;
  background: #FFFFFF;
  border: 1rpx solid #ECC8AE;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.prep-empty {
  font-size: 23rpx;
  color: #9C8B7A;
}

.prep-items-grid {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.prep-item-row {
  display: flex;
  justify-content: space-between;
  font-size: 25rpx;
  color: #42362B;
  padding: 4rpx 0;
  border-bottom: 1rpx dashed #F0E3D5;
}

.prep-item-row:last-child {
  border-bottom: none;
}

.prep-dish-qty {
  font-weight: 700;
  color: #A43F1C;
}

.pending-orders-feed {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.pending-order-item {
  background: #FAF8F5;
  border-radius: 18rpx;
  padding: 22rpx;
  border: 1rpx solid #EAE3DA;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.pending-meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 22rpx;
}

.pending-sn {
  color: #6B5E52;
  font-weight: 600;
}

.pending-badge {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.pending-badge.delivery {
  background: #FFF1E6;
  color: #C2410C;
}

.pending-badge.pickup {
  background: #ECFDF5;
  color: #059669;
}

.pending-receiver-info .bold-text {
  font-size: 25rpx;
  font-weight: 700;
  color: #231D18;
  line-height: 1.4;
}

.inline-copy-tag {
  display: inline-block;
  margin-left: 10rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #A43F1C;
  background: #FAEDE2;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.customer-call-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 23rpx;
  color: #5C5044;
  background: #FFFFFF;
  padding: 10rpx 14rpx;
  border-radius: 10rpx;
  border: 1rpx solid #EFEAE3;
}

.call-tag {
  color: #1D4ED8;
  font-weight: 600;
}

.pending-dish-text {
  font-size: 23rpx;
  color: #9A5B23;
  background: #FFFBEB;
  padding: 8rpx 12rpx;
  border-radius: 10rpx;
  line-height: 1.45;
}

.pending-remark-text {
  font-size: 23rpx;
  color: #DC2626;
  background: #FEF2F2;
  padding: 8rpx 12rpx;
  border-radius: 10rpx;
}

.pending-action-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  margin-top: 6rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed #E5DDD2;
}

.pending-pay-amount {
  font-size: 26rpx;
  font-weight: 700;
  color: #1F2937;
}

.order-btns-pack {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  justify-content: flex-end;
}

.pending-note-sub {
  font-size: 22rpx;
  color: #6B7280;
}

.pending-note-sub.danger {
  color: #DC2626;
}

.warn-box {
  background: #FEFCE8;
  border: 1rpx solid #FEF08A;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  color: #854D0E;
}

/* ==================== 6. 菜品管理 ==================== */
.products-section {
  padding: 20rpx 0 0;
  background: transparent;
  border: 0;
}

.products-header-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.btn-cat-manage {
  flex: none;
  width: auto !important;
  padding: 14rpx 18rpx !important;
  font-size: 23rpx !important;
  line-height: 1.2 !important;
  border-radius: 14rpx !important;
  background: #FFFFFF !important;
  color: #5C5044 !important;
  border: 1rpx solid #DED5C9 !important;
  font-weight: 600;
  margin: 0 !important;
}

.products-section .btn-add-dish {
  flex: none;
  width: auto !important;
  padding: 14rpx 24rpx !important;
  font-size: 24rpx !important;
  line-height: 1.2 !important;
  border-radius: 14rpx !important;
  background: #AF4725 !important;
  color: #FFFFFF !important;
  font-weight: 700;
  margin: 0 !important;
}

.dish-total {
  font-size: 22rpx;
  font-weight: 500;
  color: #8D8278;
  margin-left: 8rpx;
}

.product-filter-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.prod-cat-picker {
  flex-shrink: 0;
}

.prod-cat-pill {
  height: 58rpx;
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  border: 1rpx solid #E2DAD0;
  padding: 0 18rpx;
  border-radius: 12rpx;
  font-size: 23rpx;
  font-weight: 600;
  color: #42372E;
  white-space: nowrap;
}

.prod-status-scroll {
  flex: 1;
  min-width: 0;
  height: 58rpx;
  white-space: nowrap;
}

.prod-status-inner {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  height: 58rpx;
}

.prod-status-chip {
  height: 58rpx;
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 18rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #6E6256;
  background: #EFEBE5;
  flex-shrink: 0;
  white-space: nowrap;
}

.prod-status-chip.active {
  background: #A43F1C;
  color: #FFFFFF;
  font-weight: 600;
}

.dish-manage-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.manage-dish-item {
  padding: 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #EAE5DF;
  border-radius: 22rpx;
}

.manage-dish-main {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.manage-dish-img {
  width: 144rpx;
  height: 144rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  background: #F5F0E8;
}

.dish-image-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #AD8C6A;
  font-family: serif;
  font-size: 44rpx;
}

.dish-image-caption {
  font-family: sans-serif;
  font-size: 20rpx;
  margin-top: 4rpx;
  color: #A19486;
}

.manage-dish-info {
  flex: 1;
  min-width: 0;
}

.manage-dish-title-row {
  margin-bottom: 8rpx;
}

.manage-dish-name {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.45;
  color: #2E2925;
}

.manage-dish-tag {
  display: inline-block;
  font-size: 20rpx;
  background: #F7F3ED;
  color: #8A7158;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
}

.manage-dish-price {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 14rpx;
  margin-top: 12rpx;
  color: #413A34;
  font-size: 28rpx;
  font-weight: 700;
}

.member-price {
  color: #B74B25;
  font-size: 23rpx;
  font-weight: 600;
}

.manage-dish-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 0;
  margin-top: 18rpx;
  border-top: 1rpx solid #F0ECE7;
}

.dish-stock {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.dish-stock-label {
  font-size: 23rpx;
  color: #867C72;
}

.dish-stock-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #302B26;
}

.dish-stock-value.low {
  color: #DC2626;
}

.dish-stock-edit {
  font-size: 22rpx;
  color: #AC562F;
  font-weight: 600;
}

.switch-pack {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.switch-pack switch {
  transform: scale(.78);
  transform-origin: right center;
}

.status-label {
  font-size: 23rpx;
}

.status-label.online { color: #278464; font-weight: 600; }
.status-label.soldout { color: #8C837A; }

.dish-btn-group {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.dish-btn-group .btn-dish-text {
  margin: 0 !important;
  font-size: 24rpx !important;
  font-weight: 600;
  line-height: 62rpx !important;
  padding: 0 28rpx !important;
  border-radius: 12rpx !important;
  width: auto !important;
}

.dish-btn-group .btn-dish-text.edit {
  color: #A43F1C !important;
  background: #FAEEE5 !important;
  min-width: 180rpx;
}

.dish-btn-group .btn-dish-text.delete {
  color: #93877D !important;
  background: transparent !important;
  padding-left: 0 !important;
}

/* ==================== 7. 会员花名册（修复按钮堆叠与胶囊变形） ==================== */
.btn-logs-entry {
  font-size: 22rpx;
  font-weight: 600;
  color: #A43F1C;
  background: #FAEDE2;
  padding: 10rpx 18rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
}

.member-stats-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.m-stat-box {
  background: #F8F6F2;
  border-radius: 16rpx;
  padding: 20rpx 10rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.m-stat-num {
  font-size: 32rpx;
  font-weight: 800;
  color: #1F2937;
}

.m-stat-num.highlight { color: #D97706; }
.m-stat-num.red { color: #D9480F; }

.m-stat-lbl {
  font-size: 22rpx;
  color: #8A7D70;
}

.member-filter-pills {
  display: flex;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.m-filter-chip {
  flex: 1;
  text-align: center;
  font-size: 23rpx;
  padding: 12rpx 0;
  border-radius: 12rpx;
  background: #F5F2EC;
  color: #6B5E52;
  font-weight: 600;
}

.m-filter-chip.active {
  background: #A43F1C;
  color: #FFFFFF;
}

.member-search-bar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
  align-items: center;
}

.member-cards-feed {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.admin-member-card {
  background: #FAF8F5;
  border: 1rpx solid #EAE3DA;
  border-radius: 20rpx;
  padding: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.m-card-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.m-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  border: 2rpx solid #FDE68A;
  background: #E5E7EB;
  flex-shrink: 0;
}

.m-profile-info {
  flex: 1;
  min-width: 0;
}

.m-name-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.m-nickname {
  font-size: 28rpx;
  font-weight: 700;
  color: #1F2937;
}

.m-status-pill {
  display: inline-block;
  font-size: 20rpx;
  line-height: 1.3;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  white-space: nowrap;
}

.m-status-pill.vip {
  background: #FEF3C7;
  color: #92400E;
  border: 1rpx solid #FDE68A;
}

.m-status-pill.normal {
  background: #EAE6DF;
  color: #5C5349;
}

.m-sub-line {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  font-size: 22rpx;
  color: #786D61;
  margin-top: 6rpx;
}

.m-metrics-strip {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx 12rpx;
  background: #FFFFFF;
  border-radius: 14rpx;
  padding: 16rpx 12rpx;
  border: 1rpx solid #EFECE6;
  text-align: center;
}

.m-metric-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.metric-val {
  font-size: 27rpx;
  font-weight: 800;
  color: #1F2937;
}

.metric-val.red { color: #D9480F; }

.metric-label {
  font-size: 21rpx;
  color: #8A7D70;
}

.metric-debt {
  font-size: 19rpx;
  color: #DC2626;
}

.m-referrer-bar {
  font-size: 22rpx;
  color: #6B7280;
}

.ref-label { color: #9CA3AF; }
.ref-val { color: #B45309; font-weight: 600; }
.ref-empty { color: #9CA3AF; }

/* 核心修复：按钮单行横向紧凑排开 */
.m-actions-row {
  display: flex;
  flex-wrap: nowrap;
  gap: 8rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed #E5DDD2;
}

.m-action-btn {
  flex: 1 !important;
  width: auto !important;
  min-width: 0;
  font-size: 21rpx !important;
  padding: 14rpx 6rpx !important;
  border-radius: 12rpx !important;
  font-weight: 600 !important;
  margin: 0 !important;
  line-height: 1.2 !important;
  white-space: nowrap;
  text-align: center;
}

.btn-grant { background: #FFF7ED !important; color: #C2410C !important; border: 1rpx solid #FDBA74 !important; }
.btn-revoke { background: #FEF2F2 !important; color: #DC2626 !important; border: 1rpx solid #FECACA !important; }
.btn-points { background: #F0FDF4 !important; color: #15803D !important; border: 1rpx solid #BBF7D0 !important; }
.btn-bind-ref { background: #F3F4F6 !important; color: #374151 !important; border: 1rpx solid #D1D5DB !important; }

/* ==================== 8. 售后与信息申请卡片化 ==================== */
.support-filters {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
  margin: 18rpx 0;
}

.filter-chip {
  font-size: 23rpx;
  padding: 12rpx 22rpx;
  border-radius: 12rpx;
  background: #F5F2EC;
  color: #5C5248;
  font-weight: 600;
}

.filter-chip.selected {
  background: #A43F1C;
  color: #FFFFFF;
}

.support-note {
  font-size: 23rpx;
  color: #857A6F;
  line-height: 1.65;
  margin: 12rpx 0;
}

.ticket-cards-feed {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 12rpx;
}

.ticket-card-item {
  background: #FAF8F5;
  border: 1rpx solid #EAE3DA;
  border-radius: 18rpx;
  padding: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.ticket-head-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.ticket-category {
  font-size: 27rpx;
  font-weight: 700;
  color: #2E2925;
}

.ticket-status-tag {
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.ticket-status-tag.status-OPEN { background: #FFF7ED; color: #C2410C; }
.ticket-status-tag.status-PROCESSING { background: #EFF6FF; color: #1D4ED8; }
.ticket-status-tag.status-RESOLVED { background: #ECFDF5; color: #059669; }
.ticket-status-tag.status-CANCELLED { background: #F3F4F6; color: #6B7280; }

.ticket-meta {
  font-size: 22rpx;
  color: #8A7D70;
}

.support-description {
  white-space: pre-wrap;
  word-break: break-all;
  font-size: 26rpx;
  line-height: 1.6;
  color: #3B332C;
}

.ticket-resolution-box {
  background: #F0FDF4;
  border: 1rpx solid #BBF7D0;
  color: #166534;
  font-size: 24rpx;
  line-height: 1.5;
  padding: 12rpx 14rpx;
  border-radius: 10rpx;
}

.support-actions {
  display: flex;
  gap: 12rpx;
  justify-content: flex-end;
  padding-top: 10rpx;
  border-top: 1rpx dashed #E5DDD2;
}

/* ==================== 9. 运营设置分组重构（恢复行内对齐） ==================== */
.dirty-warn-bar {
  margin-top: 14rpx;
  background: #FFF7ED;
  border: 1rpx solid #FDBA74;
  color: #C2410C;
  font-size: 23rpx;
  font-weight: 600;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
}

.group-heading {
  font-size: 28rpx;
  font-weight: 700;
  color: #332C25;
  margin-bottom: 18rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #F0ECE6;
}

.config-block {
  padding: 18rpx 0;
  border-bottom: 1rpx dashed #EEE9E2;
}

.config-block:last-child {
  border-bottom: none;
}

.config-row-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx dashed #EEE9E2;
}

.config-row-between:last-child {
  border-bottom: none;
}

.config-title {
  font-size: 26rpx;
  color: #374151;
  font-weight: 600;
}

.config-input-inline {
  width: 240rpx;
  height: 70rpx;
  background: #F8F6F2;
  border: 1rpx solid #E5DFD5;
  border-radius: 12rpx;
  padding: 0 18rpx;
  font-size: 26rpx;
  text-align: right;
  box-sizing: border-box;
  flex-shrink: 0;
}

.config-picker-chip {
  background: #F8F6F2;
  border: 1rpx solid #E5DFD5;
  border-radius: 12rpx;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #A43F1C;
}

.config-input-box {
  width: 100%;
  height: 78rpx;
  background: #F8F6F2;
  border: 1rpx solid #E5DFD5;
  border-radius: 12rpx;
  padding: 0 18rpx;
  margin-top: 12rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.config-textarea-box {
  width: 100%;
  min-height: 140rpx;
  background: #F8F6F2;
  border: 1rpx solid #E5DFD5;
  border-radius: 12rpx;
  padding: 16rpx 18rpx;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

.config-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.config-mode-row {
  flex-direction: column;
  align-items: stretch;
  gap: 14rpx;
}

.config-val { font-weight: 700; color: #111827; font-size: 26rpx; }
.config-val.red { color: #D9480F; }
.config-action-pill {
  font-size: 22rpx;
  font-weight: 600;
  color: #AA4624;
  background: #FFF1E6;
  border: 1rpx solid #FDBA74;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}
.config-desc { font-size: 22rpx; color: #8A7D70; line-height: 1.55; display: block; margin-top: 8rpx; }

.segment-picker {
  display: flex;
  background: #F3F4F6;
  padding: 6rpx;
  border-radius: 12rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  padding: 10rpx 8rpx;
  border-radius: 8rpx;
  color: #6B7280;
}

.seg-item.active {
  background: #FFFFFF;
  color: #A43F1C;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.btn-save-config {
  width: 100% !important;
  background: linear-gradient(135deg, #D9480F, #B45309) !important;
  color: #FFFFFF !important;
  font-size: 28rpx !important;
  font-weight: 700 !important;
  border-radius: 40rpx !important;
  padding: 20rpx 0 !important;
  margin-top: 20rpx !important;
}

.sticky-save-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid #EAE3DA;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -6rpx 20rpx rgba(0, 0, 0, 0.06);
}

.sticky-save-hint {
  font-size: 24rpx;
  font-weight: 700;
  color: #C2410C;
}

.btn-sticky-save {
  margin: 0 !important;
  width: auto !important;
  background: #A43F1C !important;
  color: #FFFFFF !important;
  font-size: 25rpx !important;
  font-weight: 700 !important;
  padding: 16rpx 36rpx !important;
  border-radius: 36rpx !important;
  line-height: 1.2 !important;
}

/* ==================== 10. 弹窗与模态框 ==================== */
.modal-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-box {
  width: 92%;
  max-height: 86vh;
  overflow-y: auto;
  background: #FFFFFF;
  border-radius: 26rpx;
  padding: 32rpx 28rpx;
  box-sizing: border-box;
}

.modal-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22rpx;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2937;
}

.modal-close {
  font-size: 32rpx;
  color: #9CA3AF;
  padding: 8rpx;
}

.modal-form {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.form-row {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.form-label {
  font-size: 24rpx;
  color: #4B5563;
  font-weight: 600;
}

.form-input,
.form-picker-box {
  height: 82rpx;
  background: #F9FAFB;
  border: 1rpx solid #E5E7EB;
  border-radius: 12rpx;
  padding: 0 18rpx;
  font-size: 26rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.stock-num-input {
  text-align: center;
  font-size: 36rpx;
  font-weight: 800;
  color: #A43F1C;
}

.quick-stock-btns {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
}

.q-stock-btn {
  text-align: center;
  padding: 14rpx 0;
  background: #F5F2EC;
  border: 1rpx solid #E3DCD2;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #4B3E33;
}

.q-stock-btn.danger {
  background: #FEF2F2;
  border-color: #FECACA;
  color: #DC2626;
}

.photo-editor { align-items: flex-start; gap: 12rpx; }
.dish-photo-preview { width: 180rpx; height: 180rpx; border-radius: 14rpx; }
.photo-btns-row { display: flex; gap: 12rpx; }
.photo-hint { font-size: 22rpx; color: #6B7280; }
.photo-error { font-size: 23rpx; color: #DC2626; }

.seg-type-row { display: flex; gap: 10rpx; }
.seg-type-row .seg-item { border: 1rpx solid #E5E7EB; background: #F9FAFB; }
.seg-type-row .seg-item.active { background: #FFF0EB; border-color: #D9480F; color: #D9480F; }

.modal-btn-row {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.btn-cancel {
  flex: 1;
  background: #F3F4F6 !important;
  color: #4B5563 !important;
  font-size: 26rpx !important;
  border-radius: 18rpx !important;
}

.btn-submit {
  flex: 1.5;
  background: linear-gradient(135deg, #D9480F, #B45309) !important;
  color: #FFFFFF !important;
  font-size: 26rpx !important;
  border-radius: 18rpx !important;
  font-weight: 700;
}

.logs-scroll-list {
  max-height: 54vh;
}

.adjust-log-row {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F0ECE6;
}

.log-top-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}

.log-type-tag {
  font-size: 22rpx;
  font-weight: 700;
  color: #4B5563;
  background: #F3F4F6;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
}

.log-amount {
  font-size: 28rpx;
  font-weight: 800;
}

.log-amount.plus { color: #059669; }
.log-amount.minus { color: #DC2626; }

.log-reason {
  font-size: 24rpx;
  color: #1F2937;
  margin-bottom: 4rpx;
}

.log-meta {
  font-size: 21rpx;
  color: #9CA3AF;
}

.empty-pending-box {
  text-align: center;
  padding: 36rpx 0;
}

.empty-hint {
  font-size: 23rpx;
  color: #9CA3AF;
}

.config-error {
  color: #B42318;
}

/* 菜品分类维护弹窗 */
.category-form-box {
  background: #FAF8F5;
  border: 1rpx solid #EAE3DA;
  border-radius: 16rpx;
  padding: 18rpx;
  margin-bottom: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.cat-form-head {
  font-size: 24rpx;
  font-weight: 700;
  color: #4A3D32;
}

.cat-form-row {
  display: flex;
  gap: 10rpx;
}

.cat-name-input {
  flex: 1.8;
}

.cat-sort-input {
  flex: 1;
  text-align: center;
}

.cat-form-btns {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
}

.cat-list-scroll {
  max-height: 44vh;
}

.cat-manage-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0ECE6;
}

.cat-row-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
  flex: 1;
}

.cat-row-name {
  font-size: 27rpx;
  font-weight: 700;
  color: #2E2925;
}

.cat-row-meta {
  font-size: 21rpx;
  color: #8A7D70;
}

.cat-row-actions {
  display: flex;
  gap: 10rpx;
  flex-shrink: 0;
}
