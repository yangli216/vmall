<!-- miniprogram/pages/admin/admin.wxml -->
<view class="container">

  <!-- 1. 顶部工坊运营概要 -->
  <view class="admin-header-card">
    <view class="header-info">
      <view class="shop-badge">临天八弄作坊掌柜端</view>
      <view class="admin-shop-name">潘小兜老卤 · 运营调度台</view>
      <view class="admin-address-txt">实体资质：JY13301850326102 (含网络经营)</view>
    </view>
  </view>

  <!-- 2. 卤味菜品上下架、编辑与沽清管理 -->
  <view class="section-card">
    <view class="section-header-row">
      <view class="header-left">
        <text class="section-h2">🍲 卤味菜品管理 (共{{dishes.length}}品)</text>
        <text class="section-sub">支持实时上下架、价格修改与新品发布</text>
      </view>
      <button class="btn-add-dish btn-press" bindtap="openAddModal">+ 新增菜品</button>
    </view>

    <view class="dish-manage-list">
      <view wx:for="{{dishes}}" wx:key="id" class="manage-dish-item">
        <image class="manage-dish-img" src="{{item.cover_img}}" mode="aspectFill"></image>
        <view class="manage-dish-info">
          <view class="manage-dish-title-row">
            <text class="manage-dish-name">{{item.title}}</text>
            <text class="manage-dish-tag">{{item.badge}}</text>
          </view>
          <view class="manage-dish-price">
            原价: ¥{{item.origin_price}} | 会员: <text class="red">¥{{item.member_price}}</text>
          </view>
        </view>
        <view class="manage-dish-action">
          <view class="switch-pack">
            <text class="status-label {{item.status === 1 ? 'online' : 'soldout'}}">
              {{item.status === 1 ? '在售' : '沽清'}}
            </text>
            <switch 
              checked="{{item.status === 1}}" 
              color="#07C160" 
              bindchange="toggleProductStatus" 
              data-id="{{item.id}}" 
              data-index="{{index}}"
            />
          </view>
          <view class="dish-btn-group">
            <text class="btn-dish-text edit" bindtap="openEditModal" data-dish="{{item}}">编辑</text>
            <text class="btn-dish-text delete" bindtap="confirmDeleteDish" data-id="{{item.id}}" data-title="{{item.title}}">删除</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 3. 运营配置与履约规则维护 (全量动态参数维护) -->
  <view class="section-card">
    <view class="section-header-row">
      <view class="header-left">
        <text class="section-h2">⚙️ 运营规则与履约参数</text>
        <text class="section-sub">实时下发至前端点单、结算抽屉与返佣引擎</text>
      </view>
    </view>

    <!-- 会员升级门槛模式 -->
    <view class="config-block">
      <view class="config-label-row">
        <text class="config-title">会员晋升门槛模式</text>
        <view class="segment-picker">
          <view 
            class="seg-item {{config.MEMBER_ENTRY_MODE === 'FREE' ? 'active' : ''}}" 
            bindtap="changeUpgradeType" 
            data-type="FREE"
          >
            新客免费开卡
          </view>
          <view 
            class="seg-item {{config.MEMBER_ENTRY_MODE === 'CONSUME' ? 'active' : ''}}" 
            bindtap="changeUpgradeType" 
            data-type="CONSUME"
          >
            累计消费晋级
          </view>
        </view>
      </view>
      <text class="config-desc">
        {{config.MEMBER_ENTRY_MODE === 'FREE' ? '用户授权登录即可一键激活会员折扣' : '需累计消费达标方可自动升级尊享会员'}}
      </text>
    </view>

    <!-- 累计消费门槛金额 -->
    <view class="config-block" wx:if="{{config.MEMBER_ENTRY_MODE === 'CONSUME'}}">
      <view class="config-label-row">
        <text class="config-title">晋升门槛消费金额</text>
        <text class="config-val">满 ¥{{config.MEMBER_ENTRY_THRESHOLD}}</text>
      </view>
      <slider 
        min="30" 
        max="200" 
        step="10" 
        value="{{config.MEMBER_ENTRY_THRESHOLD}}" 
        activeColor="#D9480F" 
        block-color="#D9480F" 
        bindchange="updateThresholdSlider" 
      />
    </view>

    <!-- 红包积分最高冲抵比例 -->
    <view class="config-block border-top">
      <view class="config-label-row">
        <text class="config-title">红包积分单笔抵现上限比例</text>
        <text class="config-val red">{{redDeductPercent}}%</text>
      </view>
      <slider 
        min="10" 
        max="100" 
        step="5" 
        value="{{redDeductPercent}}" 
        activeColor="#D9480F" 
        block-color="#D9480F" 
        bindchange="updateRedRatioSlider" 
      />
      <text class="config-desc">防亏设置：单笔订单最多允许红包抵现的上限比例。</text>
    </view>

    <!-- 推荐好友返佣比例 -->
    <view class="config-block border-top">
      <view class="config-label-row">
        <text class="config-title">推荐好友微信实付返佣率</text>
        <text class="config-val red">{{commissionPercent}}%</text>
      </view>
      <slider 
        min="1" 
        max="10" 
        step="1" 
        value="{{commissionPercent}}" 
        activeColor="#B45309" 
        block-color="#B45309" 
        bindchange="updateCommissionSlider" 
      />
      <text class="config-desc">核心防刷：仅扣除运费与红包后的纯现金实付金额参与返佣。</text>
    </view>

    <!-- 同城自配送规则 -->
    <view class="config-block border-top">
      <view class="config-label-row">
        <text class="config-title">同城自送基础运费 (元)</text>
        <input type="digit" class="config-input-inline" value="{{config.DELIVERY_BASE_FEE}}" bindinput="onInputDeliveryFee" />
      </view>
      <view class="config-label-row margin-top">
        <text class="config-title">免运费满额门槛 (元)</text>
        <input type="digit" class="config-input-inline" value="{{config.DELIVERY_FREE_THRESHOLD}}" bindinput="onInputFreeThreshold" />
      </view>
      <view class="config-label-row margin-top">
        <text class="config-title">掌柜联系电话</text>
        <input class="config-input-inline" value="{{config.DELIVERY_PERSON_PHONE}}" bindinput="onInputPhone" />
      </view>
    </view>

    <!-- 作坊主页公告维护 -->
    <view class="config-block border-top">
      <view class="config-label-row">
        <text class="config-title">作坊主页实时出炉公告</text>
      </view>
      <input class="config-input-full" placeholder="如：今日傍晚 16:30 准时出锅，临天八弄现捞保温直达" value="{{config.WORKSHOP_ANNOUNCEMENT}}" bindinput="onInputAnnouncement" />
    </view>

    <!-- 保存配置按钮 -->
    <button class="btn-save-config btn-press" bindtap="saveAllConfigs">
      保存全部运营参数
    </button>
  </view>

  <!-- 4. 待出炉订单与发车调度 -->
  <view class="section-card">
    <view class="section-header-row">
      <view class="header-left">
        <text class="section-h2">🛵 傍晚出炉出车调度 (待发车 {{pendingOrders.length}} 笔)</text>
        <text class="section-sub">傍晚 16:30 准时出锅，一键通知客户电瓶车配送</text>
      </view>
      <button class="btn-dispatch btn-press" bindtap="dispatchAllOrders" wx:if="{{pendingOrders.length > 0}}">一键全单发车</button>
    </view>

    <view wx:if="{{pendingOrders.length === 0}}" class="empty-pending-box">
      <text class="empty-hint">当前暂无待发车订单，顾客下单付款后将在此汇总展示</text>
    </view>
    <view wx:else class="pending-orders-feed">
      <view wx:for="{{pendingOrders}}" wx:key="id" class="pending-order-item">
        <view class="pending-meta-row">
          <text class="pending-sn">单号: {{item.order_sn}}</text>
          <text class="pending-badge">{{item.delivery_type === 1 ? '作坊自送' : '到店自提'}}</text>
        </view>
        <view class="pending-receiver-info" wx:if="{{item.delivery_type === 1}}">
          <text class="bold-text">📍 {{item.receiver_address}}</text>
          <text class="sub-text">收件人：{{item.receiver_name}} ({{item.receiver_phone}})</text>
        </view>
        <view class="pending-receiver-info" wx:else>
          <text class="bold-text">🏷️ 到店自提码：{{item.pickup_code}}</text>
        </view>
        <view class="pending-dish-text">老卤菜品：{{item.summary_text}}</view>
        <view class="pending-action-row">
          <text class="pending-pay-amount">微信实付 ¥{{item.final_pay_amount}}</text>
          <button class="btn-single-dispatch btn-press" bindtap="dispatchSingleOrder" data-id="{{item.id}}">
            本单发车
          </button>
        </view>
      </view>
    </view>
  </view>

  <!-- 5. 会员全景花名册与特权管理 (掌柜私域核心) -->
  <view class="section-card">
    <view class="section-header-row">
      <view class="header-left">
        <text class="section-h2">👥 会员花名册与特权管理 (共{{members.length}}位)</text>
        <text class="section-sub">支持人工开通/撤销会员、增减积分红包、补录推荐人</text>
      </view>
    </view>

    <!-- 会员资产概览四格看板 -->
    <view class="member-stats-grid">
      <view class="m-stat-box">
        <text class="m-stat-num">{{memberSummary.total_users || 0}}</text>
        <text class="m-stat-lbl">总建档客官(人)</text>
      </view>
      <view class="m-stat-box">
        <text class="m-stat-num highlight">{{memberSummary.total_vip_members || 0}}</text>
        <text class="m-stat-lbl">尊享会员(8.8折)</text>
      </view>
      <view class="m-stat-box">
        <text class="m-stat-num">¥{{memberSummary.all_time_consumption || '0.00'}}</text>
        <text class="m-stat-lbl">老客累计消费</text>
      </view>
      <view class="m-stat-box">
        <text class="m-stat-num red">¥{{memberSummary.total_outstanding_red_points || '0.00'}}</text>
        <text class="m-stat-lbl">在外红包池(元)</text>
      </view>
    </view>

    <!-- 会员搜索栏 -->
    <view class="member-search-bar">
      <input 
        class="member-search-input" 
        placeholder="搜索食客姓名 / 手机号 / 会员卡号 / 邀请码" 
        value="{{memberKeyword}}" 
        bindinput="onInputMemberKeyword" 
        bindconfirm="searchMembers"
      />
      <button class="btn-search-member btn-press" bindtap="searchMembers">搜索</button>
      <button class="btn-clear-member" bindtap="clearMemberSearch" wx:if="{{memberKeyword}}">重置</button>
    </view>

    <!-- 会员列表 -->
    <view class="member-cards-feed">
      <view wx:if="{{members.length === 0}}" class="empty-pending-box">
        <text class="empty-hint">暂未找到匹配的会员记录</text>
      </view>

      <view wx:for="{{members}}" wx:key="id" class="admin-member-card">
        <view class="m-card-top">
          <image class="m-avatar" src="{{item.avatar_url || 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=120'}}" mode="aspectFill"></image>
          <view class="m-profile-info">
            <view class="m-name-line">
              <text class="m-nickname">{{item.nickname || '临安食客'}}</text>
              <text class="m-status-pill {{item.is_member === 1 ? 'vip' : 'normal'}}">
                {{item.is_member === 1 ? '尊享会员 · 8.8折' : '普通客官'}}
              </text>
            </view>
            <view class="m-sub-line">
              <text class="m-card-sn">卡号: {{item.member_card_no || '暂无'}}</text>
              <text class="m-phone">{{item.phone ? item.phone : '未授权手机'}}</text>
            </view>
          </view>
        </view>

        <!-- 财务与裂变数据指标 -->
        <view class="m-metrics-strip">
          <view class="m-metric-item">
            <text class="metric-val">¥{{item.total_consume_amount}}</text>
            <text class="metric-label">累计消费({{item.paid_order_count || 0}}单)</text>
          </view>
          <view class="m-metric-item">
            <text class="metric-val">{{item.normal_points}}</text>
            <text class="metric-label">普通积分</text>
          </view>
          <view class="m-metric-item">
            <text class="metric-val red">¥{{item.red_packet_points}}</text>
            <text class="metric-label">红包积分(可抵现)</text>
          </view>
          <view class="m-metric-item">
            <text class="metric-val">{{item.referral_count || 0}}人</text>
            <text class="metric-label">名下裂变好友</text>
          </view>
        </view>

        <view class="m-referrer-bar">
          <text class="ref-label">推荐人: </text>
          <text class="ref-val" wx:if="{{item.referrer_name}}">{{item.referrer_name}} ({{item.referrer_code}})</text>
          <text class="ref-empty" wx:else>自主进店 (无推荐人)</text>
        </view>

        <!-- 掌柜特权快捷操作条 -->
        <view class="m-actions-row">
          <button class="m-action-btn {{item.is_member === 1 ? 'btn-revoke' : 'btn-grant'}}" bindtap="toggleMemberStatus" data-member="{{item}}">
            {{item.is_member === 1 ? '撤销会员身份' : '👑 升级尊享会员'}}
          </button>
          <button class="m-action-btn btn-points" bindtap="openPointsModal" data-member="{{item}}">
            🎁 调积分/红包
          </button>
          <button class="m-action-btn btn-bind-ref" bindtap="openReferrerModal" data-member="{{item}}">
            🔗 补录推荐人
          </button>
        </view>
      </view>
    </view>
  </view>

  <!-- 6. 新增/编辑菜品弹窗模态框 -->
  <view class="modal-backdrop" wx:if="{{showAddModal}}">
    <view class="modal-box">
      <view class="modal-title-row">
        <text class="modal-title">{{isEditingDish ? '编辑老卤菜品' : '上架新卤味'}}</text>
        <view class="modal-close" bindtap="closeAddModal">✕</view>
      </view>

      <view class="modal-form">
        <view class="form-row">
          <text class="form-label">菜品名称</text>
          <input class="form-input" placeholder="如：老卤虎皮鸡爪 (6只)" value="{{dishForm.title}}" bindinput="onInputFormTitle" />
        </view>
        <view class="form-row">
          <text class="form-label">原价 (元)</text>
          <input type="digit" class="form-input" placeholder="如：25.00" value="{{dishForm.origin_price}}" bindinput="onInputFormOriginPrice" />
        </view>
        <view class="form-row">
          <text class="form-label">会员专享价 (元)</text>
          <input type="digit" class="form-input" placeholder="如：22.00 (约8.8折)" value="{{dishForm.member_price}}" bindinput="onInputFormMemberPrice" />
        </view>
        <view class="form-row">
          <text class="form-label">特色角标</text>
          <input class="form-input" placeholder="如：软烂入骨 / 胶质满满" value="{{dishForm.badge}}" bindinput="onInputFormBadge" />
        </view>
        <view class="form-row">
          <text class="form-label">风味简介</text>
          <input class="form-input" placeholder="如：先炸后卤，虎皮吸满浓郁老卤" value="{{dishForm.intro}}" bindinput="onInputFormIntro" />
        </view>
      </view>

      <view class="modal-btn-row">
        <button class="btn-cancel" bindtap="closeAddModal">取消</button>
        <button class="btn-submit" bindtap="submitDishForm">{{isEditingDish ? '保存修改' : '立即发布上架'}}</button>
      </view>
    </view>
  </view>

  <!-- 7. 人工调整积分/红包弹窗 -->
  <view class="modal-backdrop" wx:if="{{showPointsModal}}">
    <view class="modal-box">
      <view class="modal-title-row">
        <text class="modal-title">调整食客资产【{{currentMember.nickname}}】</text>
        <view class="modal-close" bindtap="closePointsModal">✕</view>
      </view>

      <view class="modal-form">
        <view class="form-row">
          <text class="form-label">调整资产账户</text>
          <view class="seg-type-row">
            <view class="seg-item {{pointsForm.adjust_type === 'NORMAL_POINT' ? 'active' : ''}}" bindtap="onSelectPointsType" data-type="NORMAL_POINT">
              普通积分 (当前: {{currentMember.normal_points}})
            </view>
            <view class="seg-item {{pointsForm.adjust_type === 'RED_PACKET' ? 'active' : ''}}" bindtap="onSelectPointsType" data-type="RED_PACKET">
              红包积分 (当前: ¥{{currentMember.red_packet_points}})
            </view>
          </view>
        </view>
        <view class="form-row">
          <text class="form-label">变动数值 (正数赠送，负数扣减)</text>
          <input type="digit" class="form-input" placeholder="如: 50 或 -20" value="{{pointsForm.amount}}" bindinput="onInputPointsAmount" />
        </view>
        <view class="form-row">
          <text class="form-label">调整原因 (必填审计备注)</text>
          <input class="form-input" placeholder="如：老客生日礼遇 / 线下熟客手工转账录入" value="{{pointsForm.reason}}" bindinput="onInputPointsReason" />
        </view>
      </view>

      <view class="modal-btn-row">
        <button class="btn-cancel" bindtap="closePointsModal">取消</button>
        <button class="btn-submit" bindtap="submitAdjustPoints">确认调整入账</button>
      </view>
    </view>
  </view>

  <!-- 8. 补录/修正推荐人弹窗 -->
  <view class="modal-backdrop" wx:if="{{showReferrerModal}}">
    <view class="modal-box">
      <view class="modal-title-row">
        <text class="modal-title">补录推荐人【{{currentMember.nickname}}】</text>
        <view class="modal-close" bindtap="closeReferrerModal">✕</view>
      </view>

      <view class="modal-form">
        <view class="form-row">
          <text class="form-label">推荐人邀请码 (如 PXD-8802)</text>
          <input class="form-input" placeholder="请输入上级老客的专属邀请码" value="{{referrerForm.invite_code}}" bindinput="onInputReferrerCode" />
        </view>
      </view>

      <view class="modal-btn-row">
        <button class="btn-cancel" bindtap="closeReferrerModal">取消</button>
        <button class="btn-submit" bindtap="submitBindReferrer">确认绑定并关联</button>
      </view>
    </view>
  </view>

</view>
