<!-- miniprogram/pages/admin/admin.wxml -->
<view class="container {{activeTab === 'settings' && configLoaded && configDirty ? 'has-sticky-bar' : ''}}">
 <dev-banner />

  <!-- 1. 顶部工坊运营概要 -->
  <view class="admin-header-card">
    <view class="header-info">
      <view class="shop-badge">潘小兜老卤 · 掌柜工作台</view>
      <view class="admin-shop-name">把每一份老卤，安排妥当</view>
      <view class="admin-address-txt">订单备餐、菜品库存与街坊会员</view>
    </view>
  </view>

  <view class="report-entry btn-press" bindtap="openReport" role="button">
    <text class="report-entry-title">📊 经营日报</text>
    <text class="report-entry-sub">收款、退款、积分流水与菜品明细</text>
    <text class="report-entry-arrow">›</text>
  </view>

  <view wx:if="{{!configLoaded && !configLoading}}" class="support-note config-error card-alert" bindtap="reloadConfigs">
    营业设置尚未完整读取，点击重试。{{configError}}
  </view>

  <!-- 顶部主导航 Tabs（带实时待办数字角标） -->
  <view class="admin-tabs">
    <view class="admin-tab {{activeTab === 'orders' ? 'selected' : ''}}" data-tab="orders" bindtap="changeAdminTab">
      <text>备餐</text>
      <text class="tab-badge" wx:if="{{activityQueues && (activityQueues.to_prepare + activityQueues.ready_pickup + activityQueues.in_delivery) > 0}}">{{activityQueues.to_prepare + activityQueues.ready_pickup + activityQueues.in_delivery}}</text>
    </view>
    <view class="admin-tab {{activeTab === 'products' ? 'selected' : ''}}" data-tab="products" bindtap="changeAdminTab">
      <text>菜品</text>
    </view>
    <view class="admin-tab {{activeTab === 'members' ? 'selected' : ''}}" data-tab="members" bindtap="changeAdminTab">
      <text>会员</text>
    </view>
    <view class="admin-tab {{activeTab === 'support' ? 'selected' : ''}}" data-tab="support" bindtap="changeAdminTab">
      <text>售后</text>
      <text class="tab-badge danger" wx:if="{{activityQueues && activityQueues.support_open > 0}}">{{activityQueues.support_open}}</text>
    </view>
    <view class="admin-tab {{activeTab === 'privacy' ? 'selected' : ''}}" data-tab="privacy" bindtap="changeAdminTab">
      <text>信息申请</text>
      <text class="tab-badge danger" wx:if="{{activityQueues && activityQueues.privacy_open > 0}}">{{activityQueues.privacy_open}}</text>
    </view>
    <view class="admin-tab {{activeTab === 'settings' ? 'selected' : ''}}" data-tab="settings" bindtap="changeAdminTab">
      <text>设置</text>
      <text class="tab-dot" wx:if="{{configDirty}}"></text>
    </view>
  </view>

  <!-- 一体化营业日选择条（备餐 / 菜品共用） -->
  <view class="unified-date-bar" wx:if="{{activeTab === 'orders' || activeTab === 'products'}}">
    <picker class="date-picker-trigger" mode="date" value="{{orderDate}}" bindchange="changeOrderDate">
      <view class="date-bar-inner">
        <text class="date-bar-icon">📅</text>
        <text class="date-bar-text">{{activeTab === 'orders' && allOrderDates ? '全部日期待办 · 点此切回具体日期' : '营业日期：' + orderDate}}</text>
        <text class="date-bar-caret">▾</text>
      </view>
    </picker>
    <view wx:if="{{activeTab === 'orders' && allOrderDates}}" class="btn-back-date btn-press" bindtap="showSelectedDate">仅看 {{orderDate}}</view>
  </view>

  <!-- ==================== TAB 1: 备餐与订单调度 ==================== -->
  <block wx:if="{{activeTab === 'orders'}}">
    <!-- 紧凑分级待办面板 -->
    <view class="section-card activity-panel">
      <view class="activity-head-row">
        <text class="section-h2">全局待办监控</text>
        <text class="activity-poll-tip">{{activityCheckedAt ? '每15秒自动巡检' : '巡检中...'}}</text>
      </view>
      <view class="new-event-banner" wx:if="{{newPaidCount || newSupportCount}}">
        <text>🔔 收到新动态：{{newPaidCount ? '新付款 ' + newPaidCount + ' 单 ' : ''}}{{newSupportCount ? '新售后 ' + newSupportCount + ' 条' : ''}}，请点击下方对应队列查看</text>
      </view>
      <view class="activity-queues" wx:if="{{activityQueues}}">
        <view class="queue-tile {{activityQueues.to_prepare > 0 ? 'urgent' : ''}}" data-kind="prepare" bindtap="openActivityQueue">
          <text class="q-num">{{activityQueues.to_prepare}}</text>
          <text class="q-lbl">待备餐</text>
        </view>
        <view class="queue-tile {{activityQueues.ready_pickup > 0 ? 'warn' : ''}}" data-kind="pickup" bindtap="openActivityQueue">
          <text class="q-num">{{activityQueues.ready_pickup}}</text>
          <text class="q-lbl">待取餐</text>
        </view>
        <view class="queue-tile {{activityQueues.in_delivery > 0 ? 'info' : ''}}" data-kind="delivery" bindtap="openActivityQueue">
          <text class="q-num">{{activityQueues.in_delivery}}</text>
          <text class="q-lbl">配送中</text>
        </view>
        <view class="queue-tile {{activityQueues.refund_pending > 0 ? 'danger' : ''}}" data-kind="refund" bindtap="openActivityQueue">
          <text class="q-num">{{activityQueues.refund_pending}}</text>
          <text class="q-lbl">退款中</text>
        </view>
        <view class="queue-tile {{activityQueues.support_open > 0 ? 'danger' : ''}}" data-kind="support" bindtap="openActivityQueue">
          <text class="q-num">{{activityQueues.support_open}}</text>
          <text class="q-lbl">待处理售后</text>
        </view>
        <view class="queue-tile {{activityQueues.privacy_open > 0 ? 'warn' : ''}}" data-kind="privacy" bindtap="openActivityQueue">
          <text class="q-num">{{activityQueues.privacy_open || 0}}</text>
          <text class="q-lbl">信息申请</text>
        </view>
      </view>
      <view wx:if="{{activityQueues && activityQueues.overdue_pickup > 0}}" class="overdue-alert-bar btn-press" data-kind="overdue" bindtap="openActivityQueue">
        <text>⚠️ 往日未取餐 {{activityQueues.overdue_pickup}} 单，点此查看并联系顾客 ›</text>
      </view>
      <view class="support-note config-error" wx:if="{{activityError}}" bindtap="refreshActivity">动态检查失败：{{activityError}}，点击重试</view>
    </view>

    <!-- 订单列表主卡片 -->
    <view class="section-card">
      <view class="section-header-row">
        <view class="header-left">
          <text class="section-h2">🛵 订单调度 (已加载 {{pendingOrders.length}} 笔)</text>
          <text class="section-sub">{{allOrderDates ? '全部日期待办视图，包含历史未完结单' : '按所选营业日与筛选条件查看'}}</text>
        </view>
        <button class="btn-dispatch btn-press {{dispatchableCount === 0 ? 'is-disabled' : ''}}" bindtap="dispatchAllOrders" disabled="{{orderLoading || dispatchableCount === 0}}" wx:if="{{!allOrderDates}}">
          本批发车({{dispatchableCount}})
        </button>
      </view>

      <!-- 筛选与搜索栏 -->
      <view class="order-filter-grid">
        <picker class="filter-pill-picker" range="{{orderFilters}}" range-key="label" value="{{orderFilterIndex}}" bindchange="changeOrderFilter">
          <view class="picker-pill-inner">{{orderFilters[orderFilterIndex].label}} ▾</view>
        </picker>
        <picker class="filter-pill-picker" range="{{orderDeliveryNames}}" value="{{orderDeliveryIndex}}" bindchange="changeOrderDelivery">
          <view class="picker-pill-inner">{{orderDeliveryNames[orderDeliveryIndex]}} ▾</view>
        </picker>
      </view>
      <view class="member-search-bar order-search-bar">
        <view class="search-input-wrap">
          <input class="search-input-field" placeholder="搜索订单号或收件人手机号" value="{{orderKeyword}}" bindinput="onOrderKeyword" bindconfirm="searchOrders" />
          <text wx:if="{{orderKeyword}}" class="search-clear-x" bindtap="clearOrderKeyword">✕</text>
        </view>
        <button class="btn-wk-primary btn-press" bindtap="searchOrders">搜索</button>
      </view>

      <view wx:if="{{overduePickupOnly}}" class="support-note warn-box">仅显示营业日期早于今天的待取餐订单。请联系顾客协商，核销仍需顾客出示4位自提码。</view>
      <view class="capacity-chip-note" wx:if="{{batchCapacity}}">
        📦 本批已接 <text class="bold">{{batchCapacity.used_orders}}</text> 单 · {{batchCapacity.max_orders > 0 ? '上限 ' + batchCapacity.max_orders + ' 单，剩余 ' + batchCapacity.remaining_orders + ' 单' : '未设接单上限'}}（含待付款及已完成单）
      </view>
      <view class="support-note config-error" wx:if="{{capacityError}}" bindtap="retryOrders">{{capacityError}} · 点击重试</view>

      <!-- 备餐汇总卡片（含总份数与一键复制） -->
      <view class="prep-summary-card" wx:if="{{!allOrderDates}}">
        <view class="prep-header-row">
          <text class="prep-title">🍲 本批待备餐汇总 <text wx:if="{{prepSummary.length}}" class="prep-total-badge">{{prepSummary.length}}款 · 共{{prepTotalQty}}份</text></text>
          <text wx:if="{{prepSummary.length}}" class="btn-copy-prep btn-press" bindtap="copyPrepSummary">📋 复制清单</text>
        </view>
        <view wx:if="{{prepError}}" class="config-error" bindtap="retryOrders">{{prepError}} · 点击重试</view>
        <view wx:elif="{{!prepSummary.length}}" class="prep-empty">暂无待备餐菜品</view>
        <view wx:else class="prep-items-grid">
          <view class="prep-item-row" wx:for="{{prepSummary}}" wx:key="product_id">
            <text class="prep-dish-name">{{item.product_title}}</text>
            <text class="prep-dish-qty">× {{item.quantity}} 份</text>
          </view>
        </view>
      </view>

      <view wx:if="{{orderError}}" class="support-note config-error" bindtap="retryOrders">{{orderError}} · 点击重试</view>
      <view wx:if="{{orderLoading}}" class="support-note">正在加载订单…</view>
      <view wx:if="{{pendingOrders.length === 0 && !orderLoading && !orderError}}" class="empty-pending-box">
        <text class="empty-hint">所选日期和条件下暂无订单</text>
      </view>

      <view class="pending-orders-feed">
        <view wx:for="{{pendingOrders}}" wx:key="id" class="pending-order-item">
          <view class="pending-meta-row">
            <text class="pending-sn">{{item.status_title}} · {{item.order_sn}}</text>
            <text class="pending-badge {{item.delivery_type === 1 ? 'delivery' : 'pickup'}}">{{item.delivery_type === 1 ? '作坊自送' : '到店自提'}}</text>
          </view>
          <view class="pending-receiver-info" wx:if="{{item.delivery_type === 1}}" data-address="{{item.receiver_address}}" bindtap="copyOrderAddress">
            <text class="bold-text">📍 {{item.receiver_address}} <text class="inline-copy-tag">复制</text></text>
          </view>
          <view class="pending-receiver-info" wx:else>
            <text class="bold-text">🏷️ 到店自提码：{{item.pickup_code}}</text>
          </view>
          <view class="customer-call-row" bindtap="callSupportCustomer" data-phone="{{item.receiver_phone}}">
            <text>📞 联系 {{item.receiver_name}}：{{item.receiver_phone}}</text>
            <text class="call-tag">拨打 ›</text>
          </view>
          <view class="pending-dish-text">{{item.expect_time_slot}} · {{item.summary_text}}</view>
          <view wx:if="{{item.order_remark}}" class="pending-remark-text">备注：{{item.order_remark}}</view>
          <view class="pending-action-row">
            <text class="pending-pay-amount">实付 ¥{{item.final_pay_amount}}</text>
            <view class="order-btns-pack">
              <button wx:if="{{item.order_status === 20 && item.delivery_type === 1 && item.payment_state === 'PAID'}}" class="btn-wk-success btn-press" bindtap="dispatchSingleOrder" data-id="{{item.id}}">本单发车</button>
              <button wx:if="{{item.order_status === 20 && item.delivery_type === 2 && item.payment_state === 'PAID'}}" class="btn-wk-warn btn-press" bindtap="preparePickup" data-id="{{item.id}}">备好待取</button>
              <button wx:if="{{item.order_status === 25}}" class="btn-wk-primary btn-press" bindtap="verifyPickup" data-id="{{item.id}}" disabled="{{!!completionBusyId}}" loading="{{completionBusyId === item.id}}">核销取餐</button>
              <button wx:if="{{item.order_status === 30 && item.delivery_type === 1 && item.payment_state === 'PAID'}}" class="btn-wk-primary btn-press" bindtap="confirmDelivery" data-id="{{item.id}}" disabled="{{!!completionBusyId}}" loading="{{completionBusyId === item.id}}">核实送达</button>
              <button wx:if="{{item.order_status === 20 && item.payment_state === 'PAID'}}" class="btn-wk-danger-outline btn-press" bindtap="cancelShopOrder" data-id="{{item.id}}">取消退款</button>
              <button wx:if="{{(item.order_status === 25 || item.order_status === 30 || item.order_status === 40) && item.payment_state === 'PAID'}}" class="btn-wk-danger-outline btn-press" bindtap="refundShopOrder" data-id="{{item.id}}" disabled="{{!!refundBusyId}}" loading="{{refundBusyId === item.id}}">售后退款</button>
            </view>
          </view>
          <view wx:if="{{item.completion_title}}" class="pending-note-sub">{{item.completion_title}} · {{item.completed_time}}：{{item.completion_note}}</view>
          <view wx:if="{{item.refund_reason}}" class="pending-note-sub danger">退款原因：{{item.refund_reason}}</view>
          <view wx:if="{{item.refund_error}}" class="pending-note-sub danger">{{item.refund_error}}</view>
        </view>
      </view>
    </view>

    <button class="btn-wk-loadmore btn-press" wx:if="{{orderNextCursor}}" bindtap="moreOrders" loading="{{orderLoading}}" disabled="{{orderLoading}}">加载更多订单</button>
  </block>

  <!-- ==================== TAB 2: 菜品与库存管理 ==================== -->
  <view class="section-card products-section" wx:if="{{activeTab === 'products'}}">
    <view class="section-header-row">
      <view class="header-left">
        <text class="section-h2">菜品管理 <text class="dish-total">共{{dishes.length}}款（当前显示{{filteredDishes.length}}）</text></text>
        <text class="section-sub">上下架与定价 · 库存对应当前所选营业日</text>
      </view>
      <button class="btn-add-dish btn-press" bindtap="openAddModal">＋ 新增</button>
    </view>

    <!-- 分类与状态快捷筛选 -->
    <view class="product-filter-bar">
      <picker class="prod-cat-picker" range="{{categoryOptions}}" range-key="name" value="{{productCategoryFilter}}" bindchange="changeProductCatFilter">
        <view class="prod-cat-pill">{{categoryOptions[productCategoryFilter].name || '全部分类'}} ▾</view>
      </picker>
      <scroll-view scroll-x="true" show-scrollbar="{{false}}" class="prod-status-scroll">
        <view class="prod-status-inner">
          <view class="prod-status-chip {{productStatusFilter === 'ALL' ? 'active' : ''}}" data-status="ALL" bindtap="changeProductStatusFilter">全部</view>
          <view class="prod-status-chip {{productStatusFilter === 'ON' ? 'active' : ''}}" data-status="ON" bindtap="changeProductStatusFilter">在售</view>
          <view class="prod-status-chip {{productStatusFilter === 'OFF' ? 'active' : ''}}" data-status="OFF" bindtap="changeProductStatusFilter">已下架</view>
          <view class="prod-status-chip {{productStatusFilter === 'LOW' ? 'active' : ''}}" data-status="LOW" bindtap="changeProductStatusFilter">低库存(≤5)</view>
        </view>
      </scroll-view>
    </view>

    <view wx:if="{{!filteredDishes.length && !loading}}" class="empty-pending-box">
      <text class="empty-hint">暂无符合筛选条件的菜品</text>
    </view>

    <view class="dish-manage-list">
      <view wx:for="{{filteredDishes}}" wx:key="id" class="manage-dish-item">
        <view class="manage-dish-main">
          <image wx:if="{{item.cover_img && !item.imageFailed}}" class="manage-dish-img" src="{{item.cover_img}}" mode="aspectFill" binderror="onDishImageError" data-id="{{item.id}}" data-index="{{index}}"></image>
          <view wx:else class="manage-dish-img dish-image-empty"><text>卤</text><text class="dish-image-caption">待补图片</text></view>
          <view class="manage-dish-info">
            <view class="manage-dish-title-row">
              <text class="manage-dish-name">{{item.title}}</text>
            </view>
            <text wx:if="{{item.badge}}" class="manage-dish-tag">{{item.badge}}</text>
            <view class="manage-dish-price"><text>¥{{item.origin_price}}</text><text class="member-price">会员 ¥{{item.member_price}}</text></view>
          </view>
        </view>
        <view class="manage-dish-action">
          <view class="dish-stock" bindtap="adjustStock" data-id="{{item.id}}">
            <text class="dish-stock-label">本批剩余</text>
            <text class="dish-stock-value {{item.stock_qty <= 5 ? 'low' : ''}}">{{item.stock_qty}}</text>
            <text class="dish-stock-label">份</text>
            <text class="dish-stock-edit">调整 ›</text>
          </view>
          <view class="switch-pack">
            <text class="status-label {{item.status === 1 ? 'online' : 'soldout'}}">{{item.status === 1 ? '在售' : '已下架'}}</text>
            <switch checked="{{item.status === 1}}" color="#278464" bindchange="toggleProductStatus" data-id="{{item.id}}" data-index="{{index}}" />
          </view>
        </view>
        <view class="dish-btn-group">
          <button class="btn-dish-text delete btn-press" bindtap="confirmDeleteDish" data-id="{{item.id}}" data-title="{{item.title}}">删除菜品</button>
          <button class="btn-dish-text edit btn-press" bindtap="openEditModal" data-dish="{{item}}">编辑菜品</button>
        </view>
      </view>
    </view>
  </view>

  <!-- ==================== TAB 3: 会员花名册与特权管理 ==================== -->
  <view wx:if="{{activeTab === 'members'}}" class="section-card">
    <view class="section-header-row">
      <view class="header-left">
        <text class="section-h2">👥 会员花名册 (共{{memberTotal}}位)</text>
        <text class="section-sub">支持会员管理、增减积分红包及审计流水查看</text>
      </view>
      <view class="btn-logs-entry btn-press" bindtap="openAdjustLogsModal">📜 调分审计</view>
    </view>

    <!-- 会员资产概览四格看板 -->
    <view class="member-stats-grid">
      <view class="m-stat-box">
        <text class="m-stat-num">{{memberSummary.total_users || 0}}</text>
        <text class="m-stat-lbl">总建档客官(人)</text>
      </view>
      <view class="m-stat-box">
        <text class="m-stat-num highlight">{{memberSummary.total_vip_members || 0}}</text>
        <text class="m-stat-lbl">尊享会员(会员价)</text>
      </view>
      <view class="m-stat-box">
        <text class="m-stat-num">¥{{memberSummary.all_time_consumption || '0.00'}}</text>
        <text class="m-stat-lbl">老客累计消费</text>
      </view>
      <view class="m-stat-box">
        <text class="m-stat-num red">¥{{memberSummary.total_outstanding_red_points || '0.00'}}</text>
        <text class="m-stat-lbl">在外红包池(元)</text>
      </view>
    </view>

    <!-- 会员身份筛选胶囊 -->
    <view class="member-filter-pills">
      <view class="m-filter-chip {{memberFilterIsMember === '' ? 'active' : ''}}" data-filter="" bindtap="changeMemberFilter">全部客官</view>
      <view class="m-filter-chip {{memberFilterIsMember === '1' ? 'active' : ''}}" data-filter="1" bindtap="changeMemberFilter">尊享会员</view>
      <view class="m-filter-chip {{memberFilterIsMember === '0' ? 'active' : ''}}" data-filter="0" bindtap="changeMemberFilter">普通客官</view>
    </view>

    <!-- 会员搜索栏 -->
    <view class="member-search-bar">
      <view class="search-input-wrap">
        <input class="search-input-field" placeholder="姓名 / 手机号 / 卡号 / 邀请码" value="{{memberKeyword}}" bindinput="onInputMemberKeyword" bindconfirm="searchMembers" />
        <text wx:if="{{memberKeyword}}" class="search-clear-x" bindtap="clearMemberSearch">✕</text>
      </view>
      <button class="btn-wk-primary btn-press" bindtap="searchMembers">搜索</button>
    </view>

    <!-- 会员列表 -->
    <view class="member-cards-feed">
      <view wx:if="{{memberError}}" class="empty-pending-box" bindtap="searchMembers">{{memberError}} · 点击重试</view>
      <view wx:if="{{members.length === 0 && !memberLoading && !memberError}}" class="empty-pending-box">
        <text class="empty-hint">暂未找到匹配的会员记录</text>
      </view>

      <view wx:for="{{members}}" wx:key="id" class="admin-member-card">
        <view class="m-card-top">
          <image class="m-avatar" src="{{item.avatar_url || '/images/tab_member.png'}}" mode="aspectFit"></image>
          <view class="m-profile-info">
            <view class="m-name-line">
              <text class="m-nickname">{{item.nickname || '临安食客'}}</text>
              <text class="m-status-pill {{item.is_member === 1 ? 'vip' : 'normal'}}">{{item.is_member === 1 ? '尊享会员 · 会员价' : '普通客官'}}</text>
            </view>
            <view class="m-sub-line">
              <text class="m-card-sn">卡号: {{item.member_card_no || '暂无'}}</text>
              <text class="m-phone">{{item.phone ? item.phone : '未授权手机'}}</text>
            </view>
          </view>
        </view>

        <view class="m-metrics-strip">
          <view class="m-metric-item">
            <text class="metric-val">¥{{item.total_consume_amount}}</text>
            <text class="metric-label">累计消费({{item.paid_order_count || 0}}单)</text>
          </view>
          <view class="m-metric-item">
            <text class="metric-val">{{item.normal_points}}</text>
            <text class="metric-label">普通积分</text>
            <text class="metric-debt" wx:if="{{item.normal_points_debt > 0}}">待抵回 {{item.normal_points_debt}}</text>
          </view>
          <view class="m-metric-item">
            <text class="metric-val red">¥{{item.red_packet_points}}</text>
            <text class="metric-label">红包积分(可抵现)</text>
            <text class="metric-debt" wx:if="{{item.red_packet_debt > 0}}">待抵回 ¥{{item.red_packet_debt}}</text>
          </view>
          <view class="m-metric-item">
            <text class="metric-val">{{item.referral_count || 0}}人</text>
            <text class="metric-label">名下裂变好友</text>
          </view>
        </view>

        <view class="m-referrer-bar">
          <text class="ref-label">推荐人: </text>
          <text class="ref-val" wx:if="{{item.referrer_name}}">{{item.referrer_name}} ({{item.referrer_code}})</text>
          <text class="ref-empty" wx:else>自主进店 (无推荐人)</text>
        </view>

        <!-- 修复：横向紧凑一行排列的操作按钮 -->
        <view class="m-actions-row">
          <button class="m-action-btn {{item.is_member === 1 ? 'btn-revoke' : 'btn-grant'}} btn-press" bindtap="toggleMemberStatus" data-member="{{item}}">
            {{item.is_member === 1 ? '撤销会员' : '👑 升会员'}}
          </button>
          <button class="m-action-btn btn-points btn-press" bindtap="openPointsModal" data-member="{{item}}">
            🎁 调积分
          </button>
          <button class="m-action-btn btn-bind-ref btn-press" bindtap="openAdjustLogsModal" data-member="{{item}}">
            📜 调分记录
          </button>
          <button wx:if="{{!item.referrer_name && !(item.paid_order_count > 0)}}" class="m-action-btn btn-bind-ref btn-press" bindtap="openReferrerModal" data-member="{{item}}">
            🔗 补推荐人
          </button>
        </view>
      </view>
    </view>
    <button class="btn-wk-loadmore btn-press" wx:if="{{memberNextCursor}}" loading="{{memberLoading}}" disabled="{{memberLoading}}" bindtap="moreMembers">加载更多会员（已显示{{members.length}}位）</button>
    <view wx:if="{{memberLoading && !members.length}}" class="empty-pending-box">正在加载会员…</view>
  </view>

  <!-- ==================== TAB 4: 订单问题与售后 ==================== -->
  <view class="section-card" wx:if="{{activeTab === 'support'}}">
    <view class="section-h2">订单问题与售后</view>
    <view class="support-filters">
      <view class="filter-chip {{supportStatus === 'OPEN' ? 'selected' : ''}}" data-status="OPEN" bindtap="changeSupportStatus">待处理{{activityQueues && activityQueues.support_open > 0 ? '(' + activityQueues.support_open + ')' : ''}}</view>
      <view class="filter-chip {{supportStatus === 'PROCESSING' ? 'selected' : ''}}" data-status="PROCESSING" bindtap="changeSupportStatus">处理中</view>
      <view class="filter-chip {{supportStatus === 'RESOLVED' ? 'selected' : ''}}" data-status="RESOLVED" bindtap="changeSupportStatus">已回复</view>
    </view>
    <view class="support-note">接单后请联系顾客协商，回复具体处理结果。回复不改变订单资金状态，退款请到订单中操作。</view>
    <view wx:if="{{supportError}}" class="support-note config-error" bindtap="loadSupportTickets">{{supportError}} · 点击重试</view>
    <view wx:if="{{!supportTickets.length && !supportLoading && !supportError}}" class="empty-pending-box"><text class="empty-hint">暂无该状态的售后记录</text></view>

    <view class="ticket-cards-feed">
      <view class="ticket-card-item" wx:for="{{supportTickets}}" wx:key="id">
        <view class="ticket-head-row">
          <text class="ticket-category">{{item.category_title}}</text>
          <text class="ticket-status-tag status-{{item.status}}">{{item.status_title}}</text>
        </view>
        <view class="ticket-meta">{{item.order_sn}} · {{item.create_time}}</view>
        <view class="support-description">{{item.description}}</view>
        <view class="customer-call-row" bindtap="callSupportCustomer" data-phone="{{item.receiver_phone}}">
          <text>📞 {{item.receiver_name}}：{{item.receiver_phone}}</text>
          <text class="call-tag">拨打 ›</text>
        </view>
        <view wx:if="{{item.resolution}}" class="ticket-resolution-box">处理结果：{{item.resolution}}</view>
        <view class="support-actions">
          <button class="btn-wk-secondary btn-press" data-id="{{item.id}}" bindtap="openSupportOrder">查看订单</button>
          <button wx:if="{{item.status === 'OPEN'}}" class="btn-wk-warn btn-press" disabled="{{!!supportBusyId}}" data-id="{{item.id}}" bindtap="acceptSupportTicket">接单处理</button>
          <button wx:if="{{item.status !== 'RESOLVED'}}" class="btn-wk-primary btn-press" disabled="{{!!supportBusyId}}" data-id="{{item.id}}" bindtap="replySupportTicket">回复结果</button>
        </view>
      </view>
    </view>
    <button class="btn-wk-loadmore btn-press" wx:if="{{supportNextCursor}}" loading="{{supportLoading}}" disabled="{{supportLoading}}" bindtap="moreSupportTickets">加载更多售后</button>
    <view wx:if="{{supportLoading}}" class="support-note">正在加载…</view>
  </view>

  <!-- ==================== TAB 5: 个人信息处理申请 ==================== -->
  <view class="section-card" wx:if="{{activeTab === 'privacy'}}">
    <view class="section-h2">个人信息处理申请</view>
    <view class="support-note">先核实本人身份、订单退款及会员资产，再实际处理并回复。回复只记录说明，不自动注销账号或删除订单。</view>
    <view class="support-filters">
      <view class="filter-chip {{privacyStatus === 'OPEN' ? 'selected' : ''}}" data-status="OPEN" bindtap="changePrivacyStatus">待处理{{activityQueues && activityQueues.privacy_open > 0 ? '(' + activityQueues.privacy_open + ')' : ''}}</view>
      <view class="filter-chip {{privacyStatus === 'PROCESSING' ? 'selected' : ''}}" data-status="PROCESSING" bindtap="changePrivacyStatus">核实中</view>
      <view class="filter-chip {{privacyStatus === 'RESOLVED' ? 'selected' : ''}}" data-status="RESOLVED" bindtap="changePrivacyStatus">已回复</view>
      <view class="filter-chip {{privacyStatus === 'CANCELLED' ? 'selected' : ''}}" data-status="CANCELLED" bindtap="changePrivacyStatus">已撤回</view>
    </view>
    <view wx:if="{{privacyError}}" class="support-note config-error" bindtap="loadPrivacyRequests">{{privacyError}} · 点击重试</view>
    <view wx:if="{{!privacyRequests.length && !privacyLoading && !privacyError}}" class="empty-pending-box"><text class="empty-hint">暂无该状态的申请</text></view>

    <view class="ticket-cards-feed">
      <view class="ticket-card-item" wx:for="{{privacyRequests}}" wx:key="id">
        <view class="ticket-head-row">
          <text class="ticket-category">{{item.kind_title}}</text>
          <text class="ticket-status-tag status-{{item.status}}">{{item.status_title}}</text>
        </view>
        <view class="ticket-meta">申请 #{{item.id}} · {{item.nickname}} · {{item.create_time}}</view>
        <view class="support-description">{{item.description}}</view>
        <view wx:if="{{item.resolution}}" class="ticket-resolution-box">回复：{{item.resolution}}</view>
        <view wx:if="{{item.status === 'OPEN' || item.status === 'PROCESSING'}}" class="support-actions">
          <button wx:if="{{item.status === 'OPEN'}}" class="btn-wk-warn btn-press" disabled="{{!!privacyBusyId}}" data-id="{{item.id}}" bindtap="acceptPrivacyRequest">接单核实</button>
          <button class="btn-wk-primary btn-press" disabled="{{!!privacyBusyId}}" data-id="{{item.id}}" bindtap="replyPrivacyRequest">记录处理说明</button>
        </view>
      </view>
    </view>
    <button class="btn-wk-loadmore btn-press" wx:if="{{privacyNextCursor}}" loading="{{privacyLoading}}" disabled="{{privacyLoading}}" bindtap="morePrivacyRequests">加载更多申请</button>
    <view wx:if="{{privacyLoading}}" class="support-note">正在加载…</view>
  </view>

  <!-- ==================== TAB 6: 运营规则与履约参数设置 ==================== -->
  <block wx:if="{{activeTab === 'settings'}}">
    <view class="section-card">
      <view class="section-header-row">
        <view class="header-left">
          <text class="section-h2">⚙️ 运营规则与履约参数</text>
          <text class="section-sub">实时同步至前台点单、结算抽屉与返佣引擎</text>
        </view>
        <view class="btn-wk-secondary btn-press" bindtap="reloadConfigs">↻ 重新读取</view>
      </view>

      <view wx:if="{{configError}}" class="support-note config-error">{{configError}}</view>
      <view wx:if="{{configLoading}}" class="support-note">正在读取营业设置…</view>
      <view wx:if="{{!configLoaded && !configLoading}}" class="support-note">尚未读取营业设置，读取成功后才能编辑和保存。</view>
      <view wx:if="{{configDirty}}" class="dirty-warn-bar">有尚未保存的修改。保存失败时输入会保留，可放心重试。</view>
    </view>

    <block wx:if="{{configLoaded}}">
      <!-- 组 1: 门店营业与联络 -->
      <view class="section-card">
        <view class="group-heading">🏠 门店营业与自提信息</view>
        <view class="config-row-between">
          <text class="config-title">作坊营业状态</text>
          <switch disabled="{{configLoading || configSaving}}" checked="{{config.SHOP_OPEN === '1'}}" color="#278464" bindchange="onShopOpen" />
        </view>
        <view class="config-block">
          <text class="config-title">主页实时出炉公告</text>
          <input disabled="{{configLoading || configSaving}}" class="config-input-box" placeholder="如：今日 16:30 准时出锅，现捞保温直达" value="{{config.WORKSHOP_ANNOUNCEMENT}}" bindinput="onInputAnnouncement" />
        </view>
        <view class="config-block">
          <text class="config-title">门店自提地址</text>
          <textarea disabled="{{configLoading || configSaving}}" class="config-textarea-box" value="{{config.WORKSHOP_ADDRESS}}" data-field="WORKSHOP_ADDRESS" bindinput="onConfigInput" maxlength="255" placeholder="请填写省市区、街道和门牌号" />
          <text class="config-desc">用于新建自提订单，历史订单保留原取餐地址。</text>
        </view>
        <view class="config-row-between">
          <text class="config-title">掌柜 / 自送联系人</text>
          <input disabled="{{configLoading || configSaving}}" class="config-input-inline" value="{{config.DELIVERY_PERSON_NAME}}" data-field="DELIVERY_PERSON_NAME" bindinput="onConfigInput" maxlength="50" />
        </view>
        <view class="config-row-between">
          <text class="config-title">掌柜联系电话</text>
          <input disabled="{{configLoading || configSaving}}" type="number" maxlength="11" class="config-input-inline" value="{{config.DELIVERY_PERSON_PHONE}}" bindinput="onInputPhone" />
        </view>
      </view>

      <!-- 组 2: 批次时间与订单配额 -->
      <view class="section-card">
        <view class="group-heading">⏰ 批次时间与接单配额</view>
        <view class="config-row-between">
          <text class="config-title">出炉时间</text>
          <picker mode="time" disabled="{{configLoading || configSaving}}" value="{{config.BATCH_SCHEDULE_TIME}}" data-field="BATCH_SCHEDULE_TIME" bindchange="onConfigInput">
            <view class="config-picker-chip">{{config.BATCH_SCHEDULE_TIME || '16:30'}} ▾</view>
          </picker>
        </view>
        <view class="config-row-between">
          <text class="config-title">截单时间（不晚于出炉）</text>
          <picker mode="time" disabled="{{configLoading || configSaving}}" value="{{config.BATCH_CUTOFF_TIME}}" data-field="BATCH_CUTOFF_TIME" bindchange="onConfigInput">
            <view class="config-picker-chip">{{config.BATCH_CUTOFF_TIME || '16:00'}} ▾</view>
          </picker>
        </view>
        <view class="config-row-between">
          <text class="config-title">未来可预约天数 (0-7天)</text>
          <input disabled="{{configLoading || configSaving}}" type="number" class="config-input-inline" value="{{config.BOOKING_DAYS}}" data-field="BOOKING_DAYS" bindinput="onConfigInput" />
        </view>
        <view class="config-row-between">
          <text class="config-title">每批接单上限 (0表示不限)</text>
          <input disabled="{{configLoading || configSaving}}" type="number" class="config-input-inline" value="{{config.BATCH_MAX_ORDERS}}" data-field="BATCH_MAX_ORDERS" bindinput="onConfigInput" />
        </view>
        <view class="config-row-between">
          <text class="config-title">未付款关闭时限 (5-30分钟)</text>
          <input disabled="{{configLoading || configSaving}}" type="number" class="config-input-inline" value="{{config.ORDER_EXPIRE_MINUTES}}" data-field="ORDER_EXPIRE_MINUTES" bindinput="onConfigInput" />
        </view>
        <text class="config-desc">未付款订单也占名额；取消或备餐前退款后释放。</text>
      </view>

      <!-- 组 3: 同城自送运费与小区 -->
      <view class="section-card">
        <view class="group-heading">🛵 同城自送与运费</view>
        <view class="config-row-between">
          <text class="config-title">同城自送基础运费 (元)</text>
          <input disabled="{{configLoading || configSaving}}" type="digit" class="config-input-inline" value="{{config.DELIVERY_BASE_FEE}}" bindinput="onInputDeliveryFee" />
        </view>
        <view class="config-row-between">
          <text class="config-title">免运费满额门槛 (元)</text>
          <input disabled="{{configLoading || configSaving}}" type="digit" class="config-input-inline" value="{{config.DELIVERY_FREE_THRESHOLD}}" bindinput="onInputFreeThreshold" />
        </view>
        <view class="config-block">
          <text class="config-title">可自送小区白名单 (逗号分隔，留空仅自提)</text>
          <textarea disabled="{{configLoading || configSaving}}" class="config-textarea-box" value="{{config.DELIVERY_AREAS}}" data-field="DELIVERY_AREAS" bindinput="onConfigInput" maxlength="255" placeholder="如：春天花园,锦绣江南" />
        </view>
      </view>

      <!-- 组 4: 会员特权与返佣 -->
      <view class="section-card">
        <view class="group-heading">👑 会员晋升与奖励比例</view>
        <view class="config-block">
          <view class="config-label-row config-mode-row">
            <text class="config-title">会员晋升门槛模式</text>
            <view class="segment-picker">
              <view class="seg-item {{config.MEMBER_ENTRY_MODE === 'FREE' ? 'active' : ''}}" bindtap="changeUpgradeType" data-type="FREE">新客免费开卡</view>
              <view class="seg-item {{config.MEMBER_ENTRY_MODE === 'CONSUME' ? 'active' : ''}}" bindtap="changeUpgradeType" data-type="CONSUME">累计消费晋级</view>
              <view class="seg-item {{config.MEMBER_ENTRY_MODE === 'MANUAL' ? 'active' : ''}}" bindtap="changeUpgradeType" data-type="MANUAL">掌柜邀请</view>
            </view>
          </view>
          <text class="config-desc">{{config.MEMBER_ENTRY_MODE === 'FREE' ? '顾客可主动免费开通会员' : config.MEMBER_ENTRY_MODE === 'MANUAL' ? '仅由掌柜在会员管理中开通' : '需累计有效现金货款达标后自动晋级，下一单享会员价'}}</text>
        </view>
        <view class="config-row-between" wx:if="{{config.MEMBER_ENTRY_MODE === 'CONSUME'}}">
          <text class="config-title">晋升门槛消费金额 (元)</text>
          <input disabled="{{configLoading || configSaving}}" type="digit" class="config-input-inline" value="{{config.MEMBER_ENTRY_THRESHOLD}}" data-field="MEMBER_ENTRY_THRESHOLD" bindinput="onConfigInput" />
        </view>
        <view class="config-block">
          <view class="config-label-row">
            <text class="config-title">红包单笔抵现上限比例</text>
            <text class="config-val red">{{redDeductPercent}}%</text>
          </view>
          <slider disabled="{{configLoading || configSaving}}" min="0" max="100" step="5" value="{{redDeductPercent}}" activeColor="#D9480F" block-color="#D9480F" bindchange="updateRedRatioSlider" />
        </view>
        <view class="config-block">
          <view class="config-label-row">
            <text class="config-title">推荐好友微信实付返佣率</text>
            <text class="config-val red">{{commissionPercent}}%</text>
          </view>
          <slider disabled="{{configLoading || configSaving}}" min="0" max="10" step="1" value="{{commissionPercent}}" activeColor="#B45309" block-color="#B45309" bindchange="updateCommissionSlider" />
          <text class="config-desc">有效现金货款不含配送费和各类优惠，好友完成订单后发放。</text>
        </view>

        <button class="btn-save-config btn-press" disabled="{{configLoading || configSaving}}" loading="{{configSaving}}" bindtap="saveAllConfigs">
          保存全部营业设置
        </button>
      </view>
    </block>

    <!-- 吸底浮动保存栏（存在未保存变更时浮出） -->
    <view class="sticky-save-bar" wx:if="{{configLoaded && configDirty}}">
      <text class="sticky-save-hint">● 有未保存修改</text>
      <button class="btn-sticky-save btn-press" disabled="{{configLoading || configSaving}}" loading="{{configSaving}}" bindtap="saveAllConfigs">立即保存设置</button>
    </view>
  </block>

  <!-- ==================== 弹窗 1: 新增/编辑菜品 ==================== -->
  <view class="modal-backdrop" wx:if="{{showAddModal}}">
    <view class="modal-box">
      <view class="modal-title-row">
        <text class="modal-title">{{isEditingDish ? '编辑老卤菜品' : '上架新卤味'}}</text>
        <view class="modal-close" bindtap="closeAddModal">✕</view>
      </view>

      <view class="modal-form">
        <view class="form-row">
          <text class="form-label">菜品名称</text>
          <input class="form-input" placeholder="如：老卤虎皮鸡爪 (6只)" value="{{dishForm.title}}" bindinput="onInputFormTitle" />
        </view>
        <view class="form-row">
          <text class="form-label">原价 (元)</text>
          <input type="digit" class="form-input" placeholder="如：25.00" value="{{dishForm.origin_price}}" bindinput="onInputFormOriginPrice" />
        </view>
        <view class="form-row">
          <text class="form-label">会员专享价 (元)</text>
          <input type="digit" class="form-input" placeholder="填写该菜品会员价" value="{{dishForm.member_price}}" bindinput="onInputFormMemberPrice" />
        </view>
        <view class="form-row">
          <text class="form-label">分类</text>
          <picker range="{{categoryNames}}" value="{{dishForm.category_id - 1}}" bindchange="onDishCategory">
            <view class="form-picker-box">{{categoryNames[dishForm.category_id - 1] || '请选择分类'}} ▾</view>
          </picker>
        </view>
        <view class="form-row photo-editor">
          <text class="form-label">商品实拍图</text>
          <image wx:if="{{photoPreview || dishForm.cover_img}}" class="dish-photo-preview" src="{{photoPreview || dishForm.cover_img}}" mode="aspectFill" />
          <view class="photo-btns-row">
            <button class="btn-wk-secondary btn-press" loading="{{photoBusy}}" disabled="{{photoBusy || dishSaving}}" bindtap="chooseDishPhoto">{{photoBusy ? '处理照片中' : '📷 拍照/相册选择'}}</button>
            <button wx:if="{{dishForm.cover_img && !photoPreview}}" class="btn-wk-danger-outline btn-press" disabled="{{photoBusy || dishSaving}}" bindtap="clearDishPhoto">移除封面</button>
          </view>
          <text class="photo-hint">上传后点击保存菜品，顾客才能看到新照片</text>
          <text wx:if="{{photoError}}" class="photo-error">{{photoError}}</text>
          <view class="photo-btns-row" wx:if="{{photoPreview && !photoBusy}}">
            <button class="btn-wk-primary btn-press" disabled="{{dishSaving}}" bindtap="uploadDishPhoto">重试上传</button>
            <button class="btn-wk-secondary btn-press" disabled="{{dishSaving}}" bindtap="discardDishPhoto">放弃新照片</button>
          </view>
          <view wx:if="{{!photoCloudCover}}" style="width:100%;">
            <text class="form-label">或填写已有图片HTTPS地址</text>
            <input class="form-input" disabled="{{photoBusy || dishSaving || photoPreview}}" value="{{dishForm.cover_img}}" data-field="cover_img" bindinput="onDishField" maxlength="500" />
          </view>
        </view>
        <view class="form-row"><text class="form-label">每批默认可售份数</text><input class="form-input" type="number" value="{{dishForm.stock_qty}}" data-field="stock_qty" bindinput="onDishField" /></view>
        <view class="form-row"><text class="form-label">规格净重/辣度</text><input class="form-input" value="{{dishForm.specification}}" data-field="specification" bindinput="onDishField" maxlength="100" /></view>
        <view class="form-row"><text class="form-label">保存食用说明/过敏原提示</text><input class="form-input" value="{{dishForm.storage_note}}" data-field="storage_note" bindinput="onDishField" maxlength="255" /></view>
        <view class="form-row">
          <text class="form-label">特色角标</text>
          <input class="form-input" placeholder="如：软烂入骨 / 胶质满满" value="{{dishForm.badge}}" bindinput="onInputFormBadge" />
        </view>
        <view class="form-row">
          <text class="form-label">风味简介</text>
          <input class="form-input" placeholder="如：先炸后卤，虎皮吸满浓郁老卤" value="{{dishForm.intro}}" bindinput="onInputFormIntro" />
        </view>
      </view>

      <view class="modal-btn-row">
        <button class="btn-cancel" disabled="{{dishSaving}}" bindtap="closeAddModal">取消</button>
        <button class="btn-submit" loading="{{dishSaving}}" disabled="{{dishSaving || photoBusy || photoPreview}}" bindtap="submitDishForm">{{isEditingDish ? '保存修改' : '立即发布上架'}}</button>
      </view>
    </view>
  </view>

  <!-- ==================== 弹窗 2: 快捷库存调整（含当前值预填与快捷加减） ==================== -->
  <view class="modal-backdrop" wx:if="{{showStockModal}}">
    <view class="modal-box">
      <view class="modal-title-row">
        <text class="modal-title">调整本批库存【{{stockTarget.title}}】</text>
        <view class="modal-close" bindtap="closeStockModal">✕</view>
      </view>
      <view class="modal-form">
        <view class="form-row">
          <text class="form-label">当前日期：{{orderDate}} · 批次 {{config.BATCH_SCHEDULE_TIME}}</text>
          <input type="number" class="form-input stock-num-input" value="{{stockInputVal}}" bindinput="onStockInput" />
        </view>
        <view class="quick-stock-btns">
          <view class="q-stock-btn btn-press" data-delta="-5" bindtap="quickAdjustStock">-5 份</view>
          <view class="q-stock-btn btn-press" data-delta="5" bindtap="quickAdjustStock">+5 份</view>
          <view class="q-stock-btn btn-press" data-delta="10" bindtap="quickAdjustStock">+10 份</view>
          <view class="q-stock-btn danger btn-press" data-delta="-9999" bindtap="quickAdjustStock">沽清(0)</view>
        </view>
      </view>
      <view class="modal-btn-row">
        <button class="btn-cancel" disabled="{{stockSaving}}" bindtap="closeStockModal">取消</button>
        <button class="btn-submit" loading="{{stockSaving}}" disabled="{{stockSaving}}" bindtap="saveStockModal">保存库存</button>
      </view>
    </view>
  </view>

  <!-- ==================== 弹窗 3: 人工调整积分/红包 ==================== -->
  <view class="modal-backdrop" wx:if="{{showPointsModal}}">
    <view class="modal-box">
      <view class="modal-title-row">
        <text class="modal-title">调整食客资产【{{currentMember.nickname}}】</text>
        <view class="modal-close" bindtap="closePointsModal">✕</view>
      </view>

      <view class="modal-form">
        <view class="form-row">
          <text class="form-label">调整资产账户</text>
          <view class="seg-type-row">
            <view class="seg-item {{pointsForm.adjust_type === 'NORMAL_POINT' ? 'active' : ''}}" bindtap="onSelectPointsType" data-type="NORMAL_POINT">
              普通积分 (当前: {{currentMember.normal_points}})
            </view>
            <view class="seg-item {{pointsForm.adjust_type === 'RED_PACKET' ? 'active' : ''}}" bindtap="onSelectPointsType" data-type="RED_PACKET">
              红包积分 (当前: ¥{{currentMember.red_packet_points}})
            </view>
          </view>
        </view>
        <view class="form-row">
          <text class="form-label">变动数值 (正数赠送，负数扣减{{pointsForm.adjust_type === 'NORMAL_POINT' ? '；普通积分须为整数' : ''}})</text>
          <input type="digit" class="form-input" placeholder="如: 50 或 -20" value="{{pointsForm.amount}}" bindinput="onInputPointsAmount" />
        </view>
        <view class="form-row">
          <text class="form-label">调整原因 (必填审计备注)</text>
          <input class="form-input" placeholder="如：老客生日礼遇 / 线下熟客手工录入" value="{{pointsForm.reason}}" bindinput="onInputPointsReason" />
        </view>
      </view>

      <view class="modal-btn-row">
        <button class="btn-cancel" bindtap="closePointsModal">取消</button>
        <button class="btn-submit" loading="{{pointsSubmitting}}" disabled="{{pointsSubmitting}}" bindtap="submitAdjustPoints">确认调整入账</button>
      </view>
    </view>
  </view>

  <!-- ==================== 弹窗 4: 调分历史审计流水 ==================== -->
  <view class="modal-backdrop" wx:if="{{showAdjustLogsModal}}">
    <view class="modal-box">
      <view class="modal-title-row">
        <text class="modal-title">调分审计流水【{{adjustLogsMemberName}}】</text>
        <view class="modal-close" bindtap="closeAdjustLogsModal">✕</view>
      </view>
      <scroll-view scroll-y class="logs-scroll-list">
        <view wx:if="{{adjustLogsLoading}}" class="support-note">正在加载审计记录…</view>
        <view wx:elif="{{!adjustLogs.length}}" class="empty-pending-box"><text class="empty-hint">暂无人工调分审计记录</text></view>
        <view class="adjust-log-row" wx:for="{{adjustLogs}}" wx:key="id">
          <view class="log-top-row">
            <text class="log-type-tag">{{item.account_type === 'NORMAL_POINT' ? '普通积分' : '红包积分'}}</text>
            <text class="log-amount {{item.amount >= 0 ? 'plus' : 'minus'}}">{{item.amount >= 0 ? '+' : ''}}{{item.amount}}</text>
          </view>
          <view class="log-reason">{{item.reason}}</view>
          <view class="log-meta">变动前 {{item.before_val}} → 变动后 {{item.after_val}} · {{item.create_time}}</view>
        </view>
      </scroll-view>
      <view class="modal-btn-row">
        <button class="btn-submit" bindtap="closeAdjustLogsModal">关闭</button>
      </view>
    </view>
  </view>

  <!-- ==================== 弹窗 5: 补录/修正推荐人 ==================== -->
  <view class="modal-backdrop" wx:if="{{showReferrerModal}}">
    <view class="modal-box">
      <view class="modal-title-row">
        <text class="modal-title">补录推荐人【{{currentMember.nickname}}】</text>
        <view class="modal-close" bindtap="closeReferrerModal">✕</view>
      </view>

      <view class="modal-form">
        <view class="form-row">
          <text class="form-label">推荐人邀请码 (如 PXD-8802)</text>
          <input class="form-input" placeholder="请输入上级老客的专属邀请码" value="{{referrerForm.invite_code}}" bindinput="onInputReferrerCode" />
        </view>
      </view>

      <view class="modal-btn-row">
        <button class="btn-cancel" bindtap="closeReferrerModal">取消</button>
        <button class="btn-submit" bindtap="submitBindReferrer">确认绑定并关联</button>
      </view>
    </view>
  </view>

</view>
