/* 订单页：状态、预约、金额、操作分区 */
.container { background: #F6F4F0; }
.container { padding: 28rpx 28rpx calc(60rpx + env(safe-area-inset-bottom)); min-height: 100vh; }
.page-heading { padding: 12rpx 2rpx 28rpx; }
.page-title { font-size: 42rpx; font-weight: 600; color: #352E27; }
.page-caption { font-size: 24rpx; color: #9A8775; margin-top: 10rpx; }
.order-filters { display: flex; gap: 8rpx; padding: 8rpx; background: #EDE9E2; border-radius: 16rpx; margin-bottom: 26rpx; }
.filter-pill { flex: 1; min-width: 0; text-align: center; padding: 18rpx 4rpx; font-size: 24rpx; line-height: 1.5; color: #8E7B69; border-radius: 12rpx; white-space: nowrap; }
.filter-pill.selected { background: #fff; color: #A74927; font-weight: 600; box-shadow: 0 2rpx 6rpx rgba(65,46,26,.04); }
.active-order-card { background: #fff; padding: 28rpx; border: 1rpx solid #EAE5DF; border-radius: 24rpx; margin-bottom: 24rpx; }
.order-status-header { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; padding-bottom: 22rpx; border-bottom: 1rpx solid #F0EBE4; }
.status-main-title { font-size: 32rpx; font-weight: 600; color: #A44928; }
.status-badge-pill { flex-shrink: 0; font-size: 22rpx; color: #8D7A64; background: #F5F1EB; border-radius: 8rpx; padding: 8rpx 14rpx; }
.order-overview { padding: 24rpx 0 18rpx; font-size: 25rpx; line-height: 1.8; color: #786858; overflow-wrap: anywhere; }
.order-sn { font-size: 21rpx; color: #AD9D8D; line-height: 1.7; }
.order-summary { font-size: 28rpx; font-weight: 500; color: #3F342A; line-height: 1.7; margin: 14rpx 0; }
.order-batch { background: #F8F5EF; padding: 16rpx 20rpx; border-radius: 10rpx; font-size: 24rpx; color: #9C7755; }
.order-total-row { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; flex-wrap: wrap; margin-top: 24rpx; }
.order-total-label { font-size: 24rpx; color: #9B8876; }
.order-total { font-size: 34rpx; font-weight: 650; color: #4C3828; }
.details-link { font-size: 23rpx; color: #9B7453; }
.cooking-hint-box { background: #FBF3E5; border-radius: 12rpx; color: #9C774F; font-size: 23rpx; line-height: 1.8; padding: 20rpx; margin: 16rpx 0; overflow-wrap: anywhere; }
.pickup-hero-box { text-align: center; padding: 28rpx 20rpx; margin: 18rpx 0; background: #FAF7F0; border-radius: 16rpx; border: 1rpx dashed #DCC6A7; }
.pickup-code-label { font-size: 23rpx; color: #9B8268; }
.pickup-big-code { font-size: 64rpx; font-weight: 650; color: #A34D2C; letter-spacing: 12rpx; padding: 14rpx 0; overflow-wrap: anywhere; }
.pickup-addr-info { font-size: 25rpx; color: #6F5945; line-height: 1.8; }
.addr-sub { font-size: 22rpx; color: #A28E77; margin-top: 12rpx; }
.dish-item-row { display: flex; align-items: baseline; gap: 14rpx; font-size: 25rpx; line-height: 1.7; padding: 16rpx 0; }
.item-name { min-width: 0; flex: 1; color: #5D4C3D; }
.item-qty { flex-shrink: 0; color: #A18F7E; }
.bill-row { display: flex; justify-content: space-between; font-size: 24rpx; line-height: 1.7; padding: 10rpx 0; color: #95816E; }
.bill-row.red { color: #A95432; }
.order-actions { display: flex; justify-content: flex-end; flex-wrap: wrap; gap: 14rpx; padding-top: 20rpx; }
.order-actions .order-action { margin: 0; font-size: 24rpx; line-height: 1.7; padding: 16rpx 22rpx; background: #F6F2EC; color: #917D69; border-radius: 12rpx; }
.order-actions .order-action.primary { color: #fff; background: #AB4B28; }
.order-action::after { border: 0; }
.order-service-row { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; padding-top: 22rpx; margin-top: 22rpx; border-top: 1rpx solid #F0EBE4; }
.order-contact { font-size: 22rpx; color: #A18A75; line-height: 1.7; }
.empty-order-card { text-align: center; background: #fff; border: 1rpx solid #EAE5DF; border-radius: 24rpx; padding: 70rpx 28rpx; }
.empty-order-symbol { margin: 0 auto 28rpx; width: 120rpx; height: 120rpx; line-height: 120rpx; border-radius: 32rpx; font-family: serif; font-size: 60rpx; color: #B29674; background: #F5EFE5; }
.empty-title { font-size: 32rpx; font-weight: 500; color: #67523F; }
.empty-desc { font-size: 24rpx; color: #A28F7E; line-height: 1.8; margin: 20rpx 0 30rpx; text-align: center; }
.btn-go-menu { background: #AE4B28; color: #fff; border-radius: 14rpx; font-size: 26rpx; line-height: 1.7; padding: 18rpx 32rpx; margin-top: 32rpx; width: 65%; }
.btn-go-menu::after { border: 0; }

.order-overview .copy-order-address { font-size: 23rpx; line-height: 1.6; padding: 12rpx 18rpx; margin: 12rpx 0; background: #F6F2EC; color: #8A6D51; border-radius: 10rpx; }
.copy-order-address::after { border: 0; }
