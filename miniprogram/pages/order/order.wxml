<view class="container">
 <dev-banner />
 <view class="page-heading"><view class="page-title">我的订单</view><view class="page-caption">预约、备餐与取餐进度</view></view>
 <view class="order-filters"><view wx:for="{{filters}}" wx:key="value" class="filter-pill {{status === item.value ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="filterOrders">{{item.label}}</view></view>
 <view wx:if="{{refreshAvailable}}" class="cooking-hint-box" bindtap="retryOrders">订单状态有更新，点击刷新列表</view>
 <view wx:if="{{error}}" class="cooking-hint-box" bindtap="retryOrders">{{error}} · 点击重试</view>
 <view wx:if="{{!orders.length && !loading && !error}}" class="empty-order-card"><view class="empty-order-symbol">卤</view><view class="empty-title">还没有这类订单</view><view class="empty-desc">挑几份喜欢的老卤，预约下一锅新鲜</view><button class="btn-go-menu" bindtap="navToMenu">挑选卤味</button></view>
 <view wx:for="{{orders}}" wx:key="id" class="active-order-card">
  <view class="order-status-header" data-id="{{item.id}}" bindtap="expand"><text class="status-main-title">{{item.status_title}}</text><text class="status-badge-pill">{{item.delivery_type === 1 ? '作坊自送' : '到店自提'}}</text></view>
  <view class="order-overview" data-id="{{item.id}}" bindtap="expand">
   <view class="order-sn">{{item.order_sn}}</view><view class="order-summary">{{item.summary_text}}</view><view class="order-batch">预约出炉 · {{item.expect_time_slot}}</view>
   <view class="order-total-row"><view><text class="order-total-label">订单应付 </text><text class="order-total">¥{{item.final_pay_amount}}</text></view><text class="details-link">{{expandedId === item.id ? '收起明细 ▴' : '查看明细 ▾'}}</text></view>
  </view>
  <view wx:if="{{item.legacy}}" class="cooking-hint-box">历史订单付款记录待掌柜核对，请联系掌柜处理</view>
  <view wx:if="{{item.delivery_type === 2 && item.payment_state === 'PAID' && item.order_status !== 40}}" class="pickup-hero-box"><view class="pickup-code-label">到店向掌柜出示自提码</view><view class="pickup-big-code">{{item.pickup_code}}</view><view class="pickup-addr-info">{{item.receiver_address}}</view><view class="addr-sub">{{item.order_status === 25 ? '已备好，可以取餐' : '请等待备餐完成'}}</view></view>
  <view wx:if="{{item.order_status === 10 && !item.legacy}}" class="cooking-hint-box"><view wx:if="{{paymentTimers[item.id] && !paymentTimers[item.id].expired}}">付款剩余约 {{paymentTimers[item.id].remaining}}</view><view wx:if="{{paymentTimers[item.id] && paymentTimers[item.id].expired}}">付款时限已到，等待服务端核对关单。若已付款，请查询支付结果，勿重复下单。</view><view wx:else>付款截止 {{item.expires_at}}（北京时间）。超时关单后返还已占用积分，以刷新后的订单结果为准。</view></view>
  <view wx:if="{{item.order_status === 70}}" class="cooking-hint-box">微信退款处理中，资金及积分以渠道确认结果为准。{{item.refund_error}}</view>
  <view wx:if="{{item.refund_reason}}" class="cooking-hint-box">售后退款原因：{{item.refund_reason}}</view>
  <view wx:if="{{expandedId === item.id}}">
   <view class="order-overview"><view>联系人：{{item.receiver_name}} {{item.receiver_phone}}</view><view>{{item.receiver_address}}</view><button wx:if="{{item.delivery_type === 2}}" size="mini" class="copy-order-address" data-id="{{item.id}}" bindtap="copyPickupAddress">复制此订单取餐地址</button><view wx:if="{{item.order_remark}}">备注：{{item.order_remark}}</view><view>下单：{{item.create_time_formatted}}</view></view>
   <view wx:for="{{item.items}}" wx:for-item="dish" wx:key="id" class="dish-item-row"><text class="item-name">{{dish.product_title}}</text><text class="item-qty">×{{dish.quantity}}</text><text>¥{{dish.subtotal}}</text></view>
   <view class="bill-row"><text>商品原价</text><text>¥{{item.goods_origin_total}}</text></view>
   <view class="bill-row red"><text>会员优惠</text><text>-¥{{item.member_discount}}</text></view>
   <view class="bill-row"><text>普通积分抵扣</text><text>-¥{{item.normal_deduct}}</text></view>
   <view class="bill-row"><text>红包抵扣</text><text>-¥{{item.red_deduct}}</text></view>
   <view class="bill-row"><text>配送费</text><text>¥{{item.delivery_fee}}</text></view>
  </view>
  <view class="order-actions" wx:if="{{!item.legacy}}">
   <button class="order-action primary" wx:if="{{item.order_status === 10}}" size="mini" data-id="{{item.id}}" bindtap="pay" disabled="{{!!busyId || (paymentTimers[item.id] && paymentTimers[item.id].expired)}}" loading="{{busyId === item.id}}">继续付款</button>
   <button class="order-action" wx:if="{{item.order_status === 10}}" size="mini" data-id="{{item.id}}" bindtap="queryPayment" disabled="{{!!busyId}}">查询支付结果</button>
   <button class="order-action" wx:if="{{item.order_status === 10 || item.order_status === 20}}" size="mini" data-id="{{item.id}}" bindtap="cancel" disabled="{{!!busyId}}">{{item.order_status === 10 ? '取消订单' : '取消并退款'}}</button>
   <button class="order-action primary" wx:if="{{item.order_status === 30}}" size="mini" data-id="{{item.id}}" bindtap="confirm" disabled="{{!!busyId}}">确认收货</button>
   <button class="order-action primary" wx:if="{{item.order_status === 40}}" size="mini" data-id="{{item.id}}" bindtap="reorder">再来一单</button>
  </view>
  <view class="order-service-row"><view class="order-contact" bindtap="support" data-id="{{item.id}}">订单问题 / 查看售后进度 ›</view>
  <view class="order-contact" bindtap="contact">联系掌柜</view></view>
 </view>
 <view wx:if="{{loading}}" class="empty-desc">正在加载订单…</view><view wx:elif="{{nextCursor}}" class="empty-desc">上拉加载更多订单</view>
</view>
