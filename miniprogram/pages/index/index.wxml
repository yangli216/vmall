<page-meta page-style="{{(isDrawerOpen || showAddressPicker || showContactModal) ? 'overflow: hidden; height: 100vh;' : ''}}"></page-meta>
<!-- miniprogram/pages/index/index.wxml -->
<view class="container">
 <dev-banner />

  <!-- 1. 头部一体化卡片 -->
  <view class="header-unified-card">
    <view class="header-top-line">
      <view class="shop-name-block">
        <view class="shop-title">潘小兜 · 手工老卤</view>
        <view class="shop-sub">临安临天八弄 · 一锅老卤，按批现做</view>
      </view>
      <!-- 配送方式切换 -->
      <view class="segmented-control">
        <view class="segment-btn {{deliveryType === 1 ? 'active' : ''}}" bindtap="changeDelType" data-type="1">作坊自送</view>
        <view class="segment-btn {{deliveryType === 2 ? 'active' : ''}}" bindtap="changeDelType" data-type="2">到店自提</view>
      </view>
    </view>

    <view wx:if="{{config.WORKSHOP_ANNOUNCEMENT}}" class="shop-announcement">{{config.WORKSHOP_ANNOUNCEMENT}}</view>
    <!-- 出炉预约条 (动态判断下午/次日批次) -->
    <view class="header-schedule-box">
      <view class="schedule-left">
        <view class="pulse-orange-dot"></view>
        <picker disabled="{{submitting}}" range="{{slots}}" range-key="label" value="{{slotIndex}}" bindchange="changeSlot"><text>{{currentBatchText}} ▾</text></picker>
      </view>
      <text class="schedule-link">预约批次</text>
    </view>

    <!-- 配送/自提地址与收件人联系条 (垂直分层结构，绝不拥挤截断) -->
    <view wx:if="{{fullBatchText}}" class="shop-announcement">{{fullBatchText}} 已接满，请选择其他可预约批次；下拉刷新可查看最新名额。</view>
    <view class="address-strip">
      <view class="address-loc-group">
        <view class="address-line-primary">
          <text class="loc-icon-circle">📍</text>
          <text class="address-bold">{{deliveryType === 1 ? (destAddress || '请填写收货地址') : config.WORKSHOP_ADDRESS}}</text>
        </view>
        <view class="address-line-secondary" wx:if="{{deliveryType === 1}}">
          <text class="contact-label">收件人：</text>
          <text class="contact-value">{{receiverName}} ({{receiverPhone}})</text>
        </view>
        <view class="address-line-secondary" wx:else>
          <text class="contact-label" bindtap="copyShopAddress">复制地址 ›</text>
          <text class="contact-value">等待备好后，出示订单自提码</text>
        </view>
      </view>
      <view wx:if="{{deliveryType === 1}}" class="address-edit-btn" bindtap="openAddressPicker">选择地址</view>
    </view>
  </view>

  <!-- 2. 香槟金尊享会员卡通栏 (集成实时积分与红包外显) -->
  <view class="champagne-vip-bar btn-press" bindtap="navToMember">
    <view class="vip-left-pack">
      <view class="vip-star-gold">👑</view>
      <view class="vip-text-pack">
        <view class="vip-title-row">
          <text class="vip-title">{{isMember ? '正在享受菜品会员价' : '潘小兜会员 · 菜品专享价'}}</text>
          <view class="vip-asset-chips" wx:if="{{isMember}}">
            <text class="vip-chip-item gold">🪙 {{userNormalPoints || 0}}分</text>
            <text class="vip-chip-item red">🧧 ¥{{userRedPoints || '0.00'}}</text>
          </view>
        </view>
        <view class="vip-desc">{{isMember ? '积分可抵扣现金，推荐好友下单享现金返利' : (config.MEMBER_ENTRY_MODE === 'FREE' ? '当前可免费开通会员，即享会员价与下单送积分' : '入会规则请前往会员中心查看')}}</view>
      </view>
    </view>
    <view class="vip-enter-pill">{{isMember ? '明细 >' : '去查看 >'}}</view>
  </view>

  <!-- 3. 现代化匠心品类导航栏 (独立矢量图标 + 规范胶囊按钮与文字比例) -->
  <scroll-view scroll-x class="modern-category-row" enable-flex enhanced show-scrollbar="{{false}}">
    <view
      wx:for="{{categories}}"
      wx:key="id"
      class="cat-capsule {{currentCatId === item.id ? 'active' : ''}}"
      bindtap="selectCategory"
      data-id="{{item.id}}"
    >
      <image
        wx:if="{{item.iconNormal}}"
        class="cat-icon-img"
        src="{{currentCatId === item.id ? item.iconActive : item.iconNormal}}"
        mode="aspectFit"
      ></image>
      <text class="cat-name">{{item.name}}</text>
    </view>
  </scroll-view>

  <!-- 4. 卤味商品列表 (支持动态上下架、售罄遮罩与加减步进器) -->
  <view class="menu-feed">
    <view wx:if="{{loadingProducts}}" class="empty-dish-box">正在加载本批菜品…</view>
    <view wx:if="{{productError}}" class="empty-dish-box" bindtap="refresh">{{productError}} · 点此重试</view>
    <view wx:if="{{dishes.length === 0 && !loadingProducts && !productError}}" class="empty-dish-box">
      <view class="empty-icon">🍲</view>
      <view class="empty-text">当前分类下暂无在售菜品</view>
    </view>

    <view wx:for="{{dishes}}" wx:key="id" class="dish-item-card {{item.status === 0 || item.stock_qty <= 0 ? 'sold-out' : ''}}">
      <view class="dish-img-box">
        <image wx:if="{{item.cover_img}}" src="{{item.cover_img}}" class="dish-real-img" mode="aspectFill" binderror="onImageError" data-index="{{index}}"></image>
        <view wx:else class="dish-photo-placeholder"><text>卤</text><text class="placeholder-caption">手工慢卤</text></view>
        <view wx:if="{{item.badge}}" class="dish-floating-badge">{{item.badge}}</view>
        <view wx:if="{{item.status === 0 || item.stock_qty <= 0}}" class="dish-soldout-overlay">本批已售罄</view>
      </view>
      <view class="dish-content-box">
        <view>
          <view class="dish-name-h3" bindtap="showDishDetail" data-dish="{{item}}">{{item.title}} ›</view>
          <view class="dish-intro-p">{{item.intro}}</view>
          <view class="dish-tag-row">
            <text class="tag-vip-disc">{{isMember ? '会员价' : '会员 ¥' + item.member_price}}</text>
            <text class="tag-points-tip">本批剩余 {{item.stock_qty}} 份</text>
          </view>
        </view>
        <view class="dish-bottom-action">
          <view class="dish-price-group">
            <text class="price-symbol">¥</text>
            <text class="dish-price-text">{{isMember ? item.member_price : item.origin_price}}</text>
            <text class="dish-origin-text" wx:if="{{isMember}}">¥{{item.origin_price}}</text>
          </view>

          <!-- 状态判定与加减步进器 -->
          <view wx:if="{{item.status === 0 || item.stock_qty <= 0}}" class="sold-out-text">本批售罄</view>
          <!-- 步进器 (精细化控制) -->
          <view wx:elif="{{cart[item.id] && cart[item.id].quantity > 0}}" class="cart-stepper-row">
            <view class="btn-stepper minus btn-press" catchtap="decreaseCart" data-dish="{{item}}">-</view>
            <text class="stepper-count">{{cart[item.id].quantity}}</text>
            <view class="btn-stepper plus btn-press" catchtap="addToCart" data-dish="{{item}}">+</view>
          </view>
          <view wx:else class="btn-circle-add btn-press" catchtap="addToCart" data-dish="{{item}}">+</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 5. 官方资质备案说明 -->
  <view class="official-license-footer">
    <view>实体经营者：杭州临安潘小兜食品小作坊</view>
    <view>许可证编号：JY13301850326102 (含网络经营)</view>
    <view>工坊基地：{{config.WORKSHOP_ADDRESS}}</view>
  </view>

  <!-- 6. 悬浮现代毛玻璃购物车 Dock -->
  <view class="airy-cart-dock" wx:if="{{cartCount > 0}}">
    <view class="cart-summary-text" bindtap="openCheckoutSheet">
      <view class="dock-badge-dot">{{cartCount}}</view>
      <text class="cart-label">预估合计:</text>
      <text class="cart-total-num">¥{{cartTotal}}</text>
    </view>
    <view class="btn-dock-confirm btn-press" bindtap="openCheckoutSheet">
      确认订单 →
    </view>
  </view>

  <!-- 7. 结算明细半屏抽屉 (BottomSheet，与背景遮罩为同级结构，彻底阻断背景滚动穿透) -->
  <view class="drawer-backdrop {{isDrawerOpen ? 'open' : ''}}" catchtouchmove="preventTouchMove" bindtap="closeCheckoutSheet"></view>
  <view class="drawer-content-sheet {{isDrawerOpen ? 'open' : ''}}">
    <!-- 1. 顶栏 (固定吸顶) -->
    <view class="drawer-bar-title">
      <text class="drawer-h2">确认这一份好卤</text>
      <view class="drawer-close" bindtap="closeCheckoutSheet">✕</view>
    </view>

    <!-- 2. 中间可滚动区域 (聚焦核心信息，设置明确高度保证纵向滚动顺畅) -->
    <scroll-view scroll-y="true" class="drawer-body-scroll" enhanced="{{true}}" bounces="{{true}}" show-scrollbar="{{false}}">
      <!-- 顶置醒目履约方式大 Tab：作坊自送 / 到店自提 (全宽双分栏胶囊，一眼看清，支持随时切换) -->
      <view class="checkout-delivery-tabs">
        <view class="delivery-tab-btn {{deliveryType === 1 ? 'active' : ''}}" catchtap="changeDrawerDelType" data-type="1">
          <text class="tab-emoji">🛵</text>
          <text class="tab-main-text">作坊自送</text>
          <text class="tab-sub-tip">送货上门</text>
        </view>
        <view class="delivery-tab-btn {{deliveryType === 2 ? 'active' : ''}}" catchtap="changeDrawerDelType" data-type="2">
          <text class="tab-emoji">🏪</text>
          <text class="tab-main-text">到店自提</text>
          <text class="tab-sub-tip">免运费</text>
        </view>
      </view>

      <!-- 履约与配送信息卡片 -->
      <view class="drawer-fulfillment-card">
        <!-- 头部行：标签与针对当前模式的修改按钮 -->
        <view class="fulfillment-card-head">
          <view class="head-title-tag">
            <text class="head-icon">{{deliveryType === 1 ? '📍' : '🏪'}}</text>
            <text class="head-label">{{deliveryType === 1 ? '配送信息（送货上门）' : '自提信息（到店取餐）'}}</text>
            <text class="head-badge" wx:if="{{deliveryType === 1 && deliveryArea}}">{{deliveryArea}}</text>
          </view>
          <view class="head-action" catchtap="openDeliveryModal">
            <text class="action-btn-text">{{deliveryType === 1 ? '修改地址 ›' : '修改提货人 ›'}}</text>
          </view>
        </view>

        <!-- 内容整体：地址 + 联系人统一展示 (点击唤起修改) -->
        <view class="fulfillment-card-body" bindtap="openDeliveryModal">
          <!-- 模式 1：周边自送 -->
          <block wx:if="{{deliveryType === 1}}">
            <view class="card-address-line" wx:if="{{destAddress}}">
              <text class="addr-text">{{destAddress}}</text>
            </view>
            <view class="card-contact-line" wx:if="{{receiverName || receiverPhone}}">
              <text class="contact-name">{{receiverName || '未填收件人'}}</text>
              <text class="contact-phone">{{receiverPhone || '未填手机号'}}</text>
            </view>
            <view class="card-empty-line" wx:if="{{!destAddress && !receiverName}}">
              <text class="empty-hint">📍 暂未设置配送地址，点击添加 ›</text>
            </view>
          </block>

          <!-- 模式 2：到店自提 -->
          <block wx:else>
            <view class="card-address-line">
              <text class="addr-text">{{config.WORKSHOP_ADDRESS || '门店自提地址'}}</text>
              <text class="btn-copy-tag" catchtap="copyShopAddress">复制</text>
            </view>
            <view class="card-contact-line">
              <text class="contact-label">提货联络：</text>
              <text class="contact-name">{{receiverName || '自提顾客'}}</text>
              <text class="contact-phone">{{receiverPhone || '请填写提货手机号'}}</text>
            </view>
          </block>
        </view>

        <!-- 预约出炉时段轻量栏 -->
        <view class="compact-schedule-strip">
          <text class="strip-label">预约出炉批次：</text>
          <text class="strip-val">{{currentBatchText}}</text>
        </view>
      </view>

        <!-- 已选老卤清单明细 (支持增减与清空) -->
        <view class="drawer-cart-list">
          <view class="drawer-cart-title-row">
            <text class="cart-list-title">已选老卤清单 ({{cartCount}}份)</text>
            <text class="cart-list-clear" bindtap="clearCart">清空</text>
          </view>
          <view class="drawer-cart-items">
            <view wx:for="{{cartList}}" wx:key="id" class="drawer-cart-item">
              <view class="item-meta">
                <text class="item-name">{{item.dish.title}}</text>
                <view class="item-price-row">
                  <text class="item-unit-price">¥{{isMember ? item.dish.member_price : item.dish.origin_price}}</text>
                  <!-- 会员专享：划线原价 + 会员标，与下方账单的原价与会员立减完美呼应 -->
                  <text class="item-origin-price" wx:if="{{isMember && item.dish.member_price !== item.dish.origin_price}}">¥{{item.dish.origin_price}}</text>
                  <text class="item-vip-badge" wx:if="{{isMember && item.dish.member_price !== item.dish.origin_price}}">会员价</text>
                  <!-- 非会员：引导会员价 -->
                  <text class="item-nonmember-tip" wx:if="{{!isMember && item.dish.member_price !== item.dish.origin_price}}">会员¥{{item.dish.member_price}}</text>
                </view>
              </view>
              <view class="cart-stepper-row in-drawer">
                <view class="btn-stepper minus btn-press" catchtap="decreaseCart" data-dish="{{item.dish}}">-</view>
                <text class="stepper-count">{{item.quantity}}</text>
                <view class="btn-stepper plus btn-press" catchtap="addToCart" data-dish="{{item.dish}}">+</view>
              </view>
            </view>
          </view>
        </view>

        <!-- 口味备注输入 -->
        <view class="remark-input-box">
          <input disabled="{{submitting}}" class="remark-input" placeholder="口味备注 (如：微辣/多带点卤汁/切薄片)" maxlength="255" bindinput="onRemarkInput" value="{{orderRemark}}" />
        </view>

        <!-- 双积分抵扣设置卡片 (极简紧凑单行模式，节省垂向空间) -->
        <view class="deduct-compact-card">
          <!-- 普通积分单行 -->
          <view class="deduct-compact-row">
            <view class="deduct-compact-left">
              <text class="deduct-icon">🪙</text>
              <text class="deduct-compact-title">积分抵扣</text>
              <text class="deduct-compact-sub">可用 {{userNormalPoints}} 分</text>
              <text class="deduct-saved-tag" wx:if="{{useNormalPoints && calcResult.normal_deduct > 0}}">-¥{{calcResult.normal_deduct}}</text>
              <text class="deduct-rule-tag" wx:else>满100抵¥5</text>
            </view>
            <view class="deduct-compact-right">
              <switch class="compact-switch" disabled="{{submitting}}" checked="{{useNormalPoints}}" color="#D9480F" bindchange="toggleNormalPoints" />
            </view>
          </view>

          <!-- 推荐红包抵扣单行 -->
          <view class="deduct-compact-row border-top">
            <view class="deduct-compact-left">
              <text class="deduct-icon">🧧</text>
              <text class="deduct-compact-title red">推荐红包</text>
              <text class="deduct-compact-sub red">余额 ¥{{userRedPoints}}</text>
              <text class="deduct-rule-tag red" wx:if="{{!useRedPoints}}">最高抵{{redLimitPercent}}%</text>
            </view>
            <view class="deduct-compact-right">
              <!-- 开启红包抵扣时展示极简行内微型金额输入 -->
              <view class="red-compact-pill" wx:if="{{useRedPoints}}">
                <text class="pill-prefix">-¥</text>
                <input disabled="{{submitting || !isMember}}" type="digit" class="red-compact-input" value="{{inputRedAmount}}" bindinput="onRedAmountChange" />
              </view>
              <switch class="compact-switch" disabled="{{submitting || !isMember}}" checked="{{useRedPoints}}" color="#D9480F" bindchange="toggleRedPoints" />
            </view>
          </view>
        </view>

        <!-- 金额明细列表 (紧凑直观明细) -->
        <view class="bill-summary-list">
          <view class="bill-row">
            <text class="bill-row-label">{{calcResult.member_discount > 0 ? '商品原价' : '商品金额'}}</text>
            <text class="bill-row-val">¥{{calcResult.goods_origin_total || '0.00'}}</text>
          </view>
          <view class="bill-row red" wx:if="{{calcResult.member_discount > 0}}">
            <text class="bill-row-label">会员立减</text>
            <text class="bill-row-val">-¥{{calcResult.member_discount}}</text>
          </view>
          <view class="bill-row orange" wx:if="{{useNormalPoints && calcResult.normal_deduct > 0}}">
            <text class="bill-row-label">积分满减</text>
            <text class="bill-row-val">-¥{{calcResult.normal_deduct}}</text>
          </view>
          <view class="bill-row red bold" wx:if="{{useRedPoints && calcResult.red_deduct > 0}}">
            <text class="bill-row-label">红包冲抵</text>
            <text class="bill-row-val">-¥{{calcResult.red_deduct}}</text>
          </view>
          <view class="bill-row">
            <text class="bill-row-label">{{deliveryType === 1 ? '配送费用' : '取货方式'}}</text>
            <text class="bill-row-val {{calcResult.delivery_fee > 0 ? '' : 'free'}}">{{deliveryType === 1 ? (calcResult.delivery_fee > 0 ? '+¥' + calcResult.delivery_fee : '免运费') : '门店自提 (免运费)'}}</text>
          </view>
        </view>

        <view class="checkout-rule-link" bindtap="showRules">预约/配送/退款规则说明 ›</view>
      </scroll-view>

      <!-- 3. 底部结算确认条 (吸底常驻，无需滚动即可确认支付！) -->
      <view class="drawer-footer-bar">
        <view class="footer-left">
          <view class="footer-final-price-box">
            <text class="footer-label">本单实付</text>
            <text class="footer-price-num">¥{{calcResult.final_pay_amount || '0.00'}}</text>
          </view>
          <view class="footer-discount-hint" wx:if="{{calcResult.member_discount > 0 || calcResult.normal_deduct > 0 || calcResult.red_deduct > 0}}">
            <text class="hint-saved-tag" wx:if="{{calcResult.member_discount > 0}}">已省¥{{calcResult.member_discount}}</text>
            <text class="hint-desc">已享会员/抵扣特惠</text>
          </view>
        </view>
        <view class="footer-right">
          <view class="checkout-error" wx:if="{{calcError}}" bindtap="calculateBill">{{calcError}} · 重试</view>
          <button class="btn-wxpay-submit btn-press" disabled="{{!calcReady || submitting}}" loading="{{calculating || submitting}}" bindtap="submitOrderPay">
            {{calculating ? '正在核算' : '确认订单并支付'}}
          </button>
        </view>
      </view>
    </view>

  <!-- 统一修改与选择配送地址弹窗 (精致卡片化重构) -->
  <view class="poster-backdrop" wx:if="{{showDeliveryModal || showAddressPicker}}" catchtouchmove="preventTouchMove" bindtap="closeDeliveryModal">
    <view class="delivery-modal-dialog" catchtap="stopBubble">
      <view class="modal-head">
        <text class="modal-title">选择配送地址</text>
        <view class="modal-close" bindtap="closeDeliveryModal">✕</view>
      </view>

      <!-- 快捷操作区：微信导入 / 地图定位 / 手动新增 -->
      <view class="delivery-modal-actions">
        <view class="btn-modal-action wx-import btn-press" bindtap="importAddressFromWechat">
          <text class="btn-icon">📥</text>
          <text class="btn-text">微信导入</text>
        </view>
        <view class="btn-modal-action location-btn btn-press" bindtap="chooseLocationForDelivery">
          <text class="btn-icon">📍</text>
          <text class="btn-text">地图定位</text>
        </view>
        <view class="btn-modal-action manual-edit btn-press" bindtap="toggleDeliveryEditForm">
          <text class="btn-icon">{{showManualEdit ? '📋' : '✏️'}}</text>
          <text class="btn-text">{{showManualEdit ? '已有地址' : '手动新增'}}</text>
        </view>
      </view>

      <!-- 模式 A：直接表单新增/编辑 -->
      <view class="delivery-edit-form" wx:if="{{showManualEdit}}">
        <view class="form-item">
          <text class="form-label">收件人姓名</text>
          <input class="form-input" placeholder="请填写收件人姓名" value="{{editReceiverName}}" bindinput="onEditNameInput" maxlength="20" />
        </view>
        <view class="form-item">
          <text class="form-label">联系电话</text>
          <input class="form-input" type="number" placeholder="请填写11位手机号" value="{{editReceiverPhone}}" bindinput="onEditPhoneInput" maxlength="11" />
        </view>
        <view class="form-item" wx:if="{{deliveryAreas.length > 0}}">
          <text class="form-label">配送小区</text>
          <picker range="{{deliveryAreas}}" value="{{editAreaIndex}}" bindchange="onEditAreaChange">
            <view class="form-picker-val">{{editDeliveryArea || '请选择配送小区 ▾'}}</view>
          </picker>
        </view>
        <view class="form-item">
          <view class="form-label-row">
            <text class="form-label">详细地址</text>
            <text class="form-label-action" bindtap="chooseLocationForDelivery">📍 地图定位</text>
          </view>
          <input class="form-input" placeholder="楼幢、门牌号（如：10幢202）" value="{{editDestAddress}}" bindinput="onEditAddressInput" maxlength="100" />
        </view>
        <button class="btn-save-delivery btn-press" bindtap="saveUnifiedDelivery">保存并使用此配送地址</button>
      </view>

      <!-- 模式 B：已有地址列表选择 (每一项均包含收件人、电话与详细门牌，点击整体切换) -->
      <scroll-view scroll-y="true" class="address-scroll-list" wx:else>
        <view wx:if="{{!addressList.length}}" class="address-empty-box">
          <text class="empty-icon">📍</text>
          <text class="empty-text">暂无已维护的配送地址</text>
          <text class="empty-sub">支持点击上方按钮从微信导入或手动添加</text>
        </view>
        <view class="address-card-item {{item.detail === destAddress && item.name === receiverName ? 'is-selected' : ''}}" 
              wx:for="{{addressList}}" 
              wx:key="id" 
              data-id="{{item.id}}" 
              bindtap="selectAddress">
          <view class="addr-item-main">
            <view class="addr-user-line">
              <text class="addr-user-name">{{item.name}}</text>
              <text class="addr-user-phone">{{item.phone}}</text>
              <text class="addr-badge-default" wx:if="{{item.is_default}}">默认</text>
              <text class="addr-badge-active" wx:if="{{item.detail === destAddress && item.name === receiverName}}">当前使用</text>
            </view>
            <view class="addr-detail-text">{{item.area ? item.area + ' ' : ''}}{{item.detail}}</view>
          </view>
          <view class="addr-card-right">
            <view class="select-check-circle {{item.detail === destAddress && item.name === receiverName ? 'checked' : ''}}">
              <text wx:if="{{item.detail === destAddress && item.name === receiverName}}">✓</text>
            </view>
          </view>
        </view>
      </scroll-view>

      <view class="nav-address-manager-row" bindtap="navToMemberAddress">
        <text class="nav-link-text">⚙️ 前往「会员中心」完整维护地址库 ›</text>
      </view>
    </view>
  </view>

  <!-- 快速修改自提联系方式弹窗 -->
  <view class="poster-backdrop" wx:if="{{showContactModal}}" catchtouchmove="preventTouchMove" bindtap="closeContactModal">
    <view class="contact-modal-dialog" catchtap="stopBubble">
      <view class="modal-head">
        <text class="modal-title">修改自提联络信息</text>
        <view class="modal-close" bindtap="closeContactModal">✕</view>
      </view>
      <view class="contact-modal-body">
        <view class="switch-to-delivery-hint btn-press" bindtap="switchToDeliveryAndManageAddress">
          <text class="hint-icon">🛵</text>
          <text class="hint-text">需要送货上门？点击切换为作坊自送 ›</text>
        </view>
        <view class="contact-input-field">
          <text class="contact-field-label">提货人姓名</text>
          <input class="contact-modal-input" placeholder="请填写姓名" maxlength="20" value="{{tempReceiverName}}" bindinput="onTempNameInput" />
        </view>
        <view class="contact-input-field">
          <text class="contact-field-label">提货手机号</text>
          <input class="contact-modal-input" type="number" placeholder="请填写11位手机号" maxlength="11" value="{{tempReceiverPhone}}" bindinput="onTempPhoneInput" />
        </view>
      </view>
      <view class="modal-foot">
        <button class="btn-contact-save btn-press" bindtap="saveContactModal">确认保存</button>
        <view class="nav-address-manager-row" bindtap="navToMemberAddress">
          <text class="nav-link-text">⚙️ 前往「会员中心」维护收货地址库 ›</text>
        </view>
      </view>
    </view>
  </view>

</view>
