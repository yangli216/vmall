  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #D5C7B7;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.select-check-circle.checked {
  background: #AA4624;
  border-color: #AA4624;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 800;
}

/* 手动表单模式 */
.delivery-edit-form {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.delivery-edit-form .form-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.delivery-edit-form .form-label {
  font-size: 23rpx;
  font-weight: 600;
  color: #5D4D40;
}

.delivery-edit-form .form-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.delivery-edit-form .form-label-action {
  font-size: 22rpx;
  color: #1D4ED8;
  font-weight: 600;
}

.delivery-edit-form .form-input {
  height: 76rpx;
  background: #FAF8F5;
  border: 1.5rpx solid #E5D9CC;
  border-radius: 14rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #2D251E;
  box-sizing: border-box;
}

.delivery-edit-form .form-picker-val {
  height: 76rpx;
  background: #FAF8F5;
  border: 1.5rpx solid #E5D9CC;
  border-radius: 14rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #2D251E;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.btn-save-delivery {
  width: 100% !important;
  background: #AA4624 !important;
  color: #FFFFFF !important;
  font-size: 28rpx !important;
  font-weight: 700;
  padding: 20rpx 0 !important;
  border-radius: 16rpx;
  border: none;
  margin-top: 10rpx !important;
  line-height: 1.4;
}


/* 通用高层级遮罩蒙层 (确保浮于抽屉之上的 1000 级) */
.poster-backdrop {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}

/* 快速修改自提联络信息弹窗 */
.contact-modal-dialog {
  width: 100%;
  max-width: 600rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  box-sizing: border-box;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.2);
}

.contact-modal-dialog .modal-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.contact-modal-dialog .modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2937;
}

.contact-modal-dialog .modal-close {
  font-size: 32rpx;
  color: #9CA3AF;
  padding: 8rpx;
  line-height: 1;
}

.contact-modal-body {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.contact-input-field {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.contact-field-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #4B5563;
}

.contact-modal-input {
  height: 80rpx;
  background: #F9FAFB;
  border: 1.5rpx solid #E5E7EB;
  border-radius: 14rpx;
  padding: 0 20rpx;
  font-size: 27rpx;
  color: #1F2937;
  box-sizing: border-box;
}

.modal-foot .btn-contact-save {
  width: 100% !important;
  background: #AA4624 !important;
  color: #FFFFFF !important;
  font-size: 28rpx !important;
  font-weight: 700;
  padding: 22rpx 0 !important;
  border-radius: 16rpx;
  border: none;
  line-height: 1.4;
}

.nav-address-manager-row {
  text-align: center;
  padding: 16rpx 0 6rpx;
}

.nav-link-text {
  font-size: 23rpx;
  color: #AA4624;
  font-weight: 600;
  text-decoration: underline;
}

.switch-to-delivery-hint {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #FFF7ED;
  border: 1rpx dashed #FDBA74;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
}

.switch-to-delivery-hint .hint-icon {
  font-size: 26rpx;
}

.switch-to-delivery-hint .hint-text {
  font-size: 22rpx;
  color: #C2410C;
  font-weight: 600;
}
