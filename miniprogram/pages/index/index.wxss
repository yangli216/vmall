.container {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 头部一体化卡片 */
.header-unified-card {
  background: #FFFFFF;
  padding: 30rpx 32rpx 26rpx;
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.03);
}

.header-top-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
}

.shop-name-block {
  flex: 1;
  min-width: 0;
}

.shop-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.25;
  letter-spacing: 0.5rpx;
}

.shop-sub {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.4;
}

/* 配送方式分段胶囊 */
.segmented-control {
  display: flex;
  background: #F1F3F5;
  padding: 6rpx;
  border-radius: 28rpx;
  flex-shrink: 0;
}

.segment-btn {
  padding: 10rpx 22rpx;
  border-radius: 22rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-sub);
  white-space: nowrap;
  transition: all 0.2s;
  line-height: 1.2;
}

.segment-btn.active {
  background: #FFFFFF;
  color: var(--text-main);
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

/* 出炉预约条 */
.header-schedule-box {
  background: #F8F9FA;
  border: 1rpx solid var(--border-soft);
  border-radius: 24rpx;
  padding: 16rpx 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  margin-top: 18rpx;
  gap: 16rpx;
}

.schedule-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--text-main);
  font-weight: 500;
  font-size: 24rpx;
  flex: 1;
  min-width: 0;
}

.schedule-left text {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.pulse-orange-dot {
  width: 14rpx;
  height: 14rpx;
  background: var(--brand-red);
  border-radius: 50%;
  box-shadow: 0 0 12rpx rgba(217, 72, 15, 0.6);
  flex-shrink: 0;
}

.highlight-time {
  color: var(--brand-red);
}

.schedule-link {
  color: var(--brand-red);
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
  white-space: nowrap;
}

/* 地址条 (垂直分层工整布局) */
.address-strip {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx;
  background: #F9FAFB;
  border-radius: 24rpx;
  border: 1rpx solid var(--border-soft);
  gap: 16rpx;
}

.address-loc-group {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
  flex: 1;
}

.address-line-primary {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.loc-icon-circle {
  font-size: 26rpx;
  flex-shrink: 0;
}

.address-bold {
  font-weight: 700;
  font-size: 28rpx;
  color: var(--text-main);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.35;
}

.address-line-secondary {
  font-size: 24rpx;
  color: var(--text-sub);
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding-left: 36rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.4;
}

.contact-label {
  color: #9CA3AF;
  flex-shrink: 0;
  font-size: 24rpx;
}

.contact-value {
  color: var(--text-main);
  font-weight: 500;
  font-size: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.address-edit-btn {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--brand-red);
  background: #FFF1E6;
  padding: 10rpx 22rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  white-space: nowrap;
  line-height: 1.2;
}

/* 香槟金会员通栏 */
.champagne-vip-bar {
  margin: 24rpx 32rpx 0;
  background: linear-gradient(135deg, #FFFDF8 0%, var(--champagne-bg) 100%);
  border: 1rpx solid var(--champagne-border);
  border-radius: 28rpx;
  padding: 22rpx 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 6rpx 20rpx rgba(245, 158, 11, 0.08);
}

.vip-left-pack {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.vip-star-gold {
  font-size: 34rpx;
}

.vip-text-pack {
  min-width: 0;
}

.vip-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--champagne-gold);
  line-height: 1.35;
  white-space: nowrap;
}

.vip-desc {
  font-size: 24rpx;
  color: #92400E;
  margin-top: 6rpx;
  line-height: 1.4;
  white-space: nowrap;
}

.vip-enter-pill {
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: var(--champagne-gold);
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  white-space: nowrap;
  line-height: 1.2;
}

/* 品类胶囊导航栏 (标准尺寸、独立矢量图标与和谐文字比例) */
.modern-category-row {
  display: flex;
  white-space: nowrap;
  padding: 22rpx 28rpx 14rpx;
  box-sizing: border-box;
}

.cat-capsule {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 22rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
  background: #F3F4F6;
  color: #4B5563;
  margin-right: 14rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.cat-capsule:last-child {
  margin-right: 28rpx;
}

.cat-capsule.active {
  background: linear-gradient(135deg, #E04F16 0%, #C23B08 100%);
  color: #FFFFFF;
  font-weight: 700;
  box-shadow: 0 6rpx 16rpx rgba(217, 72, 15, 0.25);
  transform: translateY(-1rpx);
}

.cat-icon-img {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
  display: block;
}

.cat-name {
  line-height: 1;
  white-space: nowrap;
}

/* 菜品列表 */
.menu-feed {
  padding: 10rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.dish-item-card {
  background: #FFFFFF;
  border-radius: 36rpx;
  padding: 22rpx;
  display: flex;
  gap: 22rpx;
  border: 1rpx solid var(--border-soft);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
  position: relative;
}

.dish-item-card.sold-out {
  opacity: 0.65;
  background: #FAFAFA;
}

.dish-img-box {
  width: 180rpx;
  height: 180rpx;
  border-radius: 28rpx;
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
  background: #F1F3F5;
}

.dish-real-img {
  width: 100%;
  height: 100%;
}

.dish-floating-badge {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  background: rgba(31, 41, 55, 0.75);
  backdrop-filter: blur(4px);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}

.dish-soldout-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 2rpx;
}

.dish-content-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.dish-name-h3 {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.35;
}

.dish-intro-p {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 6rpx;
  line-height: 1.4;
}

.dish-tag-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
}

.tag-vip-disc {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--brand-red);
  background: var(--brand-red-light);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  line-height: 1.2;
}

.tag-points-tip {
  font-size: 22rpx;
  color: var(--text-light);
  line-height: 1.2;
}

.dish-bottom-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  gap: 12rpx;
}

.dish-price-group {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}

.price-symbol {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--brand-red);
}

.dish-price-text {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--brand-red);
  line-height: 1.0;
}

.dish-origin-text {
  font-size: 24rpx;
  color: var(--text-light);
  text-decoration: line-through;
  margin-left: 8rpx;
}

.btn-circle-add {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: var(--brand-red);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 800;
  box-shadow: 0 6rpx 16rpx rgba(217, 72, 15, 0.3);
}

.sold-out-text {
  font-size: 24rpx;
  color: #9CA3AF;
  font-weight: 600;
}

/* 官方资质备案说明 */
.official-license-footer {
  margin: 12rpx 32rpx 40rpx;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  border: 1rpx dashed var(--border-soft);
  text-align: center;
  font-size: 22rpx;
  color: var(--text-light);
  line-height: 1.6;
}

/* 浮动 Dock */
.airy-cart-dock {
  position: fixed;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  left: 32rpx;
  right: 32rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px);
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  border-radius: 48rpx;
  padding: 16rpx 20rpx 16rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 16rpx 40rpx -10rpx rgba(0, 0, 0, 0.12);
  z-index: 50;
}

.cart-summary-text {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.cart-label {
  font-size: 24rpx;
  color: var(--text-sub);
}

.cart-total-num {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--brand-red);
}

.btn-dock-confirm {
  background: linear-gradient(135deg, var(--brand-red) 0%, #b33909 100%);
  color: #FFFFFF;
  padding: 18rpx 40rpx;
  border-radius: 36rpx;
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 20rpx rgba(217, 72, 15, 0.3);
}

/* 结算抽屉 (BottomSheet) */
.drawer-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(4px);
  z-index: 90;
  visibility: hidden;
  opacity: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  transition: all 0.25s ease;
}

.drawer-backdrop.open {
  visibility: visible;
  opacity: 1;
}

.drawer-content-sheet {
  background: #FFFFFF;
  border-top-left-radius: 48rpx;
  border-top-right-radius: 48rpx;
  padding: 36rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  max-height: 85vh;
  overflow-y: auto;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.drawer-backdrop.open .drawer-content-sheet {
  transform: translateY(0);
}

.drawer-bar-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--border-soft);
}

.drawer-h2 {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
}

.drawer-close {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: #F1F3F5;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-sub);
  font-size: 26rpx;
}

.drawer-info-box {
  background: #F8F9FA;
  border-radius: 28rpx;
  padding: 22rpx;
  margin-top: 20rpx;
  font-size: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
}

.info-label {
  color: var(--text-sub);
}

.info-val {
  font-weight: 700;
  color: var(--text-main);
}

.info-val.highlight {
  color: var(--brand-red);
}

/* 口味备注框 */
.remark-input-box {
  margin-top: 16rpx;
  background: #F8F9FA;
  border-radius: 24rpx;
  padding: 18rpx 22rpx;
}

.remark-input {
  font-size: 24rpx;
  color: var(--text-main);
}

/* 抵扣卡片 */
.deduct-light-card {
  margin: 22rpx 0;
  background: #FFFDF8;
  border: 1rpx solid var(--champagne-border);
  border-radius: 32rpx;
  padding: 26rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.deduct-line-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.deduct-line-item.border-top {
  border-top: 1rpx dashed var(--champagne-border);
  padding-top: 18rpx;
}

.deduct-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.deduct-name {
  font-weight: 700;
  color: var(--text-main);
  font-size: 24rpx;
}

.deduct-name.red {
  color: var(--brand-red);
}

.deduct-sub {
  font-size: 22rpx;
  color: var(--text-sub);
}

.deduct-sub.red {
  color: var(--brand-red);
}

.deduct-tip-text {
  font-size: 22rpx;
  color: #D97706;
  padding-left: 8rpx;
}

.deduct-calc-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-left: 8rpx;
  font-size: 22rpx;
}

.deduct-limit-hint {
  color: var(--text-sub);
}

.deduct-input-group {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.symbol {
  color: var(--brand-red);
  font-weight: 800;
}

.red-amount-input {
  width: 120rpx;
  padding: 4rpx 10rpx;
  border: 1rpx solid #D1D5DB;
  border-radius: 12rpx;
  text-align: right;
  font-weight: 800;
  color: var(--brand-red);
  background: #FFFFFF;
  font-size: 24rpx;
}

/* 账单明细列表 */
.bill-summary-list {
  font-size: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.bill-row {
  display: flex;
  justify-content: space-between;
  color: var(--text-sub);
}

.bill-row.red {
  color: var(--brand-red);
}

.bill-row.orange {
  color: #D97706;
}

.bill-row.bold {
  font-weight: 800;
}

.bill-final-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--border-soft);
}

.final-title {
  font-size: 30rpx;
  font-weight: 900;
  color: var(--text-main);
}

.final-price-box {
  text-align: right;
}

.final-price-num {
  font-size: 38rpx;
  font-weight: 900;
  color: var(--brand-red);
}

.final-rebate-hint {
  font-size: 20rpx;
  color: var(--text-light);
}

.btn-wxpay-submit {
  margin-top: 26rpx;
  width: 100%;
  padding: 24rpx;
  border-radius: 36rpx;
  background: #059669;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(5, 150, 105, 0.3);
}

.empty-dish-box {
  text-align: center;
  padding: 80rpx 0;
}

.empty-dish-box .empty-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.empty-dish-box .empty-text {
  font-size: 26rpx;
  color: var(--text-light);
}

/* 步进器样式 */
.cart-stepper-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.btn-stepper {
  width: 52rpx;
  height: 52rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 800;
}

.btn-stepper.minus {
  background: #F3F4F6;
  color: #374151;
  border: 1rpx solid #E5E7EB;
}

.btn-stepper.plus {
  background: linear-gradient(135deg, #D9480F, #C23B06);
  color: #FFFFFF;
}

.stepper-count {
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
  min-width: 32rpx;
  text-align: center;
}

/* 抽屉中的已选老卤清单 */
.drawer-cart-list {
  background: #F9FAFB;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #E5E7EB;
}

.drawer-cart-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.cart-list-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #374151;
}

.cart-list-clear {
  font-size: 22rpx;
  color: #9CA3AF;
  padding: 4rpx 10rpx;
}

.drawer-cart-scroll {
  max-height: 240rpx;
}

.drawer-cart-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx dashed #E5E7EB;
}

.drawer-cart-item:last-child {
  border-bottom: none;
}

.item-meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.drawer-cart-item .item-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #1F2937;
}

.drawer-cart-item .item-unit-price {
  font-size: 22rpx;
  color: #D9480F;
  font-weight: 700;
}

.cart-stepper-row.in-drawer .btn-stepper {
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  font-size: 28rpx;
}

.dock-badge-dot {
  position: absolute;
  top: -10rpx;
  left: 20rpx;
  background: #D9480F;
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 700;
  min-width: 30rpx;
  height: 30rpx;
  border-radius: 15rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
  border: 2rpx solid #FFFFFF;
}

.checkout-contact { padding: 16rpx; background: #FFF8F2; border-radius: 16rpx; }
.checkout-contact input, .checkout-contact picker { margin: 16rpx 0; min-height: 52rpx; font-size: 26rpx; }
.checkout-error { color: #B42318; padding: 16rpx; font-size: 24rpx; }
.shop-announcement { font-size: 24rpx; color: #9A3412; margin-top: 16rpx; }
.drawer-content-sheet { max-height: 88vh; overflow-y: auto; }

.checkout-rule-link {font-size:24rpx;color:#9A3412;padding:20rpx 0;text-align:center;}
.dish-photo-placeholder {height:100%;display:flex;align-items:center;justify-content:center;background:#FFF1E5;font-size:64rpx;}

/* 点餐首页：温润纸色、完整店名和易扫读的菜品信息 */
.container { background: #F6F4F0; }
.header-unified-card { margin: 0 28rpx; padding: 30rpx 26rpx; border-radius: 24rpx; border: 1rpx solid #EAE5DF; box-shadow: none; }
.header-top-line { display: flex; flex-direction: row; justify-content: space-between; align-items: center; gap: 16rpx; }
.shop-name-block { flex: 1; min-width: 0; }
.shop-title { font-size: 36rpx; font-weight: 700; color: #332C25; line-height: 1.3; }
.shop-sub { font-size: 22rpx; color: #98816B; line-height: 1.5; margin-top: 6rpx; }
.segmented-control { align-self: center; flex-shrink: 0; display: flex; padding: 6rpx; background: #F1EDE7; border-radius: 14rpx; }
.segment-btn { padding: 12rpx 22rpx; border-radius: 10rpx; font-size: 24rpx; font-weight: 500; white-space: nowrap; }
.segment-btn.active { background: #fff; color: #A14726; box-shadow: 0 2rpx 6rpx #E6DDD2; }
.shop-announcement { font-size: 22rpx; line-height: 1.7; color: #9B7153; margin: 20rpx 0 0; }
.header-schedule-box { margin-top: 22rpx; background: #FAF5EB; border-color: #F0E5D1; border-radius: 14rpx; padding: 20rpx; }
.schedule-left { font-size: 26rpx; }
.schedule-left picker { min-width: 0; }
.pulse-orange-dot { width: 10rpx; height: 10rpx; background: #B45A30; box-shadow: none; }
.schedule-link { font-size: 22rpx; font-weight: 500; color: #A36F40; }
.address-strip { background: transparent; padding: 4rpx 0 0; border: 0; gap: 10rpx; }
.address-bold { font-size: 25rpx; font-weight: 500; white-space: normal; line-height: 1.6; }
.address-line-secondary { padding-left: 30rpx; font-size: 21rpx; white-space: normal; flex-wrap: wrap; }
.contact-label,.contact-value { font-size: 21rpx; color: #9B8A79; white-space: normal; }
.loc-icon-circle { font-size: 23rpx; }
.address-edit-btn { padding: 14rpx; border-radius: 10rpx; font-size: 23rpx; }
.champagne-vip-bar { margin: 22rpx 28rpx 0; padding: 22rpx; border-radius: 18rpx; box-shadow: none; background: #EEE5D7; border: 0; gap: 12rpx; }
.vip-left-pack,.vip-text-pack { min-width: 0; }
.vip-title { font-size: 26rpx; font-weight: 600; color: #745130; }
.vip-desc { font-size: 22rpx; line-height: 1.6; color: #9C7F61; }
.vip-enter-pill { flex-shrink: 0; background: transparent; color: #94643B; padding: 8rpx; font-size: 22rpx; }
.modern-category-row { padding-top: 22rpx; padding-bottom: 22rpx; }
.cat-capsule { border-radius: 12rpx; padding: 18rpx 24rpx; background: #ECE8E1; border: 0; font-size: 25rpx; }
.cat-capsule.active { background: #A94728; box-shadow: none; transform: none; }
.menu-feed { padding: 0 28rpx 28rpx; gap: 20rpx; }
.dish-item-card { padding: 22rpx; border-radius: 22rpx; gap: 22rpx; box-shadow: none; border-color: #EAE5DF; }
.dish-img-box { width: 194rpx; height: 218rpx; border-radius: 16rpx; background: #EEE5D7; }
.dish-content-box { min-width: 0; }
.dish-name-h3 { font-size: 29rpx; font-weight: 600; line-height: 1.5; color: #332C25; }
.dish-intro-p { font-size: 23rpx; color: #9B8979; line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-top: 8rpx; }
.dish-tag-row { flex-wrap: wrap; gap: 8rpx 12rpx; margin-top: 12rpx; }
.tag-vip-disc { font-size: 21rpx; font-weight: 500; color: #A64A28; background: #FAEEE5; padding: 4rpx 8rpx; border-radius: 5rpx; }
.tag-points-tip { font-size: 21rpx; color: #A19588; }
.dish-bottom-action { flex-wrap: wrap; gap: 14rpx; margin-top: 16rpx; }
.dish-price-text { font-size: 36rpx; font-weight: 650; color: #AC4625; }
.price-symbol { color: #AC4625; font-size: 22rpx; }
.dish-price-group { flex-wrap: wrap; }
.dish-origin-text { font-size: 22rpx; }
.btn-circle-add,.btn-stepper.plus { background: #AF4727; box-shadow: none; }
.btn-circle-add { width: 56rpx; height: 56rpx; border-radius: 16rpx; margin-left: auto; }
.cart-stepper-row { gap: 12rpx; margin-left: auto; }
.btn-stepper { width: 54rpx; height: 54rpx; border-radius: 14rpx; font-weight: 500; }
.stepper-count { font-size: 26rpx; min-width: 26rpx; }
.dish-floating-badge { top: auto; bottom: 0; left: 0; right: 0; border-radius: 0; padding: 8rpx 10rpx; text-align: center; font-size: 20rpx; font-weight: 400; background: rgba(64,44,26,.7); }
.dish-photo-placeholder { flex-direction: column; background: #F0E9DE; font-family: serif; font-size: 58rpx; color: #AF9270; }
.placeholder-caption { font-family: sans-serif; font-size: 21rpx; margin-top: 12rpx; color: #AD9B86; }
.airy-cart-dock { left: 28rpx; right: 28rpx; border-radius: 22rpx; padding: 18rpx 20rpx; border-color: #E8DFD4; box-shadow: 0 8rpx 28rpx rgba(79,57,34,.12); }
.cart-summary-text { min-width: 0; flex-wrap: wrap; gap: 8rpx; }
.cart-total-num { font-size: 36rpx; color: #AA4624; }
.btn-dock-confirm { background: #AA4624; border-radius: 16rpx; padding: 22rpx 32rpx; font-size: 26rpx; white-space: nowrap; box-shadow: none; }
.drawer-content-sheet { border-radius: 28rpx 28rpx 0 0; background: #FFFEFC; padding: 30rpx 28rpx calc(40rpx + env(safe-area-inset-bottom)); }
.drawer-h2 { font-size: 32rpx; font-weight: 600; }
.drawer-info-box { border-radius: 16rpx; background: #F5F1EA; }
.info-row { gap: 20rpx; font-size: 24rpx; line-height: 1.7; }
.info-label { flex-shrink: 0; }
.info-val { min-width: 0; text-align: right; overflow-wrap: anywhere; font-weight: 500; }
.checkout-contact .contact-input { width: 100%; height: 88rpx; box-sizing: border-box; background: #F8F5EF; border: 1rpx solid #E8DFD4; border-radius: 12rpx; margin: 16rpx 0; padding: 20rpx; font-size: 26rpx; }
.checkout-contact picker { font-size: 26rpx; padding: 20rpx 0; color: #8C6546; }
.deduct-left { min-width: 0; flex: 1; }
.deduct-line-item { gap: 12rpx; }
.deduct-name { font-size: 26rpx; }
.deduct-sub { font-size: 22rpx; }
.bill-final-row { align-items: flex-start; gap: 18rpx; }
.final-title { flex-shrink: 0; font-size: 28rpx; font-weight: 600; }
.final-rebate-hint { line-height: 1.7; font-size: 22rpx; margin-top: 8rpx; }
.btn-wxpay-submit { background: #278464; box-shadow: none; padding: 18rpx 24rpx; border-radius: 16rpx; font-size: 28rpx; font-weight: 600; line-height: 1.6; }
.official-license-footer { color: #A99B8C; font-size: 21rpx; line-height: 1.8; }

.drawer-info-box .copy-pickup-button { margin: 16rpx 0 0; padding: 12rpx 20rpx; font-size: 24rpx; line-height: 1.6; color: #8A6D51; background: #FFFCF7; border-radius: 10rpx; }
.copy-pickup-button::after { border: 1rpx solid #E5DACB; }

/* 快速选择配送地址弹窗 */
.address-picker-dialog {
  width: 100%;
  max-width: 650rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  box-sizing: border-box;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.16);
}
.address-picker-dialog .modal-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.address-picker-dialog .modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2937;
}
.address-picker-dialog .modal-close {
  font-size: 32rpx;
  color: #9CA3AF;
  padding: 8rpx;
  line-height: 1;
}
.address-picker-dialog .address-quick-actions {
  display: flex;
  margin-bottom: 20rpx;
}
.address-picker-dialog .btn-import-wx {
  flex: 1;
  background: #ECFDF5 !important;
  color: #059669 !important;
  border: 1rpx solid #A7F3D0 !important;
  border-radius: 14rpx;
  font-size: 25rpx !important;
  font-weight: 600;
  padding: 16rpx 10rpx !important;
  line-height: 1.4;
  margin: 0 !important;
}
.address-picker-dialog .address-scroll-list {
  max-height: 50vh;
  margin-bottom: 24rpx;
}
.address-picker-dialog .address-empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}
.address-picker-dialog .empty-icon {
  font-size: 52rpx;
  margin-bottom: 10rpx;
}
.address-picker-dialog .empty-text {
  font-size: 28rpx;
  color: #4B5563;
  font-weight: 600;
}
.address-picker-dialog .empty-sub {
  font-size: 23rpx;
  color: #9CA3AF;
  margin-top: 6rpx;
}
.address-picker-dialog .address-card-item {
  background: #F9FAFB;
  border: 1.5rpx solid #E5E7EB;
  border-radius: 18rpx;
  padding: 22rpx 20rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.address-picker-dialog .address-card-item.is-default {
  background: #FFFDF9;
  border-color: rgba(217, 72, 15, 0.4);
}
.address-picker-dialog .addr-item-main {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}
.address-picker-dialog .addr-user-line {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 6rpx;
}
.address-picker-dialog .addr-user-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1F2937;
}
.address-picker-dialog .addr-user-phone {
  font-size: 26rpx;
  color: #6B7280;
}
.address-picker-dialog .addr-badge-default {
  background: #FFF1E6;
  color: #D9480F;
  font-size: 20rpx;
  font-weight: 600;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}
.address-picker-dialog .addr-detail-text {
  font-size: 24rpx;
  color: #4B5563;
  line-height: 1.4;
}
.address-picker-dialog .addr-select-tag {
  flex-shrink: 0;
  font-size: 23rpx;
  color: #D9480F;
  font-weight: 600;
}
.address-picker-dialog .btn-dialog-done {
  background: #F3F4F6;
  color: #4B5563;
  font-size: 27rpx;
  font-weight: 600;
  border-radius: 16rpx;
  padding: 18rpx 0;
  width: 100%;
  border: 0;
}
