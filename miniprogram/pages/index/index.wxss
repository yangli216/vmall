.container {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 头部一体化卡片 */
.header-unified-card {
  background: #FFFFFF;
  padding: 30rpx 32rpx 26rpx;
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.03);
}

.header-top-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
}

.shop-name-block {
  flex: 1;
  min-width: 0;
}

.shop-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.25;
  letter-spacing: 0.5rpx;
}

.shop-sub {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.4;
}

/* 配送方式分段胶囊 */
.segmented-control {
  display: flex;
  background: #F1F3F5;
  padding: 6rpx;
  border-radius: 28rpx;
  flex-shrink: 0;
}

.segment-btn {
  padding: 10rpx 22rpx;
  border-radius: 22rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-sub);
  white-space: nowrap;
  transition: all 0.2s;
  line-height: 1.2;
}

.segment-btn.active {
  background: #FFFFFF;
  color: var(--text-main);
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

/* 出炉预约条 */
.header-schedule-box {
  background: #F8F9FA;
  border: 1rpx solid var(--border-soft);
  border-radius: 24rpx;
  padding: 16rpx 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  margin-top: 18rpx;
  gap: 16rpx;
}

.schedule-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--text-main);
  font-weight: 500;
  font-size: 24rpx;
  flex: 1;
  min-width: 0;
}

.schedule-left text {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.pulse-orange-dot {
  width: 14rpx;
  height: 14rpx;
  background: var(--brand-red);
  border-radius: 50%;
  box-shadow: 0 0 12rpx rgba(217, 72, 15, 0.6);
  flex-shrink: 0;
}

.highlight-time {
  color: var(--brand-red);
}

.schedule-link {
  color: var(--brand-red);
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
  white-space: nowrap;
}

/* 地址条 (垂直分层工整布局) */
.address-strip {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx;
  background: #F9FAFB;
  border-radius: 24rpx;
  border: 1rpx solid var(--border-soft);
  gap: 16rpx;
}

.address-loc-group {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
  flex: 1;
}

.address-line-primary {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.loc-icon-circle {
  font-size: 26rpx;
  flex-shrink: 0;
}

.address-bold {
  font-weight: 700;
  font-size: 28rpx;
  color: var(--text-main);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.35;
}

.address-line-secondary {
  font-size: 24rpx;
  color: var(--text-sub);
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding-left: 36rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.4;
}

.contact-label {
  color: #9CA3AF;
  flex-shrink: 0;
  font-size: 24rpx;
}

.contact-value {
  color: var(--text-main);
  font-weight: 500;
  font-size: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.address-edit-btn {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--brand-red);
  background: #FFF1E6;
  padding: 10rpx 22rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  white-space: nowrap;
  line-height: 1.2;
}

/* 香槟金会员通栏 */
.champagne-vip-bar {
  margin: 24rpx 32rpx 0;
  background: linear-gradient(135deg, #FFFDF8 0%, var(--champagne-bg) 100%);
  border: 1rpx solid var(--champagne-border);
  border-radius: 28rpx;
  padding: 22rpx 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 6rpx 20rpx rgba(245, 158, 11, 0.08);
}

.vip-left-pack {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.vip-star-gold {
  font-size: 34rpx;
}

.vip-text-pack {
  min-width: 0;
}

.vip-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--champagne-gold);
  line-height: 1.35;
  white-space: nowrap;
}

.vip-desc {
  font-size: 24rpx;
  color: #92400E;
  margin-top: 6rpx;
  line-height: 1.4;
  white-space: nowrap;
}

.vip-enter-pill {
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: var(--champagne-gold);
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  white-space: nowrap;
  line-height: 1.2;
}

/* 品类胶囊导航栏 (标准尺寸、独立矢量图标与和谐文字比例) */
.modern-category-row {
  display: flex;
  white-space: nowrap;
  padding: 22rpx 28rpx 14rpx;
  box-sizing: border-box;
}

.cat-capsule {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 22rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
  background: #F3F4F6;
  color: #4B5563;
  margin-right: 14rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.cat-capsule:last-child {
  margin-right: 28rpx;
}

.cat-capsule.active {
  background: linear-gradient(135deg, #E04F16 0%, #C23B08 100%);
  color: #FFFFFF;
  font-weight: 700;
  box-shadow: 0 6rpx 16rpx rgba(217, 72, 15, 0.25);
  transform: translateY(-1rpx);
}

.cat-icon-img {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
  display: block;
}

.cat-name {
  line-height: 1;
  white-space: nowrap;
}

/* 菜品列表 */
.menu-feed {
  padding: 10rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.dish-item-card {
  background: #FFFFFF;
  border-radius: 36rpx;
  padding: 22rpx;
  display: flex;
  gap: 22rpx;
  border: 1rpx solid var(--border-soft);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
  position: relative;
}

.dish-item-card.sold-out {
  opacity: 0.65;
  background: #FAFAFA;
}

.dish-img-box {
  width: 180rpx;
  height: 180rpx;
  border-radius: 28rpx;
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
  background: #F1F3F5;
}

.dish-real-img {
  width: 100%;
  height: 100%;
}

.dish-floating-badge {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  background: rgba(31, 41, 55, 0.75);
  backdrop-filter: blur(4px);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}

.dish-soldout-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 2rpx;
}

.dish-content-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.dish-name-h3 {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.35;
}

.dish-intro-p {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 6rpx;
  line-height: 1.4;
}

.dish-tag-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
}

.tag-vip-disc {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--brand-red);
  background: var(--brand-red-light);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  line-height: 1.2;
}

.tag-points-tip {
  font-size: 22rpx;
  color: var(--text-light);
  line-height: 1.2;
}

.dish-bottom-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  gap: 12rpx;
}

.dish-price-group {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}

.price-symbol {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--brand-red);
}

.dish-price-text {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--brand-red);
  line-height: 1.0;
}

.dish-origin-text {
  font-size: 24rpx;
  color: var(--text-light);
  text-decoration: line-through;
  margin-left: 8rpx;
}

.btn-circle-add {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: var(--brand-red);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 800;
  box-shadow: 0 6rpx 16rpx rgba(217, 72, 15, 0.3);
}

.sold-out-text {
  font-size: 24rpx;
  color: #9CA3AF;
  font-weight: 600;
}

/* 官方资质备案说明 */
.official-license-footer {
  margin: 12rpx 32rpx 40rpx;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  border: 1rpx dashed var(--border-soft);
  text-align: center;
  font-size: 22rpx;
  color: var(--text-light);
  line-height: 1.6;
}

/* 浮动 Dock */
.airy-cart-dock {
  position: fixed;
  bottom: 20rpx;
  left: 32rpx;
  right: 32rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px);
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  border-radius: 48rpx;
  padding: 16rpx 20rpx 16rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 16rpx 40rpx -10rpx rgba(0, 0, 0, 0.12);
  z-index: 50;
}

.cart-summary-text {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.cart-label {
  font-size: 24rpx;
  color: var(--text-sub);
}

.cart-total-num {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--brand-red);
}

.btn-dock-confirm {
  background: linear-gradient(135deg, var(--brand-red) 0%, #b33909 100%);
  color: #FFFFFF;
  padding: 18rpx 40rpx;
  border-radius: 36rpx;
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 20rpx rgba(217, 72, 15, 0.3);
}

/* 结算抽屉 (BottomSheet) */
.drawer-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(4px);
  z-index: 90;
  visibility: hidden;
  opacity: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  transition: all 0.25s ease;
}

.drawer-backdrop.open {
  visibility: visible;
  opacity: 1;
}

.drawer-content-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 95;
  background: #FFFEFC;
  border-top-left-radius: 36rpx;
  border-top-right-radius: 36rpx;
  padding: 0;
  height: 80vh;
  max-height: 82vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  visibility: hidden;
  box-sizing: border-box;
}

.drawer-content-sheet.open {
  transform: translateY(0);
  visibility: visible;
}

.drawer-bar-title {
  flex-shrink: 0;
  height: 88rpx;
  padding: 0 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #EAE5DF;
  background: #FFFEFC;
  box-sizing: border-box;
}

.drawer-h2 {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
}

.drawer-close {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: #F1F3F5;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-sub);
  font-size: 26rpx;
}

/* 结算中间滚动区：高度保证纵向滚动顺畅 */
.drawer-body-scroll {
  flex: 1;
  height: calc(80vh - 88rpx - 140rpx);
  min-height: 0;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding: 14rpx 24rpx 10rpx;
  box-sizing: border-box;
}

/* 抽屉顶置醒目履约方式大 Tab */
.checkout-delivery-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.delivery-tab-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 14rpx 10rpx;
  background: #F1EAE2;
  border-radius: 16rpx;
  border: 1.5rpx solid #E6D9CC;
  transition: all 0.2s ease;
}

.delivery-tab-btn .tab-emoji {
  font-size: 28rpx;
}

.delivery-tab-btn .tab-main-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #6C5A48;
}

.delivery-tab-btn .tab-sub-tip {
  font-size: 20rpx;
  color: #9C8976;
}

.delivery-tab-btn.active {
  background: #AA4624;
  border-color: #AA4624;
  box-shadow: 0 4rpx 14rpx rgba(170, 70, 36, 0.25);
}

.delivery-tab-btn.active .tab-main-text,
.delivery-tab-btn.active .tab-sub-tip {
  color: #FFFFFF;
}

/* 履约与配送信息一体化卡片 (配送地址与联系人统一归属配送信息，作为一个整体展示) */
.drawer-fulfillment-card {
  background: #FDF9F4;
  border: 1.5rpx solid #EFE4D6;
  border-radius: 18rpx;
  padding: 14rpx 20rpx 10rpx;
  margin-bottom: 14rpx;
}

.fulfillment-card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 12rpx;
  border-bottom: 1rpx dashed #EAE0D5;
}

/* 抽屉内自送/自提分段选择器 */
.drawer-delivery-switch {
  display: inline-flex;
  background: #EFE4D6;
  padding: 4rpx;
  border-radius: 12rpx;
}

.switch-tab {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 18rpx;
  border-radius: 9rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #7D6B5A;
  transition: all 0.2s ease;
}

.switch-tab.active {
  background: #FFFFFF;
  color: #AA4624;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(100, 70, 30, 0.08);
}

.switch-tab .tab-icon {
  font-size: 22rpx;
}

.fulfillment-card-head .head-title-tag {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.fulfillment-card-head .head-icon {
  font-size: 28rpx;
}

.fulfillment-card-head .head-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #7A634E;
}

.fulfillment-card-head .head-badge {
  font-size: 19rpx;
  color: #AA4624;
  background: #FFF0E4;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-weight: 600;
}

.fulfillment-card-head .head-action .action-btn-text {
  font-size: 24rpx;
  color: #AA4624;
  font-weight: 700;
}

.fulfillment-card-body {
  padding: 14rpx 0 10rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.card-address-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.card-address-line .addr-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #332C25;
  line-height: 1.35;
  word-break: break-all;
}

.card-address-line .btn-copy-tag {
  font-size: 20rpx;
  color: #8A6D51;
  background: #FFFFFF;
  border: 1rpx solid #E5DACB;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.card-contact-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.card-contact-line .contact-label {
  font-size: 24rpx;
  color: #8C7D70;
}

.card-contact-line .contact-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #4A3E35;
}

.card-contact-line .contact-phone {
  font-size: 26rpx;
  font-weight: 600;
  color: #665C54;
}

.card-empty-line {
  padding: 6rpx 0;
}

.card-empty-line .empty-hint {
  font-size: 26rpx;
  color: #AA4624;
  font-weight: 600;
}

.compact-schedule-strip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 0 2rpx;
  border-top: 1rpx dashed #EAE0D5;
}

.compact-schedule-strip .strip-label {
  font-size: 21rpx;
  color: #8C7D70;
}

.compact-schedule-strip .strip-val {
  font-size: 23rpx;
  font-weight: 700;
  color: #AA4624;
}

/* 底部常驻结算条 (吸底保证一屏可见确认按钮) */
.drawer-footer-bar {
  flex-shrink: 0;
  background: #FFFFFF;
  border-top: 1rpx solid #EAE5DF;
  padding: 18rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
  z-index: 10;
}

.drawer-footer-bar .footer-left {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
  flex: 1;
}

.drawer-footer-bar .footer-final-price-box {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.drawer-footer-bar .footer-label {
  font-size: 24rpx;
  color: #7A6F65;
  font-weight: 500;
}

.drawer-footer-bar .footer-price-num {
  font-size: 40rpx;
  font-weight: 900;
  color: #AA4624;
}

.drawer-footer-bar .footer-discount-hint {
  font-size: 20rpx;
  color: #059669;
  font-weight: 500;
  margin-top: 2rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.drawer-footer-bar .hint-saved-tag {
  color: #AA4624;
  font-weight: 700;
  background: #FEECE5;
  padding: 1rpx 8rpx;
  border-radius: 6rpx;
  font-size: 19rpx;
}

.drawer-footer-bar .hint-desc {
  color: #059669;
}

.drawer-footer-bar .footer-right {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-shrink: 0;
}

.drawer-footer-bar .checkout-error {
  font-size: 22rpx;
  color: #DC2626;
  padding: 4rpx;
  max-width: 200rpx;
  text-align: right;
  line-height: 1.3;
}

.drawer-footer-bar .btn-wxpay-submit {
  margin-top: 0;
  min-width: 250rpx;
  padding: 20rpx 32rpx;
  border-radius: 36rpx;
  background: #278464;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(39, 132, 100, 0.28);
  border: none;
  line-height: 1.4;
}

.drawer-footer-bar .btn-wxpay-submit[disabled] {
  background: #D1D5DB !important;
  color: #9CA3AF !important;
  box-shadow: none !important;
}

.drawer-info-box {
  background: #F8F9FA;
  border-radius: 28rpx;
  padding: 22rpx;
