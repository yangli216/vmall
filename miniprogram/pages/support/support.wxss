.page {padding:24rpx;background:#FAF8F4;min-height:100vh;box-sizing:border-box;color:#38302A;font-size:28rpx;}
.card {padding:28rpx;margin-bottom:24rpx;border-radius:20rpx;background:#FFF;line-height:1.7;}
.notice {padding:20rpx 0;color:#786B62;font-size:25rpx;line-height:1.7;}
.error {color:#B42318;}
.title {font-weight:600;margin-bottom:16rpx;word-break:break-all;}
.meta {font-size:23rpx;color:#8A8077;margin-top:12rpx;}
.field {padding:20rpx 0;border-top:1rpx solid #EEE;margin-top:20rpx;}
textarea {width:100%;height:220rpx;padding:20rpx;box-sizing:border-box;background:#FAF8F4;border-radius:12rpx;margin:12rpx 0 24rpx;font-size:27rpx;}
.description {white-space:pre-wrap;word-break:break-all;}
.reply {margin-top:24rpx;padding:20rpx;background:#FFF6EB;border-radius:12rpx;}
button {font-size:28rpx;}
