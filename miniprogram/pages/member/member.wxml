<!-- miniprogram/pages/member/member.wxml -->
<view class="container">
  <dev-banner />
  <view wx:if="{{localDevelopment}}" class="test-account-panel">
    <view>测试账户的余额、订单和支付均为联调数据</view>
    <view class="test-account-actions">
      <button size="mini" disabled="{{switchingTestAccount}}" data-openid="wx_dev_local_customer" bindtap="switchTestAccount">切换新客</button>
      <button size="mini" disabled="{{switchingTestAccount}}" data-openid="wx_dev_local_member" bindtap="switchTestAccount">切换会员</button>
      <button size="mini" disabled="{{switchingTestAccount}}" data-openid="wx_dev_local_admin" bindtap="switchTestAccount">切换掌柜</button>
    </view>
  </view>

  <!-- 1. 会员卡片主视觉 (香槟金与微暖象牙白) -->
  <view class="member-hero-card {{isMember ? 'vip' : 'normal'}}">
    <view class="card-bg-pattern"></view>
    <view class="card-top">
      <view class="user-meta-pack">
        <view class="avatar-wrap" bindtap="onAvatarSecretTap">
          <image class="avatar-img" src="{{userInfo.avatar_url || '/images/tab_member.png'}}" mode="aspectFit"></image>
          <view wx:if="{{isMember}}" class="vip-crown-badge">👑</view>
        </view>
        <view class="user-text-info">
          <view class="nickname-row" bindtap="onEditProfile">
            <text class="user-nickname">{{userInfo.nickname || '潘小兜客官'}}</text>
            <text style="font-size: 20rpx; color: var(--text-light); margin-right: 8rpx;">✏️</text>
            <view class="member-tag {{isMember ? 'vip-pill' : 'normal-pill'}}">
              {{isMember ? '尊享会员 · 会员价' : '普通客官'}}
            </view>
          </view>
          <view class="bind-referrer-hint" wx:if="{{userInfo.referrer_code}}">
            已由推荐人【{{userInfo.referrer_code}}】邀请绑定
          </view>
          <view class="bind-referrer-hint" wx:else>
            临安锦城手工老卤 · 鲜卤现捞
          </view>
        </view>
      </view>
    </view>

    <!-- 会员特权与消费门槛进度 -->
    <view class="member-level-progress" wx:if="{{!isMember}}">
      <view class="progress-info-row" wx:if="{{config.MEMBER_ENTRY_MODE === 'CONSUME' && !userInfo.member_opt_out}}">
        <text class="progress-title">{{config.MEMBER_ENTRY_MODE === 'FREE' ? '当前支持免费入会' : config.MEMBER_ENTRY_MODE === 'MANUAL' ? '由掌柜邀请开通' : '消费累积，解锁会员价'}}</text>
        <text class="progress-val">累计 ¥{{userInfo.total_consumption || '0.00'}} / ¥{{config.MEMBER_ENTRY_THRESHOLD || '68.00'}}</text>
      </view>
      <view class="progress-bar-track" wx:if="{{config.MEMBER_ENTRY_MODE === 'CONSUME' && !userInfo.member_opt_out}}">
        <view class="progress-bar-fill" style="width: {{progressPercent}}%"></view>
      </view>
      <view class="upgrade-action-row" wx:if="{{config.MEMBER_ENTRY_MODE === 'FREE'}}">
        <text class="free-tip">🎉 当前作坊开启「新客免费升级」活动</text>
        <button class="btn-free-upgrade" bindtap="openRegisterModal">填写资料并免费开通会员</button>
      </view>
      <view wx:elif="{{userInfo.member_opt_out}}">你已主动退出会员，如需重新开通请联系掌柜。</view>
      <view wx:elif="{{config.MEMBER_ENTRY_MODE === 'MANUAL'}}">当前由掌柜邀请开通会员，可联系掌柜咨询。</view>
    </view>
    <view class="member-vip-valid" wx:else>
      <text class="valid-text">✨ 当前享受菜品会员价，会员资格以实际消费及门店规则为准</text>
    </view>
  </view>

  <!-- 2. 每日签到领积分卡片 -->
  <view class="signin-section-card">
    <view class="signin-card-main">
      <view class="signin-icon-box">
        <text class="signin-calendar-icon">🎁</text>
      </view>
      <view class="signin-info-col">
        <view class="signin-title-line">
          <text class="signin-title">每日签到领积分</text>
          <text class="signin-streak-badge" wx:if="{{signInInfo.continuous_days > 0}}">连签{{signInInfo.continuous_days}}天</text>
        </view>
        <view class="signin-desc-text">
          <text wx:if="{{signInInfo.is_signed_today}}">今日已打卡，明日继续领 +{{signInInfo.reward_points || 10}} 分</text>
          <text wx:else>打卡立赠 +{{signInInfo.reward_points || 10}} 普通积分，下单可抵现</text>
        </view>
      </view>
    </view>
    <button 
      class="btn-signin-action btn-press {{signInInfo.is_signed_today ? 'is-signed' : ''}}" 
      disabled="{{signInInfo.is_signed_today || signingIn}}" 
      loading="{{signingIn}}" 
      bindtap="handleDailySignIn">
      {{signInInfo.is_signed_today ? '✓ 已签' : '签到 +' + (signInInfo.reward_points || 10)}}
    </button>
  </view>

  <!-- 3. 双积分账户看板 -->
  <view class="asset-heading" bindtap="showAccountFlows"><text>我的资产</text><text class="asset-detail">收支明细 ›</text></view>
  <view class="points-board-grid" bindtap="showAccountFlows">
    <!-- 普通积分 -->
    <view class="point-account-card">
      <view class="point-card-header">
        <text class="point-name">普通积分</text>
        <text class="point-desc">订单完成后赠送</text>
      </view>
      <view class="point-value-row">
        <text class="point-num">{{userInfo.normal_points || 0}}</text>
        <text class="point-unit">分</text>
      </view>
      <view class="point-rule-tip">
        有效货款每¥1赠1分，订单完成后到账；100分抵¥5
      </view>
      <view class="point-rule-tip" wx:if="{{userInfo.normal_points_debt > 0}}">退款已用奖励待抵回 {{userInfo.normal_points_debt}} 分，后续赠分先抵回</view>
    </view>

    <!-- 红包积分 -->
    <view class="point-account-card red-theme">
      <view class="point-card-header">
        <text class="point-name red">推荐红包</text>
        <text class="point-desc red">仅抵货款</text>
      </view>
      <view class="point-value-row">
        <text class="point-num red">¥{{userInfo.red_packet_points || '0.00'}}</text>
      </view>
      <view class="point-rule-tip">
        好友有效现金货款的 {{config.COMMISSION_RATE * 100}}% · 订单完成后到账
      </view>
      <view class="point-rule-tip" wx:if="{{userInfo.red_packet_debt > 0}}">退款已用奖励待抵回 ¥{{userInfo.red_packet_debt}}，后续推荐奖励先抵回</view>
    </view>
  </view>

  <!-- 会员专属：推荐好友快捷卡片 (支持转发微信好友与朋友圈) -->
  <view class="member-referral-card" wx:if="{{isMember && userInfo.invite_code}}">
    <view class="referral-card-header">
      <view class="referral-header-left">
        <text class="referral-tag">街坊推荐</text>
        <text class="referral-title">推荐好友享 {{config.COMMISSION_RATE * 100}}% 红包</text>
      </view>
      <view class="referral-more-link" bindtap="navToPromote">推广中心 ›</view>
    </view>
    <view class="member-code-bar">
      <text class="member-code-label">专属邀请码：<text class="member-code-text">{{userInfo.invite_code}}</text></text>
      <text class="member-code-copy" bindtap="copyReferralCode">复制</text>
    </view>
    <view class="member-share-btn-row">
      <button class="member-share-btn btn-share-wx btn-press" open-type="share">
        <text class="btn-emoji">💬</text>
        <text>发给微信好友</text>
      </button>
      <button class="member-share-btn btn-share-pyq btn-press" bindtap="showTimelineGuide">
        <text class="btn-emoji">✨</text>
        <text>分享到朋友圈</text>
      </button>
    </view>
  </view>

  <!-- 3. 会员专享四大特权 -->
  <view class="section-card">
    <view class="section-title">
      <text class="title-h3">尊享会员权益</text>
      <text class="title-sub">作坊匠心回馈老街坊</text>
    </view>
    <view class="privilege-grid">
      <view class="priv-item">
        <view class="priv-icon-box">🏷️</view>
        <view class="priv-info">
          <view class="priv-name">菜品会员价</view>
          <view class="priv-sub">每款菜品独立会员定价</view>
        </view>
      </view>
      <view class="priv-item">
        <view class="priv-icon-box">🎁</view>
        <view class="priv-info">
          <view class="priv-name">双重积分权益</view>
          <view class="priv-sub">普通积分抵扣 + 红包抵货款</view>
        </view>
      </view>
      <view class="priv-item">
        <view class="priv-icon-box">🤝</view>
        <view class="priv-info">
          <view class="priv-name">推荐消费奖励</view>
          <view class="priv-sub">好友完成订单后奖励到账</view>
        </view>
      </view>
      <view class="priv-item">
        <view class="priv-icon-box">🛵</view>
        <view class="priv-info">
          <view class="priv-name">自提或周边自送</view>
          <view class="priv-sub">以结算可选范围及订单状态为准</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 4. 会员状态操作管理 -->
  <view class="section-card action-card">
    <view class="menu-action-item" bindtap="navToPromote">
      <view class="action-left">
        <text class="action-emoji">📣</text>
        <view class="action-text">
          <view class="action-title">邀请街坊 · 推荐奖励</view>
          <view class="action-sub">有效订单完成后结算推荐奖励</view>
        </view>
      </view>
      <view class="arrow-right">></view>
    </view>

    <view class="menu-action-item border-top" bindtap="openAddressManager">
      <view class="action-left">
        <text class="action-emoji">📍</text>
        <view class="action-text">
          <view class="action-title">我的配送地址</view>
          <view class="action-sub">{{defaultAddressSummary || '管理周边自送地址，支持微信一键导入'}}</view>
        </view>
      </view>
      <view class="arrow-right">></view>
    </view>

    <view class="menu-action-item border-top" bindtap="contactShop">
      <view class="action-left">
        <text class="action-emoji">📞</text>
        <view class="action-text">
          <view class="action-title">联系掌柜{{config.DELIVERY_PERSON_NAME}}</view>
          <view class="action-sub">{{config.WORKSHOP_ADDRESS}} · {{config.DELIVERY_PERSON_PHONE}}</view>
        </view>
      </view>
      <view class="arrow-right">></view>
    </view>

    <view class="menu-action-item border-top" bindtap="copyShopAddress"><view class="action-left"><text class="action-emoji">📍</text><view class="action-text"><view class="action-title">复制门店自提地址</view><view class="action-sub">{{config.WORKSHOP_ADDRESS}}</view></view></view><view class="arrow-right">></view></view>
    <!-- 仅限已绑定的作坊掌柜可见 (普通用户完全隐形，绝不暴露后台入口) -->
    <view class="menu-action-item border-top" wx:if="{{userInfo && userInfo.is_admin === 1}}" bindtap="navToAdmin">
      <view class="action-left">
        <text class="action-emoji">⚙️</text>
        <view class="action-text">
          <view class="action-title">作坊后台运营控制台</view>
          <view class="action-sub">菜品库存、订单备餐与经营日报</view>
        </view>
      </view>
      <view class="arrow-right">></view>
    </view>

    <!-- 会员退出只改变权益，账号与个人信息使用独立入口 -->
    <view class="menu-action-item border-top" wx:if="{{isMember}}" bindtap="confirmExitMember">
      <view class="action-left">
        <text class="action-emoji">⚠️</text>
        <view class="action-text">
          <view class="action-title cancel-text">退出会员身份</view>
          <view class="action-sub">退出后红包清零，保留普通积分，不再自动入会</view>
        </view>
      </view>
      <view class="arrow-right">></view>
    </view>
  </view>

  <view class="section-card legal-entry" bindtap="showPrivacy">个人信息更正、清除与账号申请 ›</view>
  <view class="section-card legal-entry" bindtap="showRules">门店信息、交易规则与隐私说明 ›</view>
  <!-- 5. 底部版权与食品经营资质 (长按3秒亦可触发掌柜暗门) -->
  <view class="member-footer-info" bindlongpress="onSecretAdminTrigger">
    <text>杭州临安潘小兜食品小作坊（个体工商户）\n食品经营许可证：JY13301850326102 (含网络经营)</text>
  </view>

  <!-- 朋友圈分享指引弹窗 -->
  <view class="poster-backdrop" wx:if="{{showTimelineGuide}}">
    <view class="timeline-guide-dialog">
      <view class="timeline-guide-header">
        <text class="timeline-guide-icon">✨</text>
        <text class="timeline-guide-title">分享到微信朋友圈</text>
      </view>
      <view class="timeline-guide-body">
        <view class="guide-step-item">
          <text class="step-num">1</text>
          <text class="step-text">点击右上角胶囊菜单 <text class="highlight-capsule">「···」</text></text>
        </view>
        <view class="guide-step-item">
          <text class="step-num">2</text>
          <text class="step-text">轻触 <text class="highlight-action">「分享到朋友圈」</text> 即可发布</text>
        </view>
      </view>
      <view class="timeline-guide-tip">好友从朋友圈点开直接带上您的专属推荐信息！</view>
      <view class="timeline-guide-actions">
        <button class="btn-guide-poster btn-press" bindtap="timelineGuideToPromote">前往推广中心生成海报</button>
        <button class="btn-guide-cancel btn-press" bindtap="closeTimelineGuide">我知道了</button>
      </view>
    </view>
  </view>

  <!-- 微信个人资料获取与会员注册弹窗 -->
  <view class="poster-backdrop" wx:if="{{showProfileModal}}">
    <view class="profile-modal-dialog">
      <view class="modal-head">
        <text class="modal-title">{{!isMember && config.MEMBER_ENTRY_MODE === 'FREE' ? '填写资料 · 开通会员' : '完善个人资料'}}</text>
        <view class="modal-close" bindtap="closeProfileModal">✕</view>
      </view>
      <view class="profile-avatar-row">
        <button class="btn-choose-avatar" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image class="avatar-preview" src="{{editAvatarUrl || userInfo.avatar_url || '/images/tab_member.png'}}" mode="aspectFill" />
          <view class="avatar-cam-badge">📷</view>
        </button>
        <view class="avatar-pick-tip">点击一键选用微信头像</view>
      </view>
      <view class="profile-input-group">
        <view class="input-item">
          <text class="input-label">微信昵称</text>
          <input type="nickname" class="modal-input" placeholder="点击一键填入微信昵称" value="{{editNickname}}" bindchange="onNicknameChange" bindblur="onNicknameBlur" />
        </view>
        <view class="input-item">
          <text class="input-label">联系手机</text>
          <input type="number" maxlength="11" class="modal-input" placeholder="常用手机号（自送/提货联络）" value="{{editPhone}}" bindinput="onPhoneInput" />
        </view>
      </view>
      <view class="modal-footnote">资料手机号用于账户资料展示；订单联系人和电话请在结算时填写。</view>
      <view class="modal-btn-row">
        <button class="btn-submit-profile btn-press" loading="{{profileSubmitting}}" disabled="{{profileSubmitting}}" bindtap="submitProfileAndRegister">
          {{!isMember && config.MEMBER_ENTRY_MODE === 'FREE' ? '同步资料并免费开通会员' : '保存个人资料'}}
        </button>
      </view>
    </view>
  </view>

  <!-- 配送地址管理弹窗 -->
  <view class="poster-backdrop" wx:if="{{showAddressModal}}">
    <view class="address-manager-dialog">
      <view class="modal-head">
        <text class="modal-title">我的配送地址</text>
        <view class="modal-close" bindtap="closeAddressManager">✕</view>
      </view>
      <view class="address-quick-actions">
        <button size="mini" class="btn-import-wx btn-press" bindtap="importWechatAddress">
          <text class="btn-icon">📥</text> 微信导入
        </button>
        <button size="mini" class="btn-location-add btn-press" bindtap="chooseLocationForAddAddress">
          <text class="btn-icon">📍</text> 地图定位
        </button>
        <button size="mini" class="btn-add-new btn-press" bindtap="openAddAddressModal">
          <text class="btn-icon">＋</text> 手动新增
        </button>
      </view>
      <scroll-view scroll-y="true" class="address-scroll-list">
        <view wx:if="{{!addressList.length}}" class="address-empty-box">
          <text class="empty-icon">📍</text>
          <text class="empty-text">暂无保存的配送地址</text>
          <text class="empty-sub">支持点击上方按钮直接从微信导入</text>
        </view>
        <view class="address-card-item {{item.is_default ? 'is-default' : ''}}" wx:for="{{addressList}}" wx:key="id">
          <view class="addr-item-main">
            <view class="addr-user-line">
              <text class="addr-user-name">{{item.name}}</text>
              <text class="addr-user-phone">{{item.phone}}</text>
              <text class="addr-badge-default" wx:if="{{item.is_default}}">默认</text>
            </view>
            <view class="addr-detail-text">{{item.area ? item.area + ' ' : ''}}{{item.detail}}</view>
          </view>
          <view class="addr-action-bar">
            <view class="addr-default-trigger" data-id="{{item.id}}" bindtap="onSetDefaultAddress">
              <text class="radio-circle {{item.is_default ? 'checked' : ''}}"></text>
              <text class="radio-label">{{item.is_default ? '默认地址' : '设为默认'}}</text>
            </view>
            <view class="addr-edit-btns">
              <text class="addr-btn-edit" data-id="{{item.id}}" bindtap="openEditAddressModal">编辑</text>
              <text class="addr-btn-del" data-id="{{item.id}}" bindtap="onDeleteAddress">删除</text>
            </view>
          </view>
        </view>
      </scroll-view>
      <button class="btn-dialog-done btn-press" bindtap="closeAddressManager">完成</button>
    </view>
  </view>

  <!-- 新增/编辑配送地址表单弹窗 -->
  <view class="poster-backdrop" wx:if="{{showAddressEditModal}}">
    <view class="address-edit-dialog">
      <view class="modal-head">
        <text class="modal-title">{{addressForm.id ? '编辑配送地址' : '新增配送地址'}}</text>
        <view class="modal-close" bindtap="closeAddressEditModal">✕</view>
      </view>
      <view class="address-form-box">
        <view class="form-row">
          <text class="form-label">收件人</text>
          <input class="form-input" placeholder="姓名（必填）" value="{{addressForm.name}}" data-field="name" bindinput="onAddressFormInput" />
        </view>
        <view class="form-row">
          <text class="form-label">手机号码</text>
          <input class="form-input" type="number" maxlength="11" placeholder="11位手机号（必填）" value="{{addressForm.phone}}" data-field="phone" bindinput="onAddressFormInput" />
        </view>
        <view class="form-row">
          <view class="form-label-bar">
            <text class="form-label">所在小区/区域</text>
            <text class="form-link-locate" bindtap="chooseLocationForForm">📍 地图定位</text>
          </view>
          <input class="form-input" placeholder="如：锦城街道/春天花园" value="{{addressForm.area}}" data-field="area" bindinput="onAddressFormInput" />
        </view>
        <view class="form-row">
          <view class="form-label-bar">
            <text class="form-label">详细地址</text>
          </view>
          <input class="form-input" placeholder="楼幢、门牌号（如：5幢302）" value="{{addressForm.detail}}" data-field="detail" bindinput="onAddressFormInput" />
        </view>
        <view class="form-row form-row-switch">
          <text class="form-label">设为默认地址</text>
          <switch checked="{{addressForm.is_default}}" color="#D9480F" bindchange="onAddressDefaultSwitch" />
        </view>
      </view>
      <view class="modal-btn-row">
        <button class="btn-submit-profile btn-press" loading="{{addressSaving}}" disabled="{{addressSaving}}" bindtap="saveAddressRecord">保存地址</button>
      </view>
    </view>
  </view>

</view>
