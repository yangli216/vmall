/* miniprogram/pages/member/member.wxss */
.container {
  padding: 24rpx;
  background-color: #F8F9FA;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
}

/* 1. 会员卡片主视觉 */
.member-hero-card {
  position: relative;
  overflow: hidden;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  background: #FFFFFF;
  border: 1.5rpx solid rgba(217, 72, 15, 0.12);
  box-shadow: 0 10rpx 28rpx rgba(180, 83, 9, 0.06);
  margin-bottom: 24rpx;
}

.member-hero-card.vip {
  background: linear-gradient(135deg, #FFFDF8 0%, #FFF8EE 100%);
  border: 1.5rpx solid rgba(180, 83, 9, 0.25);
  box-shadow: 0 12rpx 32rpx rgba(180, 83, 9, 0.10);
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.user-meta-pack {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar-wrap {
  position: relative;
  width: 108rpx;
  height: 108rpx;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 54rpx;
  background-color: #F1F3F5;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.vip-crown-badge {
  position: absolute;
  top: -12rpx;
  right: -8rpx;
  font-size: 32rpx;
}

.user-text-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.nickname-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.user-nickname {
  font-size: 34rpx;
  font-weight: 700;
  color: #1F2937;
  max-width: 280rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 14rpx;
  font-weight: 600;
  white-space: nowrap;
  flex-shrink: 0;
}

.member-tag.vip-pill {
  background: linear-gradient(135deg, #B45309, #D9480F);
  color: #FFFFFF;
}

.member-tag.normal-pill {
  background: #E9ECEF;
  color: #495057;
}

.bind-referrer-hint {
  font-size: 24rpx;
  color: #6B7280;
}

/* 进度条 */
.member-level-progress {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx dashed rgba(0, 0, 0, 0.08);
}

.progress-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  margin-bottom: 12rpx;
}

.progress-title {
  color: #4B5563;
}

.progress-val {
  font-weight: 700;
  color: #D9480F;
}

.progress-bar-track {
  width: 100%;
  height: 12rpx;
  background-color: #E5E7EB;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #F59E0B, #D9480F);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.upgrade-action-row {
  margin-top: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.free-tip {
  font-size: 24rpx;
  color: #B45309;
}

.btn-free-upgrade {
  font-size: 24rpx;
  background: linear-gradient(135deg, #D9480F, #B45309);
  color: #FFFFFF;
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
  margin: 0;
  line-height: 1.5;
}

.member-vip-valid {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed rgba(180, 83, 9, 0.2);
}

.valid-text {
  font-size: 22rpx;
  color: #92400E;
  font-weight: 500;
}

/* 2. 双积分账户看板 */
.points-board-grid {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.point-account-card {
  flex: 1;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #E5E7EB;
  display: flex;
  flex-direction: column;
}

.point-account-card.red-theme {
  border-color: rgba(217, 72, 15, 0.2);
  background: #FFFAF8;
}

.point-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.point-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #1F2937;
}

.point-name.red {
  color: #D9480F;
}

.point-desc {
  font-size: 20rpx;
  color: #9CA3AF;
}

.point-desc.red {
  color: #F87171;
}

.point-value-row {
  margin: 10rpx 0;
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.point-num {
  font-size: 44rpx;
  font-weight: 800;
  color: #111827;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.point-num.red {
  color: #D9480F;
}

.point-unit {
  font-size: 22rpx;
  color: #6B7280;
}

.point-rule-tip {
  font-size: 20rpx;
  color: #6B7280;
  line-height: 1.4;
  margin-top: auto;
}

/* 3. 会员专享四大特权 */
.section-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #E5E7EB;
}

.section-title {
  margin-bottom: 24rpx;
}

.title-h3 {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2937;
  margin-right: 12rpx;
}

.title-sub {
  font-size: 22rpx;
  color: #9CA3AF;
}

.privilege-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.priv-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #F9FAFB;
  padding: 20rpx 16rpx;
  border-radius: 16rpx;
}

.priv-icon-box {
  font-size: 40rpx;
  width: 56rpx;
  text-align: center;
}

.priv-info {
  display: flex;
  flex-direction: column;
}

.priv-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #1F2937;
}

.priv-sub {
  font-size: 20rpx;
  color: #6B7280;
  margin-top: 4rpx;
}

/* 4. 操作列表卡片 */
.action-card {
  padding: 10rpx 24rpx;
}

.menu-action-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
}

.menu-action-item.border-top {
  border-top: 1rpx solid #F3F4F6;
}

.action-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.action-emoji {
  font-size: 36rpx;
}

.action-text {
  display: flex;
  flex-direction: column;
}

.action-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
}

.action-title.cancel-text {
  color: #DC2626;
}

.action-sub {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 4rpx;
}

.arrow-right {
  font-size: 28rpx;
  color: #D1D5DB;
}

/* 5. 底部资质 */
.member-footer-info {
  text-align: center;
  font-size: 20rpx;
  color: #9CA3AF;
  line-height: 1.6;
  margin-top: 20rpx;
}

/* 街坊会员：清晰的身份、资产与服务层级 */
.container { background: #F6F4F0; }
.container { padding: 28rpx; }
.test-account-panel { padding: 22rpx; margin-bottom: 24rpx; border-radius: 16rpx; background: #EEEAE3; color: #7C6D5D; font-size: 23rpx; line-height: 1.6; }
.test-account-actions { display: flex; gap: 10rpx; margin-top: 14rpx; }
.test-account-actions button { margin: 0; flex: 1; padding: 0 8rpx; font-size: 23rpx; }
.member-hero-card { padding: 32rpx 28rpx; border: 1rpx solid #E7DFD3; border-radius: 26rpx; box-shadow: none; }
.member-hero-card.normal { background: #FFFEFA; }
.member-hero-card.vip { background: linear-gradient(120deg,#F8EACC,#F1D9AC); }
.user-meta-pack { gap: 22rpx; }
.avatar-wrap { flex-shrink: 0; }
.user-text-info { min-width: 0; flex: 1; }
.nickname-row { flex-wrap: wrap; gap: 8rpx; align-items: center; }
.user-nickname { font-size: 34rpx; font-weight: 600; overflow-wrap: anywhere; }
.member-tag { font-size: 21rpx; white-space: nowrap; }
.bind-referrer-hint { font-size: 23rpx; line-height: 1.6; margin-top: 10rpx; color: #8D7A66; }
.member-level-progress { margin-top: 26rpx; padding-top: 22rpx; border-top: 1rpx solid #EBE5DB; }
.progress-info-row { gap: 12rpx; flex-wrap: wrap; font-size: 24rpx; line-height: 1.7; }
.progress-title { color: #766655; }
.progress-val { font-size: 24rpx; font-weight: 600; color: #A14725; }
.progress-bar-track { height: 8rpx; background: #EEE7DC; }
.progress-bar-fill { background: #B67A43; }
.asset-heading { display: flex; justify-content: space-between; align-items: center; margin: 32rpx 2rpx 18rpx; font-size: 28rpx; font-weight: 600; color: #3F3429; }
.asset-detail { font-size: 23rpx; font-weight: 400; color: #9A7F66; }
.points-board-grid { gap: 18rpx; }
.point-account-card { min-width: 0; padding: 28rpx 24rpx; border-color: #EAE5DF; border-radius: 22rpx; box-shadow: none; }
.point-account-card.red-theme { background: #FCF2EA; border-color: #EEDDD0; }
.point-card-header { display: flex; flex-direction: column; align-items: flex-start; gap: 8rpx; margin-bottom: 12rpx; }
.point-name { font-size: 28rpx; font-weight: 600; }
.point-name.red,.point-num.red { color: #AF4725; }
.point-desc,.point-desc.red { font-size: 22rpx; color: #998675; }
.point-num { font-size: 48rpx; font-weight: 650; overflow-wrap: anywhere; }
.point-rule-tip { font-size: 23rpx; line-height: 1.7; color: #8A7C6E; padding-top: 12rpx; }
.section-card { border-color: #EAE5DF; border-radius: 22rpx; box-shadow: none; padding: 28rpx; }
.section-title { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8rpx; margin-bottom: 24rpx; }
.title-h3 { font-size: 30rpx; font-weight: 600; color: #3F3429; }
.title-sub { font-size: 22rpx; color: #9A8B7D; }
.privilege-grid { gap: 16rpx; grid-template-columns: repeat(2,minmax(0,1fr)); }
.priv-item { display: flex; flex-direction: column; align-items: flex-start; gap: 12rpx; padding: 24rpx 20rpx; background: #F8F6F2; }
.priv-icon-box { width: auto; font-size: 32rpx; }
.priv-name { font-size: 26rpx; font-weight: 600; }
.priv-sub { font-size: 22rpx; line-height: 1.65; color: #918171; }
.action-card { padding: 0 28rpx; }
.menu-action-item { padding: 28rpx 0; gap: 16rpx; }
.action-left { min-width: 0; flex: 1; gap: 20rpx; }
.action-emoji { flex-shrink: 0; font-size: 32rpx; }
.action-text { min-width: 0; }
.action-title { font-size: 28rpx; font-weight: 500; line-height: 1.6; }
.action-sub { font-size: 23rpx; line-height: 1.6; color: #958575; overflow-wrap: anywhere; }
.arrow-right { flex-shrink: 0; color: #AC9E90; }
.legal-entry { font-size: 25rpx; color: #8B7967; line-height: 1.7; padding: 24rpx 28rpx; }
.member-footer-info { font-size: 21rpx; line-height: 1.8; color: #A49789; }
.upgrade-action-row { flex-wrap: wrap; gap: 20rpx; }

/* 会员专属推荐好友快捷卡片 */
.member-referral-card {
  background: linear-gradient(135deg, #FFFDF9 0%, #FFF5EB 100%);
  border: 1.5rpx solid rgba(217, 72, 15, 0.2);
  border-radius: 22rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
}
.referral-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}
.referral-header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.referral-tag {
  background: rgba(217, 72, 15, 0.12);
  color: #D9480F;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.referral-title {
  font-size: 27rpx;
  font-weight: 700;
  color: #3F3429;
}
.referral-more-link {
  font-size: 23rpx;
  color: #D9480F;
  font-weight: 500;
}
.member-code-bar {
  background: #FFFFFF;
  border: 1rpx solid #EBE5DB;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.member-code-label {
  font-size: 24rpx;
  color: #8C7B6B;
}
.member-code-text {
  font-size: 30rpx;
  font-weight: 800;
  color: #AF4725;
  letter-spacing: 1rpx;
}
.member-code-copy {
  font-size: 22rpx;
  background: #FFF1E6;
  color: #D9480F;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 600;
}
.member-share-btn-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.member-share-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 18rpx 0;
  border-radius: 14rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.4;
  border: 0;
  margin: 0;
}
.member-share-btn .btn-emoji {
  font-size: 28rpx;
}
.member-share-btn.btn-share-wx {
  background: linear-gradient(135deg, #07C160 0%, #059669 100%);
  color: #FFFFFF !important;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.2);
}
.member-share-btn.btn-share-pyq {
  background: linear-gradient(135deg, #F97316 0%, #D9480F 100%);
  color: #FFFFFF !important;
  box-shadow: 0 4rpx 12rpx rgba(217, 72, 15, 0.2);
}

/* 朋友圈引导弹窗通用样式 */
.poster-backdrop {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
}
.timeline-guide-dialog {
  width: 100%;
  max-width: 620rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  box-sizing: border-box;
  text-align: center;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.16);
}
.timeline-guide-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 28rpx;
}
.timeline-guide-icon {
  font-size: 36rpx;
}
.timeline-guide-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1F2937;
}
.timeline-guide-body {
  background: #FFF9F3;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  text-align: left;
}
.guide-step-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}
.guide-step-item .step-num {
  width: 38rpx;
  height: 38rpx;
  border-radius: 19rpx;
  background: #D9480F;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.guide-step-item .step-text {
  font-size: 26rpx;
  line-height: 1.6;
  color: #4B5563;
}
.highlight-capsule {
  color: #111827;
  font-weight: 700;
  background: #E5E7EB;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}
.highlight-action {
  color: #D9480F;
  font-weight: 700;
}
.timeline-guide-tip {
  font-size: 23rpx;
  color: #9CA3AF;
  line-height: 1.5;
  margin-bottom: 28rpx;
}
.timeline-guide-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.btn-guide-poster {
  background: linear-gradient(135deg, #F97316 0%, #D9480F 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 18rpx;
  padding: 20rpx 0;
  border: 0;
  margin: 0;
}
.btn-guide-cancel {
  background: #F3F4F6;
  color: #4B5563;
  font-size: 26rpx;
  border-radius: 18rpx;
  padding: 18rpx 0;
  border: 0;
  margin: 0;
}
