/* miniprogram/pages/promote/promote.wxss */
.container {
  padding: 24rpx;
  background-color: #F8F9FA;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
}

/* 1. 邀请卡片 */
.invite-hero-card {
  background: linear-gradient(135deg, #FFFDF9 0%, #FFF5EB 100%);
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  border: 1.5rpx solid rgba(217, 72, 15, 0.2);
  box-shadow: 0 10rpx 28rpx rgba(217, 72, 15, 0.08);
  margin-bottom: 24rpx;
}

.invite-card-tag {
  display: inline-block;
  background: rgba(217, 72, 15, 0.1);
  color: #D9480F;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.hero-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #1F2937;
  margin-bottom: 8rpx;
}

.hero-sub {
  font-size: 24rpx;
  color: #6B7280;
  margin-bottom: 28rpx;
}

.invite-code-box {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border: 1rpx solid #E5E7EB;
  margin-bottom: 28rpx;
}

.code-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.code-label {
  font-size: 20rpx;
  color: #9CA3AF;
}

.code-value {
  font-size: 40rpx;
  font-weight: 800;
  color: #D9480F;
  letter-spacing: 2rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.invite-code-box .btn-copy-code {
  font-size: 24rpx;
  background: #FFF1E6;
  color: #D9480F;
  border: 1rpx solid rgba(217, 72, 15, 0.3);
  border-radius: 20rpx;
  padding: 10rpx 24rpx;
  margin: 0;
  font-weight: 600;
}

.share-actions-row {
  display: flex;
  gap: 20rpx;
}

.share-actions-row .btn-share-wx {
  flex: 1.2;
  background: linear-gradient(135deg, #07C160, #059669);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 24rpx;
  padding: 18rpx 0;
  margin: 0;
  line-height: 1.4;
}

.share-actions-row .btn-share-poster {
  flex: 1;
  background: #FFFFFF;
  color: #374151;
  border: 1rpx solid #D1D5DB;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 24rpx;
  padding: 18rpx 0;
  margin: 0;
  line-height: 1.4;
}

/* 2. 试算器卡片 */
.calc-section-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #E5E7EB;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.calc-header {
  margin-bottom: 24rpx;
}

.calc-title-h3 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2937;
  margin-bottom: 8rpx;
}

.badge-ratio {
  font-size: 20rpx;
  background: #FFF1E6;
  color: #D9480F;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  font-weight: 600;
}

.calc-intro-p {
  font-size: 22rpx;
  color: #9CA3AF;
}

.slider-block {
  margin-bottom: 20rpx;
}

.slider-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  margin-bottom: 6rpx;
}

.slider-title {
  color: #4B5563;
}

.slider-num {
  font-weight: 700;
  color: #111827;
}

.slider-num.red {
  color: #D9480F;
}

/* 公式与结果卡片 */
.formula-result-card {
  background: #F9FAFB;
  border-radius: 18rpx;
  padding: 24rpx;
  margin-top: 24rpx;
  border: 1rpx solid #E5E7EB;
}

.formula-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  margin-bottom: 12rpx;
  gap: 12rpx;
}

.f-label {
  color: #4B5563;
  flex-shrink: 0;
  white-space: nowrap;
}

.f-calc {
  color: #374151;
  font-weight: 500;
  white-space: nowrap;
}

.highlight {
  font-weight: 700;
  color: #111827;
}

.f-result {
  color: #374151;
  font-weight: 500;
}

.final-earn {
  font-size: 30rpx;
  font-weight: 800;
  color: #D9480F;
}

.anti-fraud-alert {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #E5E7EB;
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
}

.alert-icon {
  font-size: 26rpx;
}

.alert-text {
  font-size: 20rpx;
  color: #B45309;
  line-height: 1.45;
}

/* 3. 统计网格 */
.stats-overview-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  flex: 1;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  border: 1rpx solid #E5E7EB;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
}

.stat-num {
  font-size: 36rpx;
  font-weight: 800;
  color: #111827;
  margin-bottom: 6rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.stat-num.red {
  color: #D9480F;
}

.stat-label {
  font-size: 20rpx;
  color: #6B7280;
}

/* 4. 好友列表 */
.referral-list-section {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  border: 1rpx solid #E5E7EB;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.list-section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.list-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1F2937;
}

.list-total {
  font-size: 22rpx;
  color: #9CA3AF;
}

.empty-list-box {
  text-align: center;
  padding: 40rpx 0;
}

.empty-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.empty-text {
  font-size: 24rpx;
  color: #9CA3AF;
}

.referrals-feed {
  display: flex;
  flex-direction: column;
}

.referral-row-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
  gap: 20rpx;
}

.referral-row-item:last-child {
  border-bottom: none;
}

.ref-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 38rpx;
  background: #F3F4F6;
}

.ref-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.ref-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.ref-nickname {
  font-size: 26rpx;
  font-weight: 600;
  color: #1F2937;
}

.ref-vip-badge {
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  background: #FFF1E6;
  color: #D9480F;
  border-radius: 8rpx;
}

.ref-date {
  font-size: 20rpx;
  color: #9CA3AF;
}

.ref-reward-col {
  text-align: right;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.reward-title {
  font-size: 18rpx;
  color: #9CA3AF;
}

.reward-amount {
  font-size: 28rpx;
  font-weight: 700;
  color: #D9480F;
}
.poster-canvas { position:fixed; left:-10000px; top:0; width:750px; height:1160px; }
.poster-backdrop { position:fixed; top:0; right:0; bottom:0; left:0; z-index:1000; background:rgba(0,0,0,.6); display:flex; align-items:center; justify-content:center; padding:32rpx; }
.poster-dialog { width:100%; max-height:85vh; overflow-y:auto; box-sizing:border-box; border-radius:24rpx; padding:28rpx; background:#fff8ef; }
.poster-heading { font-size:34rpx; font-weight:600; text-align:center; margin-bottom:20rpx; }
.poster-preview { width:100%; display:block; }
.poster-note { font-size:25rpx; color:#65574f; line-height:1.6; margin:20rpx 0; }
.poster-action { width:100% !important; margin:16rpx 0 0; padding:14rpx 20rpx; font-size:26rpx; line-height:1.5; color:#fff; background:#bb4c1b; }
.poster-close { color:#675e58; background:#fff; border:1rpx solid #ded6cb; }
.share-actions-row { flex-wrap:wrap; }

/* 街坊邀请：明确奖励性质，分享主按钮独占一行 */
.container { background: #F6F4F0; }
.container { padding: 28rpx; }
.invite-hero-card { padding: 34rpx 28rpx; background: #FFFDF8; border: 1rpx solid #E8DAC5; border-radius: 26rpx; box-shadow: none; }
.invite-card-tag { background: #EEE4D3; color: #96704A; border-radius: 8rpx; font-size: 22rpx; padding: 8rpx 14rpx; font-weight: 500; }
.hero-title { font-size: 40rpx; font-weight: 600; line-height: 1.4; color: #443424; margin: 14rpx 0; }
.hero-sub { font-size: 25rpx; line-height: 1.8; color: #9B8269; margin-bottom: 28rpx; }
.invite-code-box { padding: 24rpx; border-radius: 16rpx; background: #F7F2E9; border: 0; gap: 16rpx; }
.code-left { flex: 1; min-width: 0; }
.code-label { font-size: 22rpx; color: #A18D76; }
.code-value { font-size: 40rpx; font-weight: 650; color: #A44A28; overflow-wrap: anywhere; }
.invite-code-box .btn-copy-code { font-size: 23rpx; padding: 12rpx 18rpx; line-height: 1.7; border-radius: 10rpx; background: #fff; color: #8E6040; border: 0; flex-shrink: 0; }
.share-actions-row { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 14rpx; }
.share-actions-row .btn-share-wx { box-sizing: border-box; min-width: 0; grid-column: 1 / -1; width: 100%; background: #3D6451; border-radius: 14rpx; padding: 24rpx 0; font-size: 28rpx; font-weight: 500; line-height: 1.5; }
.share-actions-row .btn-share-poster { box-sizing: border-box; width: 100%; min-width: 0; background: transparent; color: #8A6D51; border-color: #E3D7C6; border-radius: 14rpx; padding: 20rpx 8rpx; line-height: 1.5; font-size: 24rpx; }
.calc-section-card,.referral-list-section { padding: 28rpx; border-radius: 22rpx; border-color: #EAE5DF; box-shadow: none; }
.calc-title-h3 { gap: 16rpx; flex-wrap: wrap; font-size: 30rpx; font-weight: 600; color: #443424; line-height: 1.5; }
.badge-ratio { flex-shrink: 0; background: #F7EDE2; color: #A26F45; border-radius: 8rpx; font-size: 22rpx; }
.calc-intro-p { font-size: 23rpx; color: #9C8B7B; line-height: 1.8; }
.slider-block { margin-top: 32rpx; }
.slider-label-row { gap: 16rpx; font-size: 25rpx; line-height: 1.5; }
.slider-num { flex-shrink: 0; }
.formula-result-card { padding: 24rpx; background: #F7F4EF; border: 0; border-radius: 16rpx; }
.formula-line { flex-direction: column; align-items: flex-start; gap: 10rpx; margin-bottom: 24rpx; font-size: 25rpx; line-height: 1.7; }
.f-label { white-space: normal; color: #998371; font-size: 23rpx; }
.f-calc,.f-result { white-space: normal; overflow-wrap: anywhere; color: #66503D; }
.final-earn { font-size: 36rpx; font-weight: 650; color: #AF4725; }
.alert-text { font-size: 22rpx; line-height: 1.8; color: #9B8065; }
.stats-overview-grid { gap: 12rpx; }
.stat-card { min-width: 0; padding: 28rpx 12rpx; border-color: #EAE5DF; border-radius: 18rpx; box-shadow: none; }
.stat-num { font-size: 33rpx; font-weight: 650; overflow-wrap: anywhere; }
.stat-num.red { color: #AF4725; }
.stat-label { font-size: 22rpx; line-height: 1.7; color: #9A8775; }
.list-title { font-size: 29rpx; font-weight: 600; }
.ref-info { min-width: 0; }
.ref-avatar { flex-shrink: 0; }
.ref-name-row { flex-wrap: wrap; }
.ref-nickname { overflow-wrap: anywhere; }
.ref-reward-col { flex-shrink: 0; }
.ref-date,.reward-title { font-size: 21rpx; line-height: 1.7; }
.empty-text { font-size: 25rpx; line-height: 1.8; color: #9B8978; }

/* 微信个人与朋友圈双渠道分享增强 */
.share-actions-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 14rpx;
}
.btn-share-channel {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 22rpx 12rpx;
  border-radius: 16rpx;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.4;
  border: 0;
  margin: 0;
}
.btn-share-channel .btn-icon {
  font-size: 32rpx;
}
.btn-share-wx {
  background: linear-gradient(135deg, #07C160 0%, #059669 100%);
  color: #FFFFFF !important;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.25);
}
.btn-share-pyq {
  background: linear-gradient(135deg, #F97316 0%, #D9480F 100%);
  color: #FFFFFF !important;
  box-shadow: 0 4rpx 12rpx rgba(217, 72, 15, 0.25);
}
.share-secondary-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.btn-sec-action {
  box-sizing: border-box;
  width: 100% !important;
  background: #FFFFFF;
  color: #785A3E !important;
  border: 1rpx solid #E3D7C6 !important;
  border-radius: 14rpx;
  padding: 16rpx 8rpx !important;
  font-size: 23rpx !important;
  font-weight: 500;
  line-height: 1.5;
  margin: 0 !important;
}

/* 新客/未入会友好展示横幅 */
.guest-invite-banner {
  background: #FFFDF8;
  border: 1rpx solid #E8DAC5;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  text-align: center;
}
.guest-banner-tag {
  display: inline-block;
  background: #F7EDE2;
  color: #A26F45;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  margin-bottom: 14rpx;
}
.guest-banner-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #443424;
  margin-bottom: 8rpx;
}
.guest-banner-sub {
  font-size: 24rpx;
  color: #8C7B6B;
  line-height: 1.6;
  margin-bottom: 24rpx;
}
.btn-guest-order {
  background: #AF4725;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 16rpx;
  padding: 20rpx 0;
  border: 0;
}

/* 朋友圈指引弹窗 */
.timeline-guide-dialog {
  width: 100%;
  max-width: 620rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  box-sizing: border-box;
  text-align: center;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.16);
}
.timeline-guide-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 28rpx;
}
.timeline-guide-icon {
  font-size: 36rpx;
}
.timeline-guide-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1F2937;
}
.timeline-guide-body {
  background: #FFF9F3;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  text-align: left;
}
.guide-step-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}
.guide-step-item .step-num {
  width: 38rpx;
  height: 38rpx;
  border-radius: 19rpx;
  background: #D9480F;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.guide-step-item .step-text {
  font-size: 26rpx;
  line-height: 1.6;
  color: #4B5563;
}
.highlight-capsule {
  color: #111827;
  font-weight: 700;
  background: #E5E7EB;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}
.highlight-action {
  color: #D9480F;
  font-weight: 700;
}
.timeline-guide-tip {
  font-size: 23rpx;
  color: #9CA3AF;
  line-height: 1.5;
  margin-bottom: 28rpx;
}
.timeline-guide-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.btn-guide-poster {
  background: linear-gradient(135deg, #F97316 0%, #D9480F 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 18rpx;
  padding: 20rpx 0;
  border: 0;
  margin: 0;
}
.btn-guide-cancel {
  background: #F3F4F6;
  color: #4B5563;
  font-size: 26rpx;
  border-radius: 18rpx;
  padding: 18rpx 0;
  border: 0;
  margin: 0;
}

/* 两个分享入口在窄屏下保持同宽 */
.share-actions-row .btn-share-channel { grid-column: 1 / -1; width: 100% !important; box-sizing: border-box; }
