/* miniprogram/pages/promote/promote.wxss */
.container {
  padding: 24rpx;
  background-color: #F8F9FA;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
}

/* 1. 邀请卡片 */
.invite-hero-card {
  background: linear-gradient(135deg, #FFFDF9 0%, #FFF5EB 100%);
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  border: 1.5rpx solid rgba(217, 72, 15, 0.2);
  box-shadow: 0 10rpx 28rpx rgba(217, 72, 15, 0.08);
  margin-bottom: 24rpx;
}

.invite-card-tag {
  display: inline-block;
  background: rgba(217, 72, 15, 0.1);
  color: #D9480F;
  font-size: 20rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.hero-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #1F2937;
  margin-bottom: 8rpx;
}

.hero-sub {
  font-size: 24rpx;
  color: #6B7280;
  margin-bottom: 28rpx;
}

.invite-code-box {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border: 1rpx solid #E5E7EB;
  margin-bottom: 28rpx;
}

.code-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.code-label {
  font-size: 20rpx;
  color: #9CA3AF;
}

.code-value {
  font-size: 40rpx;
  font-weight: 800;
  color: #D9480F;
  letter-spacing: 2rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.btn-copy-code {
  font-size: 24rpx;
  background: #FFF1E6;
  color: #D9480F;
  border: 1rpx solid rgba(217, 72, 15, 0.3);
  border-radius: 20rpx;
  padding: 10rpx 24rpx;
  margin: 0;
  font-weight: 600;
}

.share-actions-row {
  display: flex;
  gap: 20rpx;
}

.btn-share-wx {
  flex: 1.2;
  background: linear-gradient(135deg, #07C160, #059669);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 24rpx;
  padding: 18rpx 0;
  margin: 0;
  line-height: 1.4;
}

.btn-share-poster {
  flex: 1;
  background: #FFFFFF;
  color: #374151;
  border: 1rpx solid #D1D5DB;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 24rpx;
  padding: 18rpx 0;
  margin: 0;
  line-height: 1.4;
}

/* 2. 试算器卡片 */
.calc-section-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #E5E7EB;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.calc-header {
  margin-bottom: 24rpx;
}

.calc-title-h3 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2937;
  margin-bottom: 8rpx;
}

.badge-ratio {
  font-size: 20rpx;
  background: #FFF1E6;
  color: #D9480F;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  font-weight: 600;
}

.calc-intro-p {
  font-size: 22rpx;
  color: #9CA3AF;
}

.slider-block {
  margin-bottom: 20rpx;
}

.slider-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  margin-bottom: 6rpx;
}

.slider-title {
  color: #4B5563;
}

.slider-num {
  font-weight: 700;
  color: #111827;
}

.slider-num.red {
  color: #D9480F;
}

/* 公式与结果卡片 */
.formula-result-card {
  background: #F9FAFB;
  border-radius: 18rpx;
  padding: 24rpx;
  margin-top: 24rpx;
  border: 1rpx solid #E5E7EB;
}

.formula-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  margin-bottom: 12rpx;
  gap: 12rpx;
}

.f-label {
  color: #4B5563;
  flex-shrink: 0;
  white-space: nowrap;
}

.f-calc {
  color: #374151;
  font-weight: 500;
  white-space: nowrap;
}

.highlight {
  font-weight: 700;
  color: #111827;
}

.f-result {
  color: #374151;
  font-weight: 500;
}

.final-earn {
  font-size: 30rpx;
  font-weight: 800;
  color: #D9480F;
}

.anti-fraud-alert {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #E5E7EB;
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
}

.alert-icon {
  font-size: 26rpx;
}

.alert-text {
  font-size: 20rpx;
  color: #B45309;
  line-height: 1.45;
}

/* 3. 统计网格 */
.stats-overview-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  flex: 1;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  border: 1rpx solid #E5E7EB;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
}

.stat-num {
  font-size: 36rpx;
  font-weight: 800;
  color: #111827;
  margin-bottom: 6rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.stat-num.red {
  color: #D9480F;
}

.stat-label {
  font-size: 20rpx;
  color: #6B7280;
}

/* 4. 好友列表 */
.referral-list-section {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  border: 1rpx solid #E5E7EB;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.list-section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.list-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1F2937;
}

.list-total {
  font-size: 22rpx;
  color: #9CA3AF;
}

.empty-list-box {
  text-align: center;
  padding: 40rpx 0;
}

.empty-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.empty-text {
  font-size: 24rpx;
  color: #9CA3AF;
}

.referrals-feed {
  display: flex;
  flex-direction: column;
}

.referral-row-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
  gap: 20rpx;
}

.referral-row-item:last-child {
  border-bottom: none;
}

.ref-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 38rpx;
  background: #F3F4F6;
}

.ref-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.ref-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.ref-nickname {
  font-size: 26rpx;
  font-weight: 600;
  color: #1F2937;
}

.ref-vip-badge {
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  background: #FFF1E6;
  color: #D9480F;
  border-radius: 8rpx;
}

.ref-date {
  font-size: 20rpx;
  color: #9CA3AF;
}

.ref-reward-col {
  text-align: right;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.reward-title {
  font-size: 18rpx;
  color: #9CA3AF;
}

.reward-amount {
  font-size: 28rpx;
  font-weight: 700;
  color: #D9480F;
}
