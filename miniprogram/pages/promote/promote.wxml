<!-- miniprogram/pages/promote/promote.wxml -->
<view class="container">
 <dev-banner />

  <!-- 1. 邀请码尊享卡片 -->
  <view class="invite-hero-card">
    <view class="invite-card-tag">街坊有礼 · 会员专享</view>
    <view class="hero-title">好卤味，和街坊一起享</view>
    <view class="hero-sub">有效会员邀请好友消费，收货后按有效货款 {{commissionRatePercent}}% 获得奖励</view>

    <!-- 邀请码展示与复制 -->
    <view class="invite-code-box">
      <view class="code-left">
        <text class="code-label">专属邀请码</text>
        <text class="code-value">{{myReferralCode}}</text>
      </view>
      <button size="mini" class="btn-copy-code btn-press" bindtap="copyCode">复制邀请码</button>
    </view>

    <!-- 分享操作按钮组 -->
    <view wx:if="{{isMember}}" class="share-actions-row">
      <button size="mini" class="btn-share-wx btn-press" open-type="share">
        分享给微信好友
      </button>
      <button size="mini" class="btn-share-poster btn-press" bindtap="showPosterTip">
        查看邀请规则
      </button>
      <button size="mini" class="btn-share-poster btn-press" bindtap="generatePoster" disabled="{{posterGenerating}}" loading="{{posterGenerating}}">生成邀请海报</button>
    </view>
  </view>

<view wx:if="{{!isMember}}" class="empty-list-box">成为有效会员后可获得推荐奖励</view>
  <canvas type="2d" id="referralPosterCanvas" class="poster-canvas"></canvas>
  <view class="poster-backdrop" wx:if="{{showPoster}}">
    <view class="poster-dialog">
      <view class="poster-heading">专属邀请海报</view>
      <view wx:if="{{posterGenerating}}" class="poster-note">正在生成小程序码和海报…</view>
      <view wx:if="{{posterError}}" class="poster-note">{{posterError}}</view>
      <image wx:if="{{posterPath}}" class="poster-preview" src="{{posterPath}}" mode="widthFix" bindtap="previewPoster" />
      <view class="poster-note" wx:if="{{posterPath}}">点击图片可放大预览，长按识别小程序码。好友仅在首次下单前可绑定推荐人。</view>
      <button wx:if="{{posterPath}}" bindtap="savePoster" loading="{{posterSaving}}" disabled="{{posterSaving}}">保存到相册</button>
      <button wx:if="{{posterError}}" bindtap="generatePoster">重新生成</button>
      <button bindtap="closePoster" disabled="{{posterSaving}}">关闭</button>
    </view>
  </view>
  <!-- 2. 推荐奖励示意测算 -->
  <view class="calc-section-card">
    <view class="calc-header">
      <view class="calc-title-h3">
        <text>推荐红包怎么算</text>
        <text class="badge-ratio">{{commissionRatePercent}}% 奖励比例</text>
      </view>
      <view class="calc-intro-p">拖动滑块查看好友不同付款场景下的红包积分收益</view>
    </view>

    <!-- 好友订单原价 -->
    <view class="slider-block">
      <view class="slider-label-row">
        <text class="slider-title">好友订单消费金额</text>
        <text class="slider-num">¥{{simOrderAmount}}</text>
      </view>
      <slider 
        min="20" 
        max="300" 
        step="10" 
        value="{{simOrderAmount}}" 
        activeColor="#D9480F" 
        block-color="#D9480F" 
        bindchanging="onSimOrderChange" 
        bindchange="onSimOrderChange"
      />
    </view>

    <!-- 好友红包积分抵扣 -->
    <view class="slider-block">
      <view class="slider-label-row">
        <text class="slider-title">好友使用红包积分抵扣</text>
        <text class="slider-num red">-¥{{simRedDeduct}}</text>
      </view>
      <slider 
        min="0" 
        max="{{maxSimRedAllowed}}" 
        step="5" 
        value="{{simRedDeduct}}" 
        activeColor="#B45309" 
        block-color="#B45309" 
        bindchanging="onSimRedChange" 
        bindchange="onSimRedChange"
      />
    </view>

    <!-- 试算结果看板与防刷规则说明 -->
    <view class="formula-result-card">
      <view class="formula-line">
        <text class="f-label">有效微信实付基数：</text>
        <text class="f-calc">¥{{simOrderAmount}} - ¥{{simRedDeduct}} = <text class="highlight">¥{{simActualCash}}</text></text>
      </view>
      <view class="formula-line">
        <text class="f-label">你将获得红包积分：</text>
        <text class="f-result">¥{{simActualCash}} × {{commissionRatePercent}}% = <text class="final-earn">+¥{{simEarnCommission}}</text></text>
      </view>
      <view class="anti-fraud-alert">
        <text class="alert-icon">🛡️</text>
        <text class="alert-text">仅按扣除各类优惠和配送费后的有效现金货款奖励；示例未含配送费与普通积分，实际以订单流水为准，收货后到账。</text>
      </view>
    </view>
  </view>

  <!-- 3. 我的邀请与返佣统计看板 -->
  <view class="stats-overview-grid">
    <view class="stat-card">
      <view class="stat-num">{{summary.total_referred || 0}}</view>
      <view class="stat-label">成功绑定好友(人)</view>
    </view>
    <view class="stat-card">
      <view class="stat-num">{{summary.total_orders || 0}}</view>
      <view class="stat-label">好友累计下单(笔)</view>
    </view>
    <view class="stat-card">
      <view class="stat-num red">¥{{summary.total_commission || '0.00'}}</view>
      <view class="stat-label">累计推荐奖励(元)</view>
    </view>
  </view>

  <!-- 4. 绑定的好友明细列表 -->
  <view class="referral-list-section">
    <view class="list-section-header">
      <text class="list-title">已绑定的好友列表</text>
      <text class="list-total">共 {{summary.total_referred}} 位</text>
    </view>

    <view wx:if="{{error}}" class="empty-list-box" bindtap="retryReferrals">{{error}} · 点击重试</view>
    <view wx:if="{{loading && !referrals.length}}" class="empty-list-box">正在加载好友…</view>
    <view wx:if="{{referrals.length === 0 && !loading && !error}}" class="empty-list-box">
      <view class="empty-icon">👥</view>
      <view class="empty-text">暂无邀请好友，快去分享专属邀请码吧！</view>
    </view>

    <view wx:if="{{referrals.length}}" class="referrals-feed">
      <view wx:for="{{referrals}}" wx:key="id" class="referral-row-item">
        <image class="ref-avatar" src="{{item.avatar_url || '/images/tab_member.png'}}" mode="aspectFit"></image>
        <view class="ref-info">
          <view class="ref-name-row">
            <text class="ref-nickname">{{item.nickname}}</text>
            <text class="ref-vip-badge">{{item.is_member === 1 ? '尊享会员' : '普通用户'}}</text>
          </view>
          <view class="ref-date">绑定时间: {{item.bind_time}}</view>
        </view>
        <view class="ref-reward-col">
          <text class="reward-title">已结算奖励</text>
          <text class="reward-amount">+¥{{item.commission_earned}}</text>
        </view>
      </view>
    </view>
    <button wx:if="{{nextCursor}}" loading="{{loading}}" disabled="{{loading}}" bindtap="moreReferrals">加载更多好友（已显示{{referrals.length}}位）</button>
  </view>

</view>
